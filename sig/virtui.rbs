# The tuile-based presentation layer: {UI::AppLayout} orchestrating the
# {UI::VMPane}, {UI::SystemPane} and {UI::LogPane}, the {UI::Formatter} helpers
# and the {UI::Theme} / {UI::Tint} color tokens.
module UI
  # Derives the borderless-pane colors from the terminal's reported background RGB
  # (`Screen#background_color`, tuile#7): the secondary panes' background tint and the
  # `─`/`│` hairline colors. Stateless; called by {Theme}'s derived tokens whenever the
  # reported background changes, and unit-tested from canned backgrounds.
  # 
  # The derivation preserves hue — popular terminal themes are rarely neutral (Catppuccin
  # Mocha `#1e1e2e` is purple-blue) and a neutral-grey sidebar next to a tinted primary
  # pane looks dirty — so every step is an HSL round-trip moving only lightness, **toward
  # mid-grey**: a dark background lightens, a light one darkens. Toward-grey rather than
  # toward-the-pole because the pole rule dies exactly at `#000`/`#fff`, the two most
  # common terminal backgrounds, where toward-grey's failure case (a mid-grey terminal)
  # exists on no real terminal; the measured contrast cost at {DELTA} never pushes a
  # passing token under the floor. See design/decisions.md D_tint_toward_grey for the ratios.
  module Tint
    DELTA: Float
    HAIRLINE_DELTA: Float
    CONTRAST_FLOOR: Float

    # The secondary-pane background: `background` stepped {DELTA} toward mid-grey, unless
    # that would drag a guarded foreground token under {CONTRAST_FLOOR} — then the step
    # flips away from grey instead. The flip is expected dead on every real terminal
    # (see design/decisions.md D_tint_toward_grey); it protects the backgrounds never measured.
    # 
    # _@param_ `background` — the terminal background; must carry RGB
    # 
    # _@param_ `guard` — foreground tokens rendered on the pane; entries without a knowable RGB (symbolic ANSI colors, remapped by the terminal) are skipped
    # 
    # _@return_ — the pane background, 24-bit RGB
    def pane_bg: (Tuile::Color background, ?guard: ::Array[Tuile::Color]) -> Tuile::Color

    # The secondary-pane background: `background` stepped {DELTA} toward mid-grey, unless
    # that would drag a guarded foreground token under {CONTRAST_FLOOR} — then the step
    # flips away from grey instead. The flip is expected dead on every real terminal
    # (see design/decisions.md D_tint_toward_grey); it protects the backgrounds never measured.
    # 
    # _@param_ `background` — the terminal background; must carry RGB
    # 
    # _@param_ `guard` — foreground tokens rendered on the pane; entries without a knowable RGB (symbolic ANSI colors, remapped by the terminal) are skipped
    # 
    # _@return_ — the pane background, 24-bit RGB
    def self.pane_bg: (Tuile::Color background, ?guard: ::Array[Tuile::Color]) -> Tuile::Color

    # A hairline color for rules drawn on `ground`: the ground stepped
    # {HAIRLINE_DELTA} toward mid-grey — always the same perceptual distance away,
    # whatever the terminal's background.
    # 
    # _@param_ `ground` — the background the hairline sits on; must carry RGB
    # 
    # _@return_ — the hairline color, 24-bit RGB
    def hairline: (Tuile::Color ground) -> Tuile::Color

    # A hairline color for rules drawn on `ground`: the ground stepped
    # {HAIRLINE_DELTA} toward mid-grey — always the same perceptual distance away,
    # whatever the terminal's background.
    # 
    # _@param_ `ground` — the background the hairline sits on; must carry RGB
    # 
    # _@return_ — the hairline color, 24-bit RGB
    def self.hairline: (Tuile::Color ground) -> Tuile::Color

    # WCAG 2.x contrast ratio between two colors.
    # 
    # _@param_ `first` — a color or RGB triple
    # 
    # _@param_ `second` — a color or RGB triple
    # 
    # _@return_ — the ratio, 1.0..21.0
    def contrast: ((Tuile::Color | ::Array[Integer]) first, (Tuile::Color | ::Array[Integer]) second) -> Float

    # WCAG 2.x contrast ratio between two colors.
    # 
    # _@param_ `first` — a color or RGB triple
    # 
    # _@param_ `second` — a color or RGB triple
    # 
    # _@return_ — the ratio, 1.0..21.0
    def self.contrast: ((Tuile::Color | ::Array[Integer]) first, (Tuile::Color | ::Array[Integer]) second) -> Float

    # Which way mid-grey lies from `rgb`, on the HSL lightness axis.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — +1 (lighten) below mid-lightness, else -1 (darken)
    def direction: (::Array[Integer] rgb) -> Integer

    # Which way mid-grey lies from `rgb`, on the HSL lightness axis.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — +1 (lighten) below mid-lightness, else -1 (darken)
    def self.direction: (::Array[Integer] rgb) -> Integer

    # `rgb` with its HSL lightness moved by `delta` (clamped to 0..1), hue and
    # saturation held.
    # 
    # _@param_ `rgb`
    # 
    # _@param_ `delta` — signed lightness delta
    # 
    # _@return_ — the stepped RGB triple
    def step: (::Array[Integer] rgb, Float delta) -> ::Array[Integer]

    # `rgb` with its HSL lightness moved by `delta` (clamped to 0..1), hue and
    # saturation held.
    # 
    # _@param_ `rgb`
    # 
    # _@param_ `delta` — signed lightness delta
    # 
    # _@return_ — the stepped RGB triple
    def self.step: (::Array[Integer] rgb, Float delta) -> ::Array[Integer]

    # WCAG relative luminance of an RGB triple.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — 0.0..1.0
    def luminance: (::Array[Integer] rgb) -> Float

    # WCAG relative luminance of an RGB triple.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — 0.0..1.0
    def self.luminance: (::Array[Integer] rgb) -> Float

    # RGB → HSL.
    # 
    # _@param_ `rgb` — channels 0..255
    # 
    # _@return_ — hue in degrees, saturation 0..1, lightness 0..1
    def to_hsl: (::Array[Integer] rgb) -> [Float, Float, Float]

    # RGB → HSL.
    # 
    # _@param_ `rgb` — channels 0..255
    # 
    # _@return_ — hue in degrees, saturation 0..1, lightness 0..1
    def self.to_hsl: (::Array[Integer] rgb) -> [Float, Float, Float]

    # HSL → RGB.
    # 
    # _@param_ `hue` — hue in degrees
    # 
    # _@param_ `sat` — saturation 0..1
    # 
    # _@param_ `light` — lightness 0..1
    # 
    # _@return_ — channels 0..255
    def from_hsl: (Float hue, Float sat, Float light) -> ::Array[Integer]

    # HSL → RGB.
    # 
    # _@param_ `hue` — hue in degrees
    # 
    # _@param_ `sat` — saturation 0..1
    # 
    # _@param_ `light` — lightness 0..1
    # 
    # _@return_ — channels 0..255
    def self.from_hsl: (Float hue, Float sat, Float light) -> ::Array[Integer]
  end

  # VirTUI's color theme: Tuile's built-in tokens plus app-specific ones, with
  # one coloring reader per custom token. Assign {THEME_DEF} to
  # `screen.theme_def=` once: the screen picks the right variant for the terminal
  # background, follows OS light/dark flips, and re-resolves the background-derived
  # tokens ({.derived_tokens}) whenever the reported background changes.
  class Theme < Tuile::Theme
    GUARD_TOKENS: ::Array[Symbol]
    DARK: Theme
    LIGHT: Theme
    THEME_DEF: Tuile::ThemeDef

    # The tokens derived from the terminal's actual background ({Tint}): `pane_bg` steps
    # the background toward mid-grey, `frame` is a hairline on the terminal ground and
    # `pane_frame` a hairline on the tinted ground — a hairline must be derived from the
    # ground it rules on, or a fixed `#333333` goes a near-invisible 1.1:1 on a mid-dark
    # terminal like One Dark. With no reported background (plenty of terminals answer no
    # OSC 11) each falls back to a fixed floor tuned for the variant's usual ground.
    # 
    # _@param_ `pane_bg` — `pane_bg`'s floor
    # 
    # _@param_ `hairline` — the floor of both hairlines
    # 
    # _@return_ — the three derived custom tokens
    def self.derived_tokens: (pane_bg: Tuile::Color, hairline: Tuile::Color) -> ::Hash[Symbol, Proc]

    # _@param_ `text`
    # 
    # _@return_ — `text` in the host CPU accent color.
    def cpu: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the host RAM accent color.
    def ram: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the swap accent color.
    def swap: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the disk-device-name accent color.
    def disk_label: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the subtle horizontal-frame color.
    def frame: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the VM name color.
    def vm_name: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the "all good" color (running VM, low overhead).
    def ok: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the warning color (paused VM, elevated overhead).
    def warn: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the error color (unknown VM state, high overhead).
    def error: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the powered-off color.
    def off: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in bold, in the terminal's own foreground — the
    # shortcut letter in a hint (`"#{theme.key('p')} #{theme.hint('Power')}"`).
    def key: (String text) -> String

    # _@param_ `text`
    # 
    # _@return_ — `text` in the de-emphasized chrome color — a hint caption, a
    # column header, an unfocused chip.
    def hint: (String text) -> String
  end

  # The VM pane: a scrollable, cursor-selectable list of all VMs, each with guest-vs-host
  # CPU/RAM/disk usage bars and a ballooning-status indicator. Per-VM actions are reachable
  # via key shortcuts: power menu (`p`), launch viewer (`v`), memory menu (`m`), toggle disk
  # stats (`d`), the VM's definition (`i`), maintenance (`M`) and search (`/`). Each menu is a
  # component of its own under `lib/ui/vm_pane/`, handed the VM's name.
  # 
  # A borderless `Layout::Vertical`, not a `Panel` (see design/decisions.md D_panes_are_layouts):
  # a one-row header — the focus chip plus the Guest/Host column captions — over the
  # {Tuile::Component::List}, with the incremental-search {Tuile::Component::TextField}
  # appearing as a third row while open (a row in the pane's own layout, not an overlay:
  # a `Dialog` is modal, and a focusable non-modal `Overlay` is
  # forbidden upstream — the row plus one explicit {#close_search} re-focus is strictly
  # simpler).
  # 
  # UI-thread-confined.
  class VMPane < Tuile::Component::Layout::Vertical
    include Tuile
    COLUMN_SEPARATOR: String
    ROW_CAPTION_WIDTH: Integer
    LABEL_WIDTH: Integer
    SWAP_RATE_FULL_SCALE: Integer
    SWAP_TOTALS_WIDTH: Integer
    GUEST_OS_GLYPHS: ::Hash[Symbol, String]
    GUEST_OS_WIDTH: Integer
    BALLOON_GLYPHS: ::Hash[Symbol, [String, Symbol]]

    # _@param_ `virt_cache` — the runtime cache to read VM data from and act through
    # 
    # _@param_ `ballooning` — the ballooning controller toggled from the memory menu
    def initialize: (Virt::Cache virt_cache, Virt::Ballooning ballooning) -> void

    # Focuses the VM list. The pane itself is passive layout; the list is what owns the
    # cursor and the keyboard.
    def focus: () -> void

    # Rebuilds every VM's rows (overview + guest/host CPU, RAM and disk bars) from the
    # current cache data, and recomputes the allowed cursor positions. The rows lay
    # themselves out at paint time, so a resize needs no call here.
    def update: () -> void

    # Handles a key press: `/` opens search; `p`/`v`/`m`/`d`/`i`/`M` act on the VM under the
    # cursor (power menu, launch viewer, memory menu, toggle disk stats, info, maintenance).
    # 
    # _@param_ `key` — the pressed key
    # 
    # _@return_ — true if the key was handled
    def handle_key?: (String key) -> bool

    # _@return_ — the pane's focus chip, inverted iff the pane owns the
    # keyboard. `[1]` mirrors {AppLayout}'s focus-key map.
    def chip: () -> Tuile::StyledString

    # _@return_ — the footer hint line, listing the available key shortcuts (or the
    # search-close hint while searching)
    def keyboard_hint: () -> String

    # Rebuilds the header when the pane enters or leaves the focus chain — the chip's
    # inverted/dim state is baked into the header label's text.
    # 
    # _@param_ `value`
    def active=: (bool value) -> void

    # Re-centers the column captions on the pane's width; the list re-lays its rows out by
    # itself. Runs after every mark, not only a resize — the rebuild is cheap and
    # `Label#text=` skips an unchanged row.
    def relayout: () -> void

    # Re-renders when the theme changes, so colors follow the new palette.
    def handle_theme_changed: () -> void

    # _@return_ — the VM the row under the cursor belongs to; nil with no cursor
    def current_vm: () -> String?

    # Rebuilds the header row: the focus chip, then the Guest/Host column captions.
    # 
    # The captions are load-bearing column headers — every VM row renders guest-side |
    # host-side bar pairs and these are the only thing saying which is which — but they are
    # static dim labels, deliberately not flipping with focus: the chip is the pane's one
    # inverted element, and a two-shade caption flip is a relative cue the reader must remember
    # the resting shade to read. Centered at 1/4 and 3/4 of the pane width, over the middle of
    # each bar column.
    def rebuild_header: () -> void

    # Appends `text` to `line` so it starts at column `at`, space-padded; appends nothing
    # when `line` has already grown past `at` (a too-narrow pane).
    # 
    # _@param_ `line` — the ANSI-styled row built so far
    # 
    # _@param_ `at` — target start column
    # 
    # _@param_ `text` — ANSI-styled text to place
    # 
    # _@return_ — the extended row
    def place: (String line, Integer at, String text) -> String

    # Opens the incremental-search text field as a bottom row of the pane, wiring its events
    # to move the list cursor to matching VMs. While the field holds focus the list is
    # inactive, so the cursor is kept painted via `show_cursor_when_inactive` — scoped to
    # the search so that outside it *cursor visible ⟺ the VM pane owns the keyboard*.
    def open_search: () -> void

    # Closes the search row, handing focus back to the list (a Layout has no
    # focus repair; this explicit re-focus is the whole cost of the row-not-overlay choice).
    def close_search: () -> void

    # Builds a VM's overview row: state glyph, guest-OS marker, name, and (when running) a
    # balloon emoji with what the ballooning is doing ({BALLOON_GLYPHS}) and why, a "stale
    # data" turtle and the VM's address at the rule's right end.
    # 
    #     ▶ 🐧 Ubuntu 🎈↑ raised to 2.6G: 70% used ───── 192.168.122.84 ─
    #     ▶ 🐧 Ubuntu 🎈-─────────────────────────────── 192.168.122.84 ─
    #     ⏹ ?  BASE────────────────────────────────────────────────────
    # 
    # What sits on which side of the name is the rule to keep: left of it goes what the VM
    # *is* — facts that hold still while the user reads — and right of it what it is *doing*
    # right now. A live indicator on the left would shift the name column on every tick. The
    # address is right-aligned for the same reason: appearing or changing, it moves nothing.
    # 
    # _@param_ `cache` — the VM's cache entry
    # 
    # _@return_ — the overview row
    def overview_row: (Virt::Cache::VMCache cache) -> Row

    # A guest │ host row: `caption` then the two cells, each as wide as {#column_width}.
    # 
    #   split_row('Ubuntu', "    #{theme.ram('RAM')}") do |w|
    #     [usage_bar(w, guest_mem_usage, theme[:ram_vm]), usage_bar(w, host_mem_usage, theme[:ram])]
    #   end
    #   # renders:    RAM: 25%    2G ###------  7.9G │   9%  3.1G #--------    32G
    # 
    # _@param_ `vm` — the VM the row belongs to
    # 
    # _@param_ `caption` — {ROW_CAPTION_WIDTH} - 1 columns wide, styling not counted
    def split_row: (String vm, String caption) ?{ (Integer column_width) -> [String, String] } -> Row

    # _@param_ `width` — the list's text width
    # 
    # _@return_ — the width of one {#split_row} cell: half of what the caption and the
    # separator leave, never negative
    def column_width: (Integer width) -> Integer

    # The guest-OS marker for a VM's overview line: what the VM's definition declares, as one
    # {GUEST_OS_GLYPHS} emoji padded to {GUEST_OS_WIDTH} cells.
    # 
    # An undeclared OS draws a dim `?` rather than blank space, because `:unknown` is not a
    # neutral state here: {Virt::GuestOS#no_proc_meminfo?} is `!linux?`, so such a VM is never
    # asked for its swap level and quietly loses the guest half of its SWAP row — this marker
    # is the only thing on screen that says why. Same argument as {#swap_level_bar}'s dashes:
    # blank reads as *nothing there* when it means *nobody asked*.
    # 
    # _@param_ `guest_os` — what this VM's definition declares
    # 
    # _@return_ — the marker, {GUEST_OS_WIDTH} cells wide, styling not counted
    def format_guest_os: (Virt::GuestOS guest_os) -> String

    # The swap row, one per running VM that reports swap counters. Two cells, two questions:
    # the guest half is *occupancy*, drawn exactly like the RAM row above it so the two read
    # against each other; the host half is *I/O*, because guest swap writes land on the host's
    # disk.
    # 
    #     RAM: 50%    4G ########---------  7.9G │  16%  5.1G ##---------------   32G
    #    SWAP: 43%  1.8G #######----------    4G │       3M/s ##-------------- ↕ 1.8G
    #    SWAP:  -        -----------------       │        0/s ---------------- ↕    0
    #          ^level, or unknown                        ^rate now      traffic since boot^
    # 
    # Why the rate sits on the host side rather than beside the level: {#swap_io_bar}. Why an
    # unknown level is dashes rather than blank: {#swap_level_bar}. Two cells rather than
    # three figures in the guest cell because at ~100 columns a cell is ~42 characters, and a
    # level bar squeezed to ~10 loses the comparison against the RAM bar above it that makes
    # the level worth showing.
    # 
    # Rendered whether or not the guest is swapping, so the warn coloring on the label rather
    # than the row's presence is what draws the eye: hiding the row at rest made every VM
    # below it jump a row on each swap burst. Absent *counters* are the one case that still
    # hides it, because that state never flips back while the reader is looking. (A guest
    # that reports a level but no counters therefore gets no row at all; no distro kernel
    # builds without `CONFIG_VM_EVENT_COUNTERS`, so that combination stays theoretical.)
    # 
    # _@param_ `cache` — the VM's cache entry
    # 
    # _@return_ — the swap row, or `nil` if the guest reports no swap counters
    def swap_row: (Virt::Cache::VMCache cache) -> Row?

    # How full the guest's swap device is — the guest half of the swap row.
    # 
    #    22%  1.8G #####--------------------     8G   <- 1.8G parked on an 8G device
    #      -        -------------------------         <- this guest cannot report a level
    # 
    # Dashes rather than blank space for an unknown level, because blank reads as *nothing
    # parked* when it means *nobody asked*: the level needs a guest agent behind a persistent
    # virsh session (see {Virt::GuestAgent}), which plenty of guests will never have. Keeping
    # the cell occupied is also what keeps the rate in one column for every VM.
    # 
    # _@param_ `width` — width of one usage-bar column
    # 
    # _@param_ `level` — the guest's swap level, or `nil` if unavailable
    # 
    # _@return_ — the rendered segment
    def swap_level_bar: (Integer width, ResourceUsage? level) -> String

    # What the guest's swapping costs the host — the host half of the swap row: the rate now,
    # then the traffic since the guest booted.
    # 
    #     3M/s ##-------------------- ↕  45M
    # 
    # On the host side because that is what this column means everywhere else on the screen:
    # a guest's swap writes are the host's disk writes. The two lifetime counters are summed
    # for the same reason — `swap_out + swap_in` is the total traffic the host paid for, and
    # which direction it went is what the rate and the level already say.
    # 
    # The gauge reads against {SWAP_RATE_FULL_SCALE} rather than a per-VM maximum, so two VMs'
    # bars mean the same thing.
    # 
    # _@param_ `width` — width of one usage-bar column
    # 
    # _@param_ `rate` — bytes per second written to swap; `nil` on a first sample, where the counters are there but no interval has passed to diff them over
    # 
    # _@param_ `mem_stat` — the VM's memory stats, for the lifetime counters
    # 
    # _@return_ — the rendered segment
    def swap_io_bar: (Integer width, Float? rate, Virt::MemoryStat mem_stat) -> String

    # Draws a row header: `left` caption, then `words`, then a frame rule filling the rest of
    # `width`, with `right` inset near the rule's end (see {#overview_row}):
    # 
    #     ▶ 🐧 vt-ubuntu 🎈↑ raised to 2.6G: 70% used ─────────── 192.168.123.239 ─
    #     ▶ 🐧 vt-ubuntu 🎈↑ raised to 2.6G… ─── 192.168.123.239 ─
    # 
    # The room goes to `right` first: it is dropped whole, never truncated, when the rule has
    # no room for it, because a clipped address is a wrong address. `words` get what is left,
    # cut with `…`, and stay at least `───` clear of `right` so the two don't read as one.
    # 
    # _@param_ `width` — the list's text width
    # 
    # _@param_ `left` — the caption (may contain styling)
    # 
    # _@param_ `right` — unstyled text to inset, or `nil` for a plain rule
    # 
    # _@param_ `words` — unstyled text after the caption; dropped when not even one character and the `…` fit
    # 
    # _@param_ `tone` — the {Theme} reader that colors `words`
    # 
    # _@return_ — the rendered header line
    def header: (
                  Integer width,
                  String left,
                  ?String? right,
                  ?words: String?,
                  ?tone: Symbol?
                ) -> String

    # Renders one labelled progress-bar segment: `left` caption, the bar, then `right`
    # caption, within `width` characters.
    # 
    # _@param_ `left` — left caption (padded to {LABEL_WIDTH} chars unless empty)
    # 
    # _@param_ `right` — right caption (padded to 6 chars)
    # 
    # _@param_ `width` — total width of the segment, in characters
    # 
    # _@param_ `value` — current value, for drawing the progress bar
    # 
    # _@param_ `max` — max value, for drawing the progress bar
    # 
    # _@param_ `color` — progress bar color
    # 
    # _@return_ — the rendered segment, including ANSI color codes
    def progress_bar: (
                        String left,
                        String right,
                        Integer width,
                        Numeric value,
                        Numeric max,
                        Tuile::Color color
                      ) -> String

    # Renders a {ResourceUsage} as a progress-bar segment captioned with percent used and
    # the used/total byte sizes; blank space if `mem_usage` is `nil`.
    # 
    # _@param_ `width` — the width of the segment, in characters
    # 
    # _@param_ `mem_usage` — the resource usage to render
    # 
    # _@param_ `color` — progress bar color
    # 
    # _@return_ — the rendered segment
    def usage_bar: (Integer width, ResourceUsage? mem_usage, Tuile::Color color) -> String

    # Maps a VM state to a colored status glyph.
    # 
    # _@param_ `state` — one of `:running`, `:shut_off`, `:paused`, `:other`
    # 
    # _@return_ — the colored glyph for that state
    def format_domain_state: (Symbol state) -> String

    # How full the guest has filled one disk — the guest half of a disk row; the host half is
    # what the disk's image costs the host.
    # 
    #    23%  3.4G #####--------------------    15G   <- the guest's filesystems on vda
    #      -        -------------------------         <- running, but the guest cannot say
    #                                                  <- stopped: nobody to ask
    # 
    # The filesystems' total, not the disk's capacity: what the guest can still write.
    # Dashes for the reason {#swap_level_bar} draws them.
    # 
    # _@param_ `width` — width of one usage-bar column
    # 
    # _@param_ `cache` — the VM
    # 
    # _@param_ `target` — the disk's host target, e.g. `vda`
    # 
    # _@return_ — the rendered segment
    def guest_disk_bar: (Integer width, Virt::Cache::VMCache cache, String target) -> String

    # _@return_ — the VM list — the pane's focus target
    attr_reader list: Tuile::Component::List

    # _@return_ — the incremental-search row while open,
    # nil otherwise — see {#open_search}
    attr_reader search: Tuile::Component::TextField?

    # _@return_ — whether disk stats are shown for shut-off VMs too
    attr_accessor show_disk_stat: bool

    # One list row: the VM it belongs to, and how to draw it at the list's text width.
    # 
    #   Row.new('Ubuntu', ->(width) { '─' * width })
    # 
    # The cache is read when the row is built, never inside `render`: the list renders at
    # paint time and again on every width change, and a row must keep showing the sample
    # it was built from.
    # 
    # @!attribute [r] vm
    #   @return [String] the VM's name — what the power/memory keys act on
    # @!attribute [r] render
    #   @return [Proc] `(Integer width) -> String`, the row laid out to `width` columns
    class Row < Data
      # _@return_ — the VM's name — what the power/memory keys act on
      attr_reader vm: String

      # _@return_ — `(Integer width) -> String`, the row laid out to `width` columns
      attr_reader render: Proc
    end

    # Grows a running VM's root filesystem into the free space after it, the flow behind
    # `M` → Grow root filesystem and the health check's Fix button:
    # 
    #   RootGrower.new(virt_cache.virt, 'vt-ubuntu').start
    # 
    # Checks how the root would grow, asks the user to confirm the commands it runs in the
    # guest, then runs them behind a progress dialog that cannot be canceled and reports the new size.
    # A guest whose layout or agent will not do gets the reason instead.
    # 
    # UI-thread-confined.
    class RootGrower
      # _@param_ `virt` — the backend
      # 
      # _@param_ `vm` — the VM's name
      def initialize: ((Virt::Virsh | Virt::VMEmulator) virt, String vm) -> void

      # Opens the first dialog of the flow and returns; the rest follows on the user's answers.
      def start: () -> void

      # _@param_ `plan`
      def grow: (Virt::GuestRootGrow::Plan plan) -> void
    end

    # The `p` menu of {VMPane}: start, graceful shutdown, force off, soft reboot and hard
    # reset of one VM, and the magic-SysRq power-off and reboot between them (see
    # {Virt::MagicSysRq}).
    # 
    #   PowerPickerDialog.new(virt_cache, 'vt-ubuntu').open
    # 
    #   ┌Power─────────────────────────────────────────┐
    #   │s Start (VM not stopped)                      │
    #   │o shut dOwn gracefully                        │
    #   │u sync, remoUnt ro, power off (SysRq)         │
    #   │O force Off                                   │
    #   │…                                             │
    # 
    # What the VM's state or guest rules out is disabled. The menu is a snapshot, so each
    # action checks again and logs an error if the VM changed state since.
    # 
    # UI-thread-confined.
    class PowerPickerDialog < Tuile::Component::PickerDialog
      # _@param_ `virt_cache` — the runtime cache to read the VM's state from and act through
      # 
      # _@param_ `vm` — the VM's name
      def initialize: (Virt::Cache virt_cache, String vm) -> void

      # _@return_ — the {Tuile::Component::PickerDialog} options
      def options: () -> ::Array[[String, String, ::Hash[untyped, untyped]]]

      # _@param_ `key` — the picked option's key
      def pick: (String key) -> void

      # _@return_ — why the SysRq items cannot end this VM, or `nil` if they can
      def sysrq_refusal: () -> String?

      # Syncs, remounts read-only and powers off or reboots the VM through magic SysRq, behind
      # a progress dialog that cannot be canceled: a guest left after U has every filesystem read-only.
      # 
      # _@param_ `reboot` — B rather than O as the last key
      def sysrq_power: (reboot: bool) -> void
    end

    # The `m` menu of {VMPane}: toggle one VM's automatic ballooning, or give it its maximum
    # memory and switch the ballooning off.
    # 
    #   MemoryPickerDialog.new(virt_cache, ballooning, 'vt-ubuntu').open
    # 
    #   ┌Memory──────────────────────────────────┐
    #   │b toggle autoBallooning                 │
    #   │m Max memory & disable autoballooning   │
    #   └────────────────────────────────────────┘
    # 
    # Both need the VM running and are disabled otherwise. The menu is a snapshot, so a pick
    # checks again and logs an error if the VM stopped since.
    # 
    # UI-thread-confined.
    class MemoryPickerDialog < Tuile::Component::PickerDialog
      # _@param_ `virt_cache` — the runtime cache to read the VM's state from and act through
      # 
      # _@param_ `ballooning` — the ballooning controller to toggle
      # 
      # _@param_ `vm` — the VM's name
      def initialize: (Virt::Cache virt_cache, Virt::Ballooning ballooning, String vm) -> void

      # _@param_ `key` — the picked option's key
      def pick: (String key) -> void
    end

    # The `M` menu of {VMPane}: resize one VM's disk image, grow its root filesystem, or check
    # its health.
    # 
    #   MaintenancePickerDialog.new(virt_cache, 'vt-ubuntu').open
    # 
    #   ┌Maintenance──────────────────────────────────────────┐
    #   │r Resize disk image… (shut the VM down first)        │
    #   │g Grow root filesystem…                              │
    #   │h Health check… (full scan: VM running)              │
    #   └─────────────────────────────────────────────────────┘
    # 
    # Resizing needs the VM shut off and growing needs it running, so the one the state rules
    # out is disabled. The health check never is: a stopped VM is judged by its definition
    # alone. The menu is a snapshot, so a VM that changed state since gets an alert instead.
    # 
    # UI-thread-confined.
    class MaintenancePickerDialog < Tuile::Component::PickerDialog
      # _@param_ `virt_cache` — the runtime cache to read the VM's state from
      # 
      # _@param_ `vm` — the VM's name
      def initialize: (Virt::Cache virt_cache, String vm) -> void

      # _@param_ `key` — the picked option's key
      def pick: (String key) -> void
    end
  end

  # One entry of the virtualization CPU-flag glossary: a `/proc/cpuinfo` token, how to
  # detect it, and what having it buys a KVM guest.
  # 
  # {ALL} is the whole glossary and the single source of truth for both readers —
  # {SystemPane}'s one-line CPU summary renders the {#name}s, {CpuFlagsDialog}
  # renders the {#description}s — so the two can no longer drift apart (they had:
  # the summary and the help each carried their own copy of the flag list).
  # 
  # Names are the tokens as the kernel spells them in `/proc/cpuinfo`, so that what
  # the summary line shows is greppable there; that is why it says
  # `tsc_deadline_timer` and not the shorter `tsc_deadline`, which is not a flag.
  class CpuFlag
    ALL: ::Array[CpuFlag]

    # _@param_ `name` — the flag as `/proc/cpuinfo` spells it, and as the CPU summary line shows it
    # 
    # _@param_ `description` — what the flag buys a guest, in prose — word-wrapped by {CpuFlagsDialog}, so it may be a sentence or three
    # 
    # _@param_ `matcher` — `(Set<String>) -> Boolean` deciding whether the host has this flag; defaults to a plain membership test on {#name}
    def initialize: (name: String, description: String, ?matcher: Proc?) -> void

    # _@param_ `flags` — the host's CPU flags, from {System::Info#cpu_flags}
    # 
    # _@return_ — whether this host has this flag
    def present_in?: (::Set[String] flags) -> bool

    # The glossary entries this host qualifies for, in {ALL} order.
    # 
    # _@param_ `flags` — the host's CPU flags, from {System::Info#cpu_flags}
    # 
    # _@return_ — never empty - a host with neither vmx nor svm matches
    # the `software` entry
    def self.present_in: (::Set[String] flags) -> ::Array[CpuFlag]
  end

  # The log pane: `$log`'s console output, word-wrapped and auto-scrolled. A borderless
  # `Layout::Vertical` (see design/decisions.md D_panes_are_layouts): a one-row header carrying
  # the focus chip, over a {Tuile::Component::LogTextView} — deliberately a text view and
  # not a list, so long lines (stacktraces, wide log records) wrap rather than ellipsize.
  # Point a logger at a `LogTextView::IO` wrapping this pane; {#log} is any-thread safe
  # (the view self-marshals).
  # 
  # UI-thread-confined (except {#log}).
  class LogPane < Tuile::Component::Layout::Vertical
    include Tuile

    def initialize: () -> void

    # Focuses the log view. The pane itself is passive layout; the view is what owns
    # scrolling and the keyboard.
    def focus: () -> void

    # Appends the given line to the log. Safe to call from any thread — delegates to
    # {Tuile::Component::LogTextView#log}, which self-marshals onto the UI thread.
    # 
    # _@param_ `string` — the line (or multiple lines) to log; `nil` is a no-op
    def log: (String? string) -> void

    # _@return_ — the pane's focus chip, inverted iff the pane owns the
    # keyboard. `[3]` mirrors {AppLayout}'s focus-key map.
    def chip: () -> Tuile::StyledString

    # _@return_ — empty — the log pane has no key shortcuts to advertise. It answers
    # {AppLayout#refresh_status}'s probe anyway, so that the empty status line is this
    # pane's deliberate silence rather than a method nobody remembered to write.
    def keyboard_hint: () -> String

    # Rebuilds the header when the pane enters or leaves the focus chain — the chip's
    # inverted/dim state is baked into the header label's text.
    # 
    # _@param_ `value`
    def active=: (bool value) -> void

    # Re-renders the header when the theme changes, so the chip follows the new palette.
    def handle_theme_changed: () -> void

    # Rebuilds the header row — the focus chip.
    def rebuild_header: () -> void

    # _@return_ — the log view — the pane's focus target
    attr_reader view: Tuile::Component::LogTextView
  end

  # Stateless helpers building reusable styled-string fragments for the UI widgets; call
  # them on the module (`UI::Formatter.labelled_bar(…)`).
  module Formatter
    # Renders a single-row progress bar as a styled string: the filled portion in `color`,
    # the remainder as dashes in `rest_color`. `value` is clamped to `0..max_value`.
    # 
    # _@param_ `width` — total width in characters (height is always 1)
    # 
    # _@param_ `value` — the current value
    # 
    # _@param_ `max_value` — the value corresponding to a full bar
    # 
    # _@param_ `color` — color of the filled portion
    # 
    # _@param_ `rest_color` — color of the unfilled portion
    # 
    # _@param_ `char` — the character used for the filled portion
    # 
    # _@return_ — the rendered bar; empty when `max_value` or `width` is zero
    def progress_bar: (
                        Integer width,
                        Numeric value,
                        Numeric max_value,
                        Tuile::Color color,
                        Tuile::Color rest_color,
                        ?String char
                      ) -> Tuile::StyledString

    # Renders a single-row progress bar as a styled string: the filled portion in `color`,
    # the remainder as dashes in `rest_color`. `value` is clamped to `0..max_value`.
    # 
    # _@param_ `width` — total width in characters (height is always 1)
    # 
    # _@param_ `value` — the current value
    # 
    # _@param_ `max_value` — the value corresponding to a full bar
    # 
    # _@param_ `color` — color of the filled portion
    # 
    # _@param_ `rest_color` — color of the unfilled portion
    # 
    # _@param_ `char` — the character used for the filled portion
    # 
    # _@return_ — the rendered bar; empty when `max_value` or `width` is zero
    def self.progress_bar: (
                             Integer width,
                             Numeric value,
                             Numeric max_value,
                             Tuile::Color color,
                             Tuile::Color rest_color,
                             ?String char
                           ) -> Tuile::StyledString

    # Renders a focus chip — the labeled focus cue each pane draws in its own header row,
    # and the only place it appears: `[key]-label`, one space of block padding each side.
    # The focused variant is inverse video (SGR 7 swaps whatever colors are in effect, so it
    # reads on any terminal theme without a color token pair); the unfocused variant is dim,
    # in the hint color.
    # Plain inverted block on purpose, no powerline terminator: the Nerd Font arrow (U+E0B0) is
    # tofu on a stock terminal and the client's font is undetectable server-side, and the
    # half-block `▐` looks like a hard edge anyway.
    # 
    # _@param_ `key` — the focus key, e.g. `'1'`
    # 
    # _@param_ `label` — the pane name, e.g. `'VMs'`
    # 
    # _@param_ `focused` — whether the chip's pane owns the keyboard
    # 
    # _@param_ `theme` — the theme the dim variant draws its hint color from
    # 
    # _@return_ — the rendered chip
    def chip: (
                String key,
                String label,
                focused: bool,
                theme: Tuile::Theme
              ) -> Tuile::StyledString

    # Renders a focus chip — the labeled focus cue each pane draws in its own header row,
    # and the only place it appears: `[key]-label`, one space of block padding each side.
    # The focused variant is inverse video (SGR 7 swaps whatever colors are in effect, so it
    # reads on any terminal theme without a color token pair); the unfocused variant is dim,
    # in the hint color.
    # Plain inverted block on purpose, no powerline terminator: the Nerd Font arrow (U+E0B0) is
    # tofu on a stock terminal and the client's font is undetectable server-side, and the
    # half-block `▐` looks like a hard edge anyway.
    # 
    # _@param_ `key` — the focus key, e.g. `'1'`
    # 
    # _@param_ `label` — the pane name, e.g. `'VMs'`
    # 
    # _@param_ `focused` — whether the chip's pane owns the keyboard
    # 
    # _@param_ `theme` — the theme the dim variant draws its hint color from
    # 
    # _@return_ — the rendered chip
    def self.chip: (
                     String key,
                     String label,
                     focused: bool,
                     theme: Tuile::Theme
                   ) -> Tuile::StyledString

    # Renders a labelled progress-bar segment: `left` caption (left-padded to `label_width`,
    # unless empty), the {#progress_bar} filling the middle, then `right` caption
    # (right-padded to 6), all within `width` characters:
    # 
    #   labelled_bar(24, "50%", "128G", 50, 100, cpu, frame, label_width: 11)
    #   # => "50%        ###----  128G"  (ANSI-colored bar in the middle)
    # 
    # The bar shrinks to fit the captions and collapses to empty when there's no room.
    # 
    # _@param_ `width` — total segment width, in characters
    # 
    # _@param_ `left` — left caption; left-padded to `label_width` unless empty
    # 
    # _@param_ `right` — right caption; right-padded to 6 characters
    # 
    # _@param_ `value` — current value, for drawing the bar
    # 
    # _@param_ `max_value` — max value, for drawing the bar
    # 
    # _@param_ `color` — color of the bar's filled portion
    # 
    # _@param_ `rest_color` — color of the bar's unfilled portion
    # 
    # _@param_ `label_width` — width the `left` caption is padded to
    # 
    # _@return_ — the rendered segment, including ANSI color codes
    def labelled_bar: (
                        Integer width,
                        String left,
                        String right,
                        Numeric value,
                        Numeric max_value,
                        Tuile::Color color,
                        Tuile::Color rest_color,
                        label_width: Integer
                      ) -> String

    # Renders a labelled progress-bar segment: `left` caption (left-padded to `label_width`,
    # unless empty), the {#progress_bar} filling the middle, then `right` caption
    # (right-padded to 6), all within `width` characters:
    # 
    #   labelled_bar(24, "50%", "128G", 50, 100, cpu, frame, label_width: 11)
    #   # => "50%        ###----  128G"  (ANSI-colored bar in the middle)
    # 
    # The bar shrinks to fit the captions and collapses to empty when there's no room.
    # 
    # _@param_ `width` — total segment width, in characters
    # 
    # _@param_ `left` — left caption; left-padded to `label_width` unless empty
    # 
    # _@param_ `right` — right caption; right-padded to 6 characters
    # 
    # _@param_ `value` — current value, for drawing the bar
    # 
    # _@param_ `max_value` — max value, for drawing the bar
    # 
    # _@param_ `color` — color of the bar's filled portion
    # 
    # _@param_ `rest_color` — color of the bar's unfilled portion
    # 
    # _@param_ `label_width` — width the `left` caption is padded to
    # 
    # _@return_ — the rendered segment, including ANSI color codes
    def self.labelled_bar: (
                             Integer width,
                             String left,
                             String right,
                             Numeric value,
                             Numeric max_value,
                             Tuile::Color color,
                             Tuile::Color rest_color,
                             label_width: Integer
                           ) -> String
  end

  # The top-level screen layout, orchestrating the three borderless panes: {VMPane} (VM
  # list/controls), {SystemPane} (host CPU/RAM/disk) and {LogPane}, over a one-row status
  # line. Also redirects `$log`'s console output into the log pane and owns the `1`/`2`/`3`
  # focus keys (see {#handle_key?}).
  # 
  # The System and log panes can be hidden: a pane's digit pressed while it is focused hides
  # it, as IntelliJ's Alt+1 does its tool window, and the digit brings it back. A hidden pane's
  # chip moves to the right end of the status line, so the way back stays on screen:
  # 
  #   q quit  p Power  v run Viewer  …                            [2]-System  [3]-Log
  # 
  # Which panes are hidden survives a restart, in {State}.
  # 
  # The panes carry no frames (design/decisions.md D_panes_are_layouts); what tells them apart is
  # the background: the VM pane — the "editor", where all interaction lives — keeps the
  # terminal's default background, while the System and log panes are tinted one step
  # toward mid-grey (`:pane_bg`, see {Theme}) and separated from each other by a one-cell
  # `│` column. Focus is *labeled* instead of frame-colored: the pane's own header chip,
  # once, and the list cursor — absolute cues, where a background lift is a relative one
  # that needs the resting shade remembered.
  # 
  # Tuile draws no status bar and reserves no row (see its design/decisions.md
  # `D-status-bar`), so the bottom line is ours: {#refresh_status} rebuilds it and
  # `bin/virtui` hangs it off `Tuile::Screen#on_focus_changed`.
  # 
  # A `Layout::Vertical`: the VM pane takes what is left over a {BOTTOM_HEIGHT}-row
  # `Horizontal` of System │ log, over the status line.
  # 
  # UI-thread-confined.
  class AppLayout < Tuile::Component::Layout::Vertical
    include Tuile
    BOTTOM_HEIGHT: Integer
    SYSTEM_WIDTH: Tuile::Component::Layout::Clamp

    # _@param_ `virt_cache` — the runtime cache the panes read from
    # 
    # _@param_ `ballooning` — the ballooning controller for {VMPane}
    def initialize: (Virt::Cache virt_cache, Virt::Ballooning ballooning) -> void

    # Focuses the pane bound to `key` — `1` the VMs, `2` the host metrics, `3` the log —
    # showing it first if it was hidden; the digit of the focused System or log pane hides it.
    # As the scope root, this is the last rung of the key bubble — the focused component
    # and its ancestors get the key first, so typing `1` into the VM search field isn't
    # hijacked.
    # 
    # _@param_ `key` — the pressed key
    # 
    # _@return_ — true if the key was handled
    def handle_key?: (String key) -> bool

    # Rebuilds the status line: the global quit key, then the focused pane's hint, then
    # its digit as the hide key for a hideable pane; the hidden panes' chips go right-aligned after. Keys
    # only on the left — the row does not repeat the focused pane's chip, which its own header
    # already carries; don't re-add it here to attribute the hints — two inverted blocks answer
    # one question twice. Walking *up* from the focused component
    # mirrors the direction a key bubbles, so the row describes the keys that will actually
    # be delivered — the focused search field consumes `/` and `ESC` before {VMPane} sees
    # them, and its hint says so.
    # 
    # `keyboard_hint` is virtui's own method on virtui's own panes; Tuile has no such seam,
    # and nothing calls this but the screen's focus hook.
    def refresh_status: () -> void

    # Refreshes every pane's contents from the cache and repaints. Call when new data is
    # available; must run with the screen lock held (on the UI thread).
    def update_data: () -> void

    # Re-bakes the status line, whose colors are flattened into its text. (The panes
    # rebuild their own headers.)
    def handle_theme_changed: () -> void

    # Hides the System or log pane, handing focus to the VMs.
    # 
    # _@param_ `pane` — the pane to hide
    def hide: ((SystemPane | LogPane) pane) -> void

    # Shows or hides the System or log pane, refitting the bottom strip, and saves the
    # panes' visibility to {State}.
    # 
    # _@param_ `pane` — the pane to show or hide
    # 
    # _@param_ `visible`
    def change_visibility: ((SystemPane | LogPane) pane, bool visible) -> void

    # Fits the bottom strip to whichever of the System and log panes are visible: the
    # separator only between two, the strip gone with neither, and a lone System pane
    # across the whole width — its {SYSTEM_WIDTH} cap only ever spared the log.
    def rearrange_bottom: () -> void

    # _@return_ — the VM list/controls pane
    attr_reader vms: VMPane

    # _@return_ — the host CPU/RAM/disk pane
    attr_reader system: SystemPane

    # _@return_ — the log pane
    attr_reader log: LogPane

    # _@return_ — the bottom status line's key hints
    attr_reader status: Tuile::Component::Label

    # _@return_ — the hidden panes' chips, right-aligned on the status line
    attr_reader hidden_chips: Tuile::Component::Label
  end

  # The host pane: shows CPU model/flags and usage, RAM and swap usage, and per-disk
  # usage — each as a labelled progress bar built from {Virt::Cache} data. Pressing `h`
  # opens {CpuFlagsDialog}, explaining the host's virtualization CPU flags.
  # 
  # A borderless `Layout::Vertical` (see design/decisions.md D_panes_are_layouts): a one-row
  # header carrying the focus chip, over the {Tuile::Component::List}. The list carries a
  # {Tuile::Component::List::Cursor::Limited} over the bar rows — focus indication
  # consistent with {VMPane}, and keyboard scrolling when the disk list overflows the
  # pane's fixed height (`less`/`htop` move highlights through non-actionable rows the
  # same way); headers and blank rows are skipped, since a cursor parked on one reads
  # as a glitch.
  # 
  # UI-thread-confined.
  class SystemPane < Tuile::Component::Layout::Vertical
    include Tuile

    # _@param_ `virt_cache` — the runtime cache to read host metrics from
    def initialize: (Virt::Cache virt_cache) -> void

    # Focuses the metric list. The pane itself is passive layout; the list is what owns
    # the cursor and the keyboard.
    def focus: () -> void

    # Rebuilds the pane's rows (CPU/RAM/disk bars) from the current cache data, and
    # recomputes the allowed cursor positions (the bar rows; section headers and disk
    # name rows are skipped). The rows lay themselves out at paint time, so a resize needs
    # no call here.
    def update: () -> void

    # _@return_ — the pane's focus chip, inverted iff the pane owns the
    # keyboard. `[2]` mirrors {AppLayout}'s focus-key map.
    def chip: () -> Tuile::StyledString

    # _@return_ — the footer hint advertising the `h` (Help) key
    def keyboard_hint: () -> String

    # Handles a key press: `h` opens {CpuFlagsDialog}.
    # 
    # _@param_ `key` — the pressed key
    # 
    # _@return_ — true if the key was handled
    def handle_key?: (String key) -> bool

    # Rebuilds the header when the pane enters or leaves the focus chain — the chip's
    # inverted/dim state is baked into the header label's text.
    # 
    # _@param_ `value`
    def active=: (bool value) -> void

    # Re-renders when the theme changes, so colors follow the new palette.
    def handle_theme_changed: () -> void

    # Rebuilds the header row — the focus chip.
    def rebuild_header: () -> void

    # Builds the one-line CPU summary — model, then whichever of the notable
    # virtualization flags the host has:
    # 
    #   x86_64, svm npt tsc_deadline_timer pcid invpcid pdpe1gb xsave
    # 
    # The flag list and its order come from {CpuFlag::ALL}; {CpuFlagsDialog} explains
    # each entry.
    # 
    # _@return_ — the CPU info line
    def format_cpu_info: () -> String

    # Draws a section header: `left` and `right` captions in `token`'s color, joined by a
    # frame rule that fills the remaining width.
    # 
    # _@param_ `left` — what to show to the left
    # 
    # _@param_ `right` — what to show to the right
    # 
    # _@param_ `token` — the theme token to draw `left` and `right` with
    # 
    # _@return_ — `(Integer width) -> String`, the header row
    def header: (String left, String right, Symbol token) -> Proc

    # Renders one labelled progress-bar row: `left` caption, the bar filling the remaining
    # width, then `right` caption.
    # 
    # _@param_ `left` — left caption (padded to 16 chars)
    # 
    # _@param_ `value` — current value, for drawing the progress bar
    # 
    # _@param_ `max` — max value, for drawing the progress bar
    # 
    # _@param_ `color` — progress bar color
    # 
    # _@param_ `right` — right caption (padded to 6 chars)
    # 
    # _@return_ — `(Integer width) -> String`, the bar row, including ANSI color codes
    def progress_bar: (
                        String left,
                        Numeric value,
                        Numeric max,
                        Tuile::Color color,
                        String right
                      ) -> Proc

    # Renders a {ResourceUsage} as a progress-bar row, captioning it with `tag`, the percent
    # used and the used/total byte sizes.
    # 
    # _@param_ `tag` — short (~4-char) label, e.g. `"Used"`/`"Swap"`
    # 
    # _@param_ `mem_usage` — the resource usage to render
    # 
    # _@param_ `color` — progress bar color
    # 
    # _@return_ — `(Integer width) -> String`, the bar row
    def usage_bar: (String tag, ResourceUsage mem_usage, Tuile::Color color) -> Proc

    # _@return_ — the metric list — the pane's focus target
    attr_reader list: Tuile::Component::List
  end

  # The `M` → Health check dialog of {VMPane}: one row per {Virt::Health::Finding}, its fix in
  # hint color beneath, and a Fix button under a finding whose fix virtui can run itself:
  # 
  #   HealthDialog.new(virt, 'vt-ubuntu', virt.health('vt-ubuntu')).open
  # 
  #   ┌vt-ubuntu health────────────────────────────────────────────────┐
  #   │ · balloon  virtio, no free page reporting: memory the guest    █
  #   │            frees stays with it until the balloon takes it      █
  #   │            virt-xml vt-ubuntu --edit --memballoon              █
  #   │            freePageReporting=on, then power it off and on      █
  #   │            [ Fix: turn on free page reporting… ]               █
  #   │ ✓ agent    connected                                           █
  #   │ ! /mnt/hc  hccrypt (dm-0) blocks discard                       █
  #   │            if it is LUKS: add `discard` to its /etc/crypttab   █
  #   │            options, then reboot the guest                      █
  #   │ · vda      28G unused after vda1                               █
  #   │            M → Grow root filesystem                            ░
  #   └q/ESC to close──────────────────────────────────────────────────┘
  # 
  # `✓` ok, `·` a note, `!` a warning, `–` not checked. A snapshot of the moment it was asked
  # for, so a Fix button closes it before its flow starts; picking Health check again shows the
  # result.
  # 
  # Tab moves between the buttons; PgUp/PgDn, the arrows and the wheel scroll.
  # 
  # UI-thread-confined.
  class HealthDialog < Tuile::Component::Dialog
    include Tuile
    SIZE: Tuile::Fraction
    FIXES: ::Hash[Symbol, String]
    VIRT_XML_FIXES: ::Array[Symbol]

    # _@param_ `virt` — the backend a Fix button runs through
    # 
    # _@param_ `vm` — VM name
    # 
    # _@param_ `health`
    def initialize: ((Virt::Virsh | Virt::VMEmulator) virt, String vm, Virt::Health health) -> void

    # PgUp/PgDn scroll half a page, the arrows a row: the {Tuile::Component::Scroller} claims
    # no keys of its own.
    # 
    # _@param_ `key`
    def handle_key?: (String key) -> bool

    def handle_theme_changed: () -> void

    # _@return_ — the head column: a margin, the mark, a space, the subject, two spaces
    def head_width: () -> Integer

    # _@param_ `finding`
    def add_entry: (Virt::Health::Finding finding) -> Entry

    # Writes the heads and the texts in the current theme's colors.
    def paint: () -> void

    # _@param_ `delta` — rows; negative scrolls up, and the scroller clamps the bottom
    def scroll_by: (Integer delta) -> void

    # Closes the dialog, which the fix would leave stale, then starts the fix's flow.
    # 
    # _@param_ `finding` — one whose remedy is in {FIXES}
    def fix: (Virt::Health::Finding finding) -> void

    # Asks the user to confirm a `virt-xml` edit of the definition, then makes it behind a
    # progress dialog; says to install `virt-xml` instead while it is missing.
    # 
    # _@param_ `what` — what the edit turns on, for the missing-`virt-xml` alert
    # 
    # _@param_ `args` — `virt-xml`'s arguments after the VM name, as the confirmation shows them
    # 
    # _@param_ `confirm` — the confirmation's caption
    # 
    # _@param_ `confirm_button`
    # 
    # _@param_ `progress` — the progress dialog's caption
    # 
    # _@param_ `done` — the closing alert's caption
    def edit_definition: (
                           String what,
                           String args,
                           confirm: String,
                           confirm_button: String,
                           progress: String,
                           done: String
                         ) -> void

    # _@param_ `theme`
    # 
    # _@param_ `severity`
    # 
    # _@return_ — one colored character
    def mark: (Theme theme, Symbol severity) -> String

    # One finding's components.
    # @!attribute [r] finding
    #   @return [Virt::Health::Finding]
    # @!attribute [r] head
    #   @return [Tuile::Component::Label] the mark and the subject
    # @!attribute [r] text
    #   @return [Tuile::Component::Label] the finding and its fix, wrapped
    class Entry < Data
      attr_reader finding: Virt::Health::Finding

      # _@return_ — the mark and the subject
      attr_reader head: Tuile::Component::Label

      # _@return_ — the finding and its fix, wrapped
      attr_reader text: Tuile::Component::Label
    end
  end

  # The `i` dialog of {VMPane}: what a VM is *defined* as, read-only.
  # 
  #   ┌─ vt-ubuntu ──────────────────────────────────────────┐
  #   │ OS        linux — http://ubuntu.com/ubuntu/24.04     │
  #   │ Machine   x86_64, pc-q35-10.2, KVM                   │
  #   │ Starts    with the host (autostart)                  │
  #   │ CPU       2 vCPUs, host-passthrough                  │
  #   │ Balloon   virtio, free page reporting                │
  #   │ Agent     no channel — no swap level for this VM     │
  #   │ Disks                                                │
  #   │   vda  virtio  qcow2  14G                            │
  #   │        /var/lib/libvirt/images/vt-ubuntu.qcow2       │
  #   │        vda13  1023M  ext4  /boot      108M / 921M  12% │
  #   │        vda14     4M                                  │
  #   │        vda15   106M  vfat  /boot/efi  6.3M / 104M   6% │
  #   │        vda1     13G  ext4  /          3.2G / 12G   26% │
  #   │        free    2.0G                                  │
  #   └───────────────────────────────────── q/ESC to close ─┘
  # 
  # A section the VM has nothing for is left out, except `Balloon` and `Agent`: those are
  # virtui's own prerequisites, and when one is missing the line says what that costs. Paths
  # get a line of their own, so a long one wraps without breaking the columns.
  # 
  # Under each disk, the guest's own view of it ({Virt::GuestStorage}) when there is one: the
  # partitions in disk order, the mounted filesystems, and the space after the last partition.
  # 
  # A snapshot of the moment `i` was pressed: it does not follow later ticks.
  # 
  # UI-thread-confined.
  class VMInfoDialog < Tuile::Component::Dialog
    include Tuile
    SIZE: Tuile::Fraction
    CAPTION_WIDTH: Integer

    # _@param_ `config` — what the VM is defined as
    # 
    # _@param_ `disk_stats` — the VM's disks from the last tick, for their capacities; a disk missing here gets a blank size
    # 
    # _@param_ `guest` — the guest's view of its disks; a `String` says why the guest could not tell, `nil` means it was not asked
    # 
    # _@param_ `autostart` — whether libvirt starts the VM with the host
    def initialize: (
                      Virt::DomainConfig config,
                      ?::Array[Virt::DiskStat] disk_stats,
                      ?(Virt::GuestStorage | String)? guest,
                      ?autostart: bool
                    ) -> void

    # The whole `i` flow: reads the VM's definition behind a progress dialog, fresh on every
    # press so the dialog never shows a definition older than the keypress
    # (design/decisions.md D_background_task), then opens the dialog.
    # 
    #   VMInfoDialog.start(virt_cache, 'vt-ubuntu')
    # 
    # The guest is asked for its disk layout only when the live definition says its agent is
    # connected; one that still cannot answer gets the reason in the dialog rather than
    # failing the whole read.
    # 
    # _@param_ `virt_cache` — the runtime cache, for the backend and the disks' capacities
    # 
    # _@param_ `vm` — the VM's name
    def self.start: (Virt::Cache virt_cache, String vm) -> void

    def handle_theme_changed: () -> void

    def rebuild: () -> void

    def identity: () -> ::Array[String]

    def resources: () -> ::Array[String]

    def cpu: () -> String

    def balloon: () -> String

    def agent: () -> String

    def boot: () -> ::Array[String]

    def devices: () -> ::Array[String]

    # One aligned row per disk, its source on the line under it, then the guest's view of it.
    def disk_rows: () -> ::Array[String]

    # _@param_ `target` — a host disk target, e.g. `vda`
    # 
    # _@return_ — aligned rows: each partition with what is mounted from it, the
    # filesystems on no partition, the free tail; empty when the guest did not say
    def guest_rows: (String target) -> ::Array[String]

    # _@param_ `filesystem`
    # 
    # _@param_ `partition` — the partition it is mounted from
    # 
    # _@return_ — type, mountpoint, `used / total`, use %, and the device it is
    # mounted from when that is not the partition itself (`dm-0` through LVM)
    def filesystem_cells: (Virt::GuestStorage::Filesystem filesystem, String? partition) -> ::Array[String]

    # _@param_ `used` — bytes
    # 
    # _@param_ `total` — bytes
    # 
    # _@return_ — `used / total`, and the use % as `df` rounds it
    def usage_cells: (Integer used, Integer total) -> ::Array[String]

    # _@return_ — why the guest could not describe its disks; empty if it did,
    # or was not asked
    def guest_failure: () -> ::Array[String]

    # _@param_ `cells` — rows of cells, ragged
    # 
    # _@param_ `right` — the columns to right-align
    # 
    # _@return_ — each row's cells padded to the column widths, two spaces apart
    def align: (::Array[::Array[String]] cells, right: ::Array[Integer]) -> ::Array[String]

    # _@param_ `disk`
    def disk_source: (Virt::DomainConfig::Disk disk) -> String

    # _@param_ `graphics`
    def graphics: (Virt::DomainConfig::Graphics graphics) -> String

    # _@return_ — e.g. `sound ich9, redirdev spicevmc ×2, rng virtio`
    def other_devices: () -> String

    # _@param_ `caption`
    # 
    # _@param_ `value`
    # 
    # _@return_ — `value` behind a hint-colored caption, padded to {CAPTION_WIDTH}
    def line: (String caption, String value) -> String

    # _@param_ `heading`
    # 
    # _@param_ `rows`
    # 
    # _@return_ — the bold heading over the indented rows; empty without rows
    def section: (String heading, ::Array[String] rows) -> ::Array[String]
  end

  # Runs a slow backend read off the UI thread behind a modal {ProgressDialog}, then hands
  # the result to a block back on the UI thread:
  # 
  #   BackgroundTask.new("Looking up #{vm}'s address") { virt.ip_address(vm) }
  #                 .run { |ip| Tuile::Component::ConfirmDialog.alert(vm, ip.to_s) }
  # 
  # The constructor's block runs on a fresh thread; {#run}'s block runs on the UI thread once
  # the progress dialog has closed, so it may open a dialog of its own. When the work raises a
  # `StandardError`, the progress dialog gives way to a "… failed" alert instead, and {#run}'s block
  # never runs.
  # 
  # ESC cancels: the result is dropped, and a later error is only logged. Work that takes a
  # while accepts the task's {Cancellation} and checks it between its steps to stop early:
  # 
  #   BackgroundTask.new('Reading the VMs') { |cancel| vms.map { cancel.check_canceled; virt.guest_os(_1) } }
  # 
  # Work that must not be abandoned halfway — what the user would read as "canceled" while it
  # runs on — opts out; the progress dialog then ignores ESC and `q`, and the work's {Cancellation} is
  # never canceled:
  # 
  #   BackgroundTask.new('Resizing vda', cancelable: false) { virt.resize_volume(path, size) }
  # 
  # The work owns its own timeouts. Nothing here kills the thread: `Thread#kill` mid-`Open3`
  # orphans the child process.
  # 
  # == Implementation details
  # Exceptions from {#run}'s block are not caught. They reach `Screen#on_error` as the bug
  # they are, rather than an alert blaming the read.
  # 
  # UI-thread-confined.
  class BackgroundTask
    # _@param_ `caption` — what the work does, e.g. "Reading web01's definition"; shown in the progress dialog and in the failure alert's title
    # 
    # _@param_ `cancelable` — whether ESC and `q` cancel the work
    def initialize: (String caption, ?cancelable: bool) ?{ (Cancellation cancel) -> Object } -> void

    # Opens the progress dialog and starts the work. Runs once per task.
    # 
    # _@return_ — the worker; nothing but a spec needs it
    def run: () ?{ (Object result) -> void } -> Thread

    # The worker thread's body: runs the work and submits its outcome to the UI thread.
    # 
    # _@param_ `event_queue`
    # 
    # _@param_ `on_done`
    def run_work: (Tuile::EventQueue event_queue, Proc on_done) -> void

    # _@param_ `result`
    # 
    # _@param_ `on_done`
    def finish: (Object result, Proc on_done) -> void

    # _@param_ `error`
    def report_failure: (Exception error) -> void
  end

  # The "please wait" box {BackgroundTask} shows while its work runs: the caption over a
  # sliding indeterminate bar, in a centered modal dialog sized to the caption.
  # 
  #   dialog = ProgressDialog.new("Reading web01's definition").open
  #   dialog.close
  # 
  # ESC and `q` close the dialog, as on any {Tuile::Component::Dialog}; an outside click does
  # not, so a stray click cannot cancel a read the user asked for. Built `cancelable: false`,
  # it swallows ESC and `q` instead — the dialog is modal, so nothing else gets them either,
  # not even virtui's own quit key — and its footer stops offering a cancel:
  # 
  #   ProgressDialog.new('Resizing vda', cancelable: false).open
  # 
  # UI-thread-confined.
  class ProgressDialog < Tuile::Component::Dialog
    include Tuile
    MIN_WIDTH: Integer
    WIDTH_CHROME: Integer
    HEIGHT: Integer

    # _@param_ `caption` — what is being done, e.g. "Reading web01's definition"
    # 
    # _@param_ `cancelable` — whether ESC and `q` close the dialog
    def initialize: (String caption, ?cancelable: bool) -> void

    # Measured on every layout pass, so a SIGWINCH re-fits it; {#declared_size} is ignored.
    # 
    # _@param_ `screen_size` — the screen to fit
    # 
    # _@return_ — wide enough for the caption, at least {MIN_WIDTH}, capped at the screen
    def declared_size_in: (Tuile::Size screen_size) -> Tuile::Size
  end

  # The `h` help dialog of {SystemPane}: one paragraph per virtualization CPU flag
  # this host has, taken from the {CpuFlag} glossary — the glossary for the flag list
  # the CPU summary line shows.
  # 
  # Content is a {Tuile::Component::TextView}, not a {Tuile::Component::List}: the
  # explanations are prose, and a `List` row that overflows is *ellipsized*, which
  # silently ate the end of every description. A `TextView` word-wraps instead, so
  # the dialog's width only decides how tall the text gets.
  # 
  # UI-thread-confined.
  class CpuFlagsDialog < Tuile::Component::Dialog
    include Tuile
    SIZE: Tuile::Fraction

    # _@param_ `flags` — the host's CPU flags, from {System::Info#cpu_flags}
    def initialize: (?::Set[String] flags) -> void

    # Re-renders when the theme changes, so the flag names follow the new palette.
    def handle_theme_changed: () -> void

    # Renders one blank-line-separated paragraph per present flag: the flag name in
    # the CPU accent color, then a colon and its description.
    def rebuild: () -> void

    # _@return_ — the host CPU flags currently explained
    attr_accessor flags: ::Set[String]
  end

  # The `M` → Resize disk image dialog: asks for one stopped VM's disk's new size, and hands
  # it to a block on Enter.
  # 
  #   DiskResizeDialog.new('vt-ubuntu', 'vda', volume) { |capacity| resize(capacity) }.open
  # 
  #   ┌Resize vt-ubuntu's vda─────────────────────────────────┐
  #   │Image     /var/lib/libvirt/images/vt-ubuntu.qcow2      │
  #   │Size      14G, 579M of it on the host                  │
  #   │Pool      default, 89G free                            │
  #   │                                                       │
  #   │New size  +10G                                         │
  #   │          → 24G                                        │
  #   └─────────────────────── Enter to resize · ESC to cancel┘
  # 
  # The field takes `+10G` (grow by) or `20G` (the new size), see {.parse_size}; the row under
  # it shows the outcome as it is typed, or why it cannot be. Grows only. Growing past the
  # pool's free space is warned about, not refused: the image is sparse, so it costs nothing
  # until the guest writes.
  # 
  # UI-thread-confined.
  class DiskResizeDialog < Tuile::Component::Dialog
    include Tuile
    CAPTION_WIDTH: Integer
    HEIGHT: Integer
    MIN_WIDTH: Integer
    GRANULE: Integer
    GUEST_HINT: String

    # _@param_ `vm` — the VM's name
    # 
    # _@param_ `target` — the disk's target, e.g. `vda`
    # 
    # _@param_ `volume` — the disk's image
    def initialize: (String vm, String target, Virt::Volume volume) ?{ (Integer capacity) -> void } -> void

    # The whole `M` → Resize disk image flow for a stopped VM: reads its disks behind a
    # progress dialog, lets the user pick one when there are several, opens the dialog, then
    # resizes behind a progress dialog that cannot be canceled and says what is left to do.
    # 
    #   DiskResizeDialog.start(virt_cache.virt, 'vt-ubuntu')
    # 
    # Offers the file-backed disks in a storage pool; a disk in none gets the command to run by
    # hand instead, since virtui does not escalate.
    # 
    # _@param_ `virt` — the backend
    # 
    # _@param_ `vm` — the VM's name; should be shut off, or the resize fails on QEMU's lock
    def self.start: ((Virt::Virsh | Virt::VMEmulator) virt, String vm) -> void

    # _@param_ `virt`
    # 
    # _@param_ `vm`
    # 
    # _@param_ `disks` — each with its volume, `nil` when in no pool
    def self.pick: ((Virt::Virsh | Virt::VMEmulator) virt, String vm, ::Array[[Virt::DomainConfig::Disk, Virt::Volume]] disks) -> void

    # _@param_ `virt`
    # 
    # _@param_ `vm`
    # 
    # _@param_ `target`
    # 
    # _@param_ `volume`
    # 
    # _@param_ `capacity` — bytes
    def self.resize: (
                       (Virt::Virsh | Virt::VMEmulator) virt,
                       String vm,
                       String target,
                       Virt::Volume volume,
                       Integer capacity
                     ) -> void

    # Reads a typed size: `+10G` grows by 10 GiB, `20G` asks for 20 GiB.
    # 
    #   DiskResizeDialog.parse_size('+10G', 14.GiB)   # => 24 GiB
    #   DiskResizeDialog.parse_size('1.5T', 14.GiB)   # => 1.5 TiB
    #   DiskResizeDialog.parse_size('10G', 14.GiB)    # raises: grows only
    # 
    # Units are binary, as everywhere on screen: `K`, `M`, `G`, `T`, optionally `iB`, any case.
    # A bare number is refused rather than read as bytes, which is what `virsh` would make of
    # it and nobody types. Rounded down to whole MiB.
    # 
    # _@param_ `text` — what the user typed
    # 
    # _@param_ `current` — the disk's capacity now, in bytes
    # 
    # _@return_ — the new capacity, in bytes, above `current`
    def self.parse_size: (String text, Integer current) -> Integer

    def handle_theme_changed: () -> void

    def rebuild: () -> void

    def show_outcome: () -> void

    def resize: () -> void

    # _@param_ `caption`
    # 
    # _@param_ `value`
    # 
    # _@return_ — `value` behind a hint-colored caption, padded to {CAPTION_WIDTH}
    def line: (String caption, String value) -> String

    # _@return_ — the size field
    attr_reader field: Tuile::Component::TextField

    # _@return_ — the image being resized
    attr_reader volume: Virt::Volume
  end
end

# Subprocess helpers that fail eagerly and loudly — the project's replacement for
# `system`/backticks/`exec`. Wraps Open3 so a missing or failing command never passes
# silently: {.sync} raises with stderr, {.async} runs it on a thread and logs the failure
# via `$log`.
# 
# **Pass one argument per word.** Both methods take a splat, and that is the whole
# defence against quoting bugs:
# 
#   Run.sync('df', '-P', path)      # argv — no shell, so `path` needs no escaping
#   Run.sync("df -P #{path}")       # one string — /bin/sh parses it, and a path
#                                   # containing a quote or a space breaks it
# 
# Ruby hands a lone string to `/bin/sh`, so interpolating a VM name or a file path into
# one means hand-escaping it correctly forever — see design/decisions.md D_argv_not_shell. The
# single-string form is kept only for literal commands with no interpolation.
module Run
  # {.sync} on a thread of its own: returns at once, and logs the outcome via `$log`
  # instead of returning or raising it. Success is logged at debug level; a failure —
  # a non-zero exit with its stderr, or a command that cannot even start — at error.
  # 
  # _@param_ `command` — the command and its arguments, one per element
  # 
  # _@return_ — the thread executing the command; call {Thread#join} to await it
  def self.async: (*::Array[String] command) -> Thread

  # Runs `command` synchronously and returns its stdout, printing nothing itself.
  # 
  # With a `cancellation:`, a cancel stops the command with `TERM`, reaps it, and raises
  # within {Cancellation::POLL_INTERVAL}; one canceled already spawns nothing:
  # 
  #   Run.sync('virsh', '-q', 'dumpxml', vm, cancellation: cancel)
  # 
  # _@param_ `command` — the command and its arguments, one per element
  # 
  # _@param_ `cancellation` — stops the command once canceled
  # 
  # _@return_ — the command's stdout, on exit code 0
  def self.sync: (*::Array[String] command, ?cancellation: Cancellation?) -> String

  # Waits for the child, stopping it when the wait ends any other way — a cancel, or an
  # exception thrown into this thread.
  # 
  # _@param_ `wait_thr` — the child's waiter, from popen3
  # 
  # _@param_ `readers` — the threads draining its stdout and stderr
  # 
  # _@param_ `cancellation`
  def self.wait: (Process::Waiter wait_thr, ::Array[Thread] readers, Cancellation? cancellation) -> void
end

# The libvirt backend: the domain model (VMs, their memory/disk/CPU stats) and
# the clients that talk to libvirt — {Virt::Virsh} (via the `virsh` CLI),
# {Virt::Cache} (thread-safe runtime cache) and {Virt::VMEmulator} (demo mode).
module Virt
  # A cache of all VM runtime info, for fast reads from the UI thread. Each VM's entry is a
  # {VMCache} carrying its {DomainData} plus derived CPU/memory figures.
  # 
  # == Thread-safety
  # 
  # Thread-safe: every reader may be called from any thread and returns immutable, possibly
  # slightly-stale data, which is fine for display. The lone writer, {#update}, is the
  # exception and carries its own contract.
  class Cache
    STATS_PERIOD_SECONDS: Integer
    GUEST_FS_SECONDS: Integer

    # Builds the cache and performs an initial {#update}.
    # 
    # _@param_ `virt` — libvirt client used to read VM data
    # 
    # _@param_ `sysinfo` — host-metrics reader (or {System::Emulator})
    def initialize: (Virsh virt, System::Info sysinfo) -> void

    # _@return_ — how many VMs are currently running
    def up: () -> Integer

    # _@return_ — names of all known VMs
    def domains: () -> ::Array[String]

    # _@param_ `domain` — domain name
    # 
    # _@return_ — memory stats, or `nil` if the VM isn't running
    def memstat: (String domain) -> MemoryStat?

    # _@param_ `domain` — domain name
    # 
    # _@return_ — cached entry, or `nil` if no such VM is known
    def cache: (String domain) -> VMCache?

    # _@param_ `domain` — domain name
    # 
    # _@return_ — latest snapshot, or `nil` if no such VM is known
    def data: (String domain) -> DomainData?

    # _@param_ `domain` — domain name
    # 
    # _@return_ — one of `:running`, `:shut_off`, `:paused`, `:other`
    def state: (String domain) -> Symbol

    # _@param_ `domain` — domain name
    # 
    # _@return_ — `true` if running
    def running?: (String domain) -> bool

    # _@param_ `domain` — domain name
    # 
    # _@return_ — static VM config, or `nil` if no such VM is known
    def info: (String domain) -> DomainInfo?

    # Validates the requested size against the VM's limits, then delegates to {Virsh#set_actual}.
    # 
    # _@param_ `domain` — domain name
    # 
    # _@param_ `new_actual` — the new `actual` memory size, in bytes
    def set_actual: (String domain, Integer new_actual) -> void

    # Refreshes every VM's data plus the host memory/CPU/disk stats, diffing against the
    # previous snapshot for derived figures. Unlike every other method here, this one must
    # run on the background timer thread, never the UI thread; `@write_lock` keeps it from
    # overlapping itself.
    def update: () -> void

    # How much host disk space a VM disk's image occupies, against that host disk's total.
    # 
    # _@param_ `disk_stat` — the VM disk whose image to locate
    # 
    # _@return_ — {DiskStat#allocated} out of the host disk's total, or `nil`
    # if the image isn't found on any tracked disk
    def host_disk_usage: (DiskStat disk_stat) -> ResourceUsage?

    # A running guest's filesystem usage: the last good read while it is fresh, else a new one.
    # 
    # _@param_ `domain` — VM name; must be running
    # 
    # _@param_ `previous` — what the last tick carried
    # 
    # _@return_ — see {VMCache#guest_fs_usage}
    def guest_fs_usage: (String domain, ::Hash[String, ResourceUsage]? previous) -> ::Hash[String, ResourceUsage]?

    # _@return_ — sum of the RSS (host memory) of all VMs, in bytes
    def total_vm_rss_usage: () -> Integer

    # Combined CPU usage of all VMs, normalized to the host core count so that 100% means
    # all host cores are fully utilized.
    # 
    # _@return_ — total VM CPU usage, `0..100%`
    def total_vm_cpu_usage: () -> Float

    # _@return_ — most recent whole-host CPU usage, `0..100%` (see {System::CpuUsage})
    def host_cpu_usage: () -> Float

    # _@return_ — host memory statistics, refreshed by {#update}
    attr_reader host_mem_stat: System::MemoryStat

    # _@return_ — static host CPU topology
    attr_reader cpu_info: CpuInfo

    # _@return_ — the libvirt client backing this cache
    attr_reader virt: Virsh

    # _@return_ — maps physical disk name to its usage
    attr_reader disks: ::Hash[String, System::DiskUsage]

    # _@return_ — host CPU flags such as `npt`, `nx` etc. — not just virtualization-related
    attr_reader cpu_flags: ::Set[String]

    # One VM's cached snapshot plus the figures derived by diffing it against the previous
    # snapshot.
    # 
    # @!attribute [r] data
    #   @return [DomainData] the latest VM snapshot
    # @!attribute [r] cpu_usage
    #   @return [Float] per-core CPU usage in percent; 100% means one core fully utilized,
    #     so a busy multi-core VM may exceed 100 (see {DomainData#cpu_usage})
    # @!attribute [r] mem_data_age_seconds
    #   @return [Integer, nil] age of the guest memory data, in seconds; `nil` if balloon
    #     data is unavailable or the VM is shut down
    # @!attribute [r] swap_out_rate
    #   @return [Float, nil] how fast the guest is writing pages to swap, in bytes per
    #     second; `nil` if the guest doesn't report swap counters (see
    #     {MemoryStat#swap_data_available?}) or this is the VM's first sample
    # 
    #     The one figure here that says whether a guest is *paying* for memory pressure.
    #     `MemAvailable` can't: evicting anon pages to swap raises it, so a swapping guest
    #     and an idle one report the same `guest_mem` — see `design/ideas/swap-despite-ballooning.md`.
    #     Positive means reclaim is hitting the swap device right now; `0.0` is what at-rest
    #     looks like, even for a guest with gigabytes already parked in swap.
    # @!attribute [r] guest_swap
    #   @return [ResourceUsage, nil] how full the guest's swap device is, read from the guest
    #     itself; `nil` for a VM that was not asked (its {#guest_os} does not declare Linux)
    #     or could not answer (see {GuestSampler#swap}) — which is all of them unless the
    #     backend was given a {GuestSampler}
    # 
    #     The companion to {#swap_out_rate}, and the other half of the story: the rate says
    #     whether reclaim is hitting the device *now*, this says how much the guest is still
    #     carrying from earlier. Unlike everything else here it is not derived from
    #     {#data} — it arrives from a separate read of the guest's own `/proc/meminfo`.
    # @!attribute [r] guest_os
    #   @return [GuestOS] the OS family this VM's definition declares. Asked once per domain
    #     and carried on every tick after, so reading it costs nothing — and unlike
    #     {#guest_swap} it is populated for a shut-off VM too
    # @!attribute [r] ip_address
    #   @return [String, nil] the VM's address as the host knows it, re-read every tick (see
    #     {Virsh#ip_address}); `nil` for a stopped VM, or one neither the DHCP leases nor the
    #     host's neighbour table has seen
    # @!attribute [r] guest_fs_usage
    #   @return [Hash{String => ResourceUsage}, nil] how full the guest has filled each disk,
    #     keyed by host target (see {Virsh#guest_fs_usage}), at most {GUEST_FS_SECONDS} old;
    #     `nil` for a stopped VM, or one that could not answer
    # @!attribute [r] sysrq_mask
    #   @return [Integer, nil] the guest's `kernel.sysrq` (see {Virsh#guest_sysrq_mask}), read
    #     once its agent answers and kept until the VM stops — so it outlives the agent of a
    #     guest whose shutdown hangs. `nil` for a stopped or non-Linux VM, or one whose agent
    #     has not answered since it started
    class VMCache
      # Builds a cache entry by diffing the previous entry against the current snapshot
      # (for CPU usage, memory-data age and swap-out rate).
      # 
      # _@param_ `prev_cache` — previous entry for this VM, or `nil` on first sight
      # 
      # _@param_ `next_data` — current VM snapshot
      # 
      # _@param_ `guest_swap` — this tick's guest-agent swap level, if any
      # 
      # _@param_ `guest_os` — what this domain's definition declares
      # 
      # _@param_ `ip_address` — this tick's address, if any
      # 
      # _@param_ `guest_fs_usage` — the guest's filesystem usage, if any
      # 
      # _@param_ `sysrq_mask` — the guest's `kernel.sysrq`, if known
      # 
      # _@return_ — the derived cache entry
      def self.diff: (
                       VMCache? prev_cache,
                       DomainData next_data,
                       ?ResourceUsage? guest_swap,
                       ?GuestOS guest_os,
                       ?String? ip_address,
                       ?::Hash[String, ResourceUsage]? guest_fs_usage,
                       ?Integer? sysrq_mask
                     ) -> VMCache

      # Bytes-per-second at which the guest wrote to swap between the previous sample and
      # this one, or `nil` if it can't be computed.
      # 
      # _@param_ `prev_cache` — previous entry for this VM, or `nil` on first sight
      # 
      # _@param_ `next_data` — current VM snapshot
      # 
      # _@return_ — swap-out rate in bytes per second
      def self.swap_out_rate: (VMCache? prev_cache, DomainData next_data) -> Float?

      # _@return_ — the VM's static config
      def info: () -> DomainInfo

      # CPU usage normalized to the guest's own core count, so 100% means every guest core
      # is fully utilized (unlike the per-core {#cpu_usage}).
      # 
      # _@return_ — guest CPU usage, `0..100%`
      def guest_cpu_usage: () -> Float

      # Whether the guest memory data is too old to trust (≥ 12s).
      # 
      # 12s clears the normal lag — libvirt refreshes balloon data only every ~5s, and we
      # poll every ~2s on top, so healthy data is routinely 5–7s old; see design/decisions.md
      # D_wall_clock_mem_age. Anything older means the guest stopped reporting.
      # 
      # _@return_ — true if the memory data is stale
      def stale?: () -> bool

      # _@return_ — the latest VM snapshot
      attr_reader data: DomainData

      # _@return_ — per-core CPU usage in percent; 100% means one core fully utilized,
      # so a busy multi-core VM may exceed 100 (see {DomainData#cpu_usage})
      attr_reader cpu_usage: Float

      # _@return_ — age of the guest memory data, in seconds; `nil` if balloon
      # data is unavailable or the VM is shut down
      attr_reader mem_data_age_seconds: Integer?

      # _@return_ — how fast the guest is writing pages to swap, in bytes per
      # second; `nil` if the guest doesn't report swap counters (see
      # {MemoryStat#swap_data_available?}) or this is the VM's first sample
      # 
      # The one figure here that says whether a guest is *paying* for memory pressure.
      # `MemAvailable` can't: evicting anon pages to swap raises it, so a swapping guest
      # and an idle one report the same `guest_mem` — see `design/ideas/swap-despite-ballooning.md`.
      # Positive means reclaim is hitting the swap device right now; `0.0` is what at-rest
      # looks like, even for a guest with gigabytes already parked in swap.
      attr_reader swap_out_rate: Float?

      # _@return_ — how full the guest's swap device is, read from the guest
      # itself; `nil` for a VM that was not asked (its {#guest_os} does not declare Linux)
      # or could not answer (see {GuestSampler#swap}) — which is all of them unless the
      # backend was given a {GuestSampler}
      # 
      # The companion to {#swap_out_rate}, and the other half of the story: the rate says
      # whether reclaim is hitting the device *now*, this says how much the guest is still
      # carrying from earlier. Unlike everything else here it is not derived from
      # {#data} — it arrives from a separate read of the guest's own `/proc/meminfo`.
      attr_reader guest_swap: ResourceUsage?

      # _@return_ — the OS family this VM's definition declares. Asked once per domain
      # and carried on every tick after, so reading it costs nothing — and unlike
      # {#guest_swap} it is populated for a shut-off VM too
      attr_reader guest_os: GuestOS

      # _@return_ — the VM's address as the host knows it, re-read every tick (see
      # {Virsh#ip_address}); `nil` for a stopped VM, or one neither the DHCP leases nor the
      # host's neighbour table has seen
      attr_reader ip_address: String?

      # _@return_ — how full the guest has filled each disk,
      # keyed by host target (see {Virsh#guest_fs_usage}), at most {GUEST_FS_SECONDS} old;
      # `nil` for a stopped VM, or one that could not answer
      attr_reader guest_fs_usage: ::Hash[String, ResourceUsage]?

      # _@return_ — the guest's `kernel.sysrq` (see {Virsh#guest_sysrq_mask}), read
      # once its agent answers and kept until the VM stops — so it outlives the agent of a
      # guest whose shutdown hangs. `nil` for a stopped or non-Linux VM, or one whose agent
      # has not answered since it started
      attr_reader sysrq_mask: Integer?
    end
  end

  # A libvirt client that drives libvirt by shelling out to the `virsh` CLI (parsing its
  # text output). Install it with `sudo apt install libvirt-clients`.
  # 
  # Not the ruby-libvirt binding — see design/decisions.md D_virsh_cli.
  # 
  # Every call to the outside world goes through a *runner* ({VirshSession} for a
  # persistent child, {VirshSpawn} for a process per command), so this class holds nothing
  # but parsing:
  # 
  #   # what the app builds:
  #   Virsh.new(runner: session, guest_sampler: GuestSampler.new(agent: GuestAgent.new(runner: session)))
  #   Virsh.new(runner: VirshSpawn.new)           # a process per command
  #   Virsh.new                                   # ditto, and the parser-spec default
  # 
  # The constructor default stays {VirshSpawn} even though the app runs a session: a
  # default that spawns a persistent child would leave one behind for every `Virsh.new`
  # that is never closed, which is most of the specs. `bin/virtui` picks the transport.
  # 
  # Stateless apart from the runner; the read methods accept fixture parameters for
  # testing, which bypass the runner entirely.
  class Virsh
    LIBOSINFO_URI: String
    OSINFO_ID: Regexp

    # _@param_ `runner` — transport for every `virsh` invocation
    # 
    # _@param_ `guest_sampler` — the channel {#guest_swap} and {#guest_fs_usage} read through, or `nil` for a backend that reports neither
    def initialize: (?runner: (VirshSpawn | VirshSession), ?guest_sampler: GuestSampler?) -> void

    # The guest's own view of how full its swap device is.
    # 
    # Kept out of {#domain_data} deliberately: that is one `domstats` call for the whole
    # fleet, while this is three agent calls *per VM* that fail per VM — see design/decisions.md
    # D_guest_swap_level.
    # 
    # _@param_ `domain_name` — VM name; must be running
    # 
    # _@return_ — swap used out of the guest's swap total, or `nil` if there
    # is no sampler to ask (see {GuestSampler#swap} for the other reasons)
    def guest_swap: (String domain_name) -> ResourceUsage?

    # The guest's own view of how full each of its disks is, from its mounted filesystems.
    # 
    #   virsh.guest_fs_usage('vt-ubuntu')   # => {"vda" => #<ResourceUsage 3.4G/15G (23%)>}
    # 
    # Out of {#domain_data} for the reason {#guest_swap} is, and cheaper than it: one
    # `guest-ping` and one `guestinfo`, which {Cache} asks only every
    # {Cache::GUEST_FS_SECONDS}.
    # 
    # _@param_ `domain_name` — VM name; must be running
    # 
    # _@return_ — keyed by host target, or `nil` if there is
    # no sampler to ask (see {GuestSampler#fs_usage} for the other reasons)
    def guest_fs_usage: (String domain_name) -> ::Hash[String, ResourceUsage]?

    # The guest's `kernel.sysrq`, which decides whether {#sysrq_power_off} reaches it. Read
    # ahead, while the guest is healthy: a guest whose shutdown hangs has usually stopped its
    # agent already.
    # 
    # _@param_ `domain_name` — VM name; must be running
    # 
    # _@return_ — see {GuestAgent#sysrq_mask}; `nil` if there is no sampler to ask
    # (see {GuestSampler#sysrq_mask} for the other reasons)
    def guest_sysrq_mask: (String domain_name) -> Integer?

    # The OS family the VM's definition declares, from its libosinfo metadata.
    # 
    #   virsh.guest_os('win11')   # => windows (http://microsoft.com/win/11)
    #   virsh.guest_os('BASE')    # => unknown — nothing declared, or an unknown vendor
    # 
    # Works on a *shut-off* domain, and needs no guest agent — which is the whole reason
    # virtui reads the declaration rather than asking the running guest (design/decisions.md
    # D_guest_os_from_xml). Cheap but not free: one `virsh` round-trip per call, so callers
    # memoize it per domain ({Cache#update} does).
    # 
    # Never raises. A domain that vanished mid-read, a `virsh` that refuses, metadata that
    # is simply absent — all of it is a guest we cannot classify, which is
    # {GuestOS::UNKNOWN}, not an error.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@param_ `metadata` — canned `virsh metadata` output for testing; runs the real command when `nil`
    # 
    # _@return_ — the declared family; {GuestOS::UNKNOWN} if the domain declares
    # nothing, names a vendor {GuestOS::VENDORS} does not know, or could not be read
    def guest_os: (String domain_name, ?String? metadata) -> GuestOS

    # The VM's address as the host knows it: the first row of `virsh domifaddr --source
    # lease`, or of `--source arp` when libvirt's DHCP handed out no lease.
    # 
    #   virsh.ip_address('Flow')   # => "192.168.122.137"
    # 
    # IPv4 in practice, prefix dropped (`arp` reports every address as `/0`). `lease` covers
    # guests on libvirt's own networks, `arp` bridged ones in the host's neighbour table — which
    # can still hold an address the guest has moved off (design/research.md R_virsh_domifaddr).
    # 
    # Not `--source agent`: an agent-less guest fails that read rather than answering an empty
    # table, making the address a second read allowed to go quiet.
    # 
    # _@param_ `domain_name` — VM name; must be running
    # 
    # _@param_ `lease` — canned `domifaddr --source lease` output for testing; runs the real command when `nil`
    # 
    # _@param_ `arp` — canned `domifaddr --source arp` output, likewise
    # 
    # _@return_ — the address, or `nil` if neither table has a row
    def ip_address: (String domain_name, ?String? lease, ?String? arp) -> String?

    # The domain's definition, from `virsh dumpxml`: live for a running domain, persistent
    # for a shut-off one.
    # 
    #   virsh.domain_config('vt-ubuntu').firmware   # => :uefi
    # 
    # A read, yet spawned through {VirshSession#sync}: on the session it would queue behind the
    # tick's guest-agent calls while the user waits on a progress dialog.
    # 
    # Never pass `--security-info`: without it libvirt leaves the VNC/SPICE `passwd=` out.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@param_ `xml` — canned `dumpxml` output for testing; runs the real command when `nil`
    # 
    # _@param_ `inactive` — the definition the next power-on brings (`--inactive`), rather than the one running now
    def domain_config: (String domain_name, ?String? xml, ?inactive: bool) -> DomainConfig

    # Whether libvirt starts the domain with the host, from `virsh dominfo`'s `Autostart:`;
    # not in the XML. Spawned, like {#domain_config}.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@param_ `dominfo` — canned `dominfo` output for testing; runs the real command when `nil`
    def autostart?: (String domain_name, ?String? dominfo) -> bool

    # The running guest's own view of its disks: partitions, and what is mounted where.
    # 
    #   virsh.guest_storage('vt-ubuntu').disk('vda').partitions.last.name   # => "vda1"
    # 
    # `virsh guestinfo` plus a few guest file reads (see {GuestStorage}), all spawned, like
    # {#domain_config}: ~0.25 s for a disk of four partitions.
    # 
    # _@param_ `domain_name` — VM name; must be running, with an agent
    # 
    # _@param_ `guestinfo` — canned `guestinfo --filesystem --disk` output for testing; runs the real command when `nil`
    # 
    # _@param_ `guest_files` — canned guest files by path for testing; read through the agent when `nil`
    def guest_storage: (String domain_name, ?String? guestinfo, ?::Hash[String, String]? guest_files) -> GuestStorage

    # Whether the VM is set up the way virtui and the host's disk need it (see {Health}).
    # 
    #   virsh.health('vt-ubuntu').findings.reject { _1.severity == :ok }
    # 
    # Both definitions, then, on a running VM whose agent is connected, {#guest_storage} and
    # the guest files {Health.assess} asks for; all spawned, ~0.5 s on vt-ubuntu. A guest that
    # cannot answer turns into a skipped finding rather than a failed check.
    # 
    # _@param_ `domain_name` — VM name
    def health: (String domain_name) -> Health

    # _@param_ `domain_name` — a running VM with a connected agent
    # 
    # _@return_ — the guest's disks, or virsh's reason it could not tell
    def guest_or_reason: (String domain_name) -> (GuestStorage | String)

    # Turns on the balloon's free page reporting in the VM's persistent definition, the fix
    # {Health} offers for its absence: the `virt-xml` line that finding prints. Takes effect
    # once the VM is powered off and on; a running QEMU keeps the device it has.
    # 
    # `virt-xml`, not `dumpxml` + `define`: it reads the definition with its secrets, which a
    # plain `dumpxml` leaves out and a `define` of it would wipe (design/decisions.md
    # D_health_check). Install it with `sudo apt install virt-install`.
    # 
    # _@param_ `domain_name` — VM name, running or not
    def enable_free_page_reporting: (String domain_name) -> void

    # Sets `discard='unmap'` on one disk in the VM's persistent definition, the fix {Health}
    # offers when the host drops that disk's discards: the `virt-xml` line that finding
    # prints. Takes effect once the VM is powered off and on, like
    # {#enable_free_page_reporting}, and goes through `virt-xml` for the same reason.
    # 
    # _@param_ `domain_name` — VM name, running or not
    # 
    # _@param_ `target` — the disk's target, e.g. `vda`
    def enable_discard: (String domain_name, String target) -> void

    # Whether {#enable_free_page_reporting} and {#enable_discard} can run: `virt-xml` is on
    # the `PATH`. Looked up in Ruby, so the UI thread may ask.
    def virt_xml_available?: () -> bool

    # The storage-pool volume behind a disk image, found by its path.
    # 
    #   virsh.volume('/var/lib/libvirt/images/vt-ubuntu.qcow2').pool   # => "default"
    # 
    # Three spawned reads, like {#domain_config}. Works though the user cannot read the pool's
    # directory: libvirtd looks the path up.
    # 
    # _@param_ `path` — the image, as `<disk><source file=>` names it
    # 
    # _@param_ `vol_pool` — canned `vol-pool` output for testing; runs the real command when `nil`
    # 
    # _@param_ `vol_info` — canned `vol-info --bytes` output, likewise
    # 
    # _@param_ `pool_info` — canned `pool-info --bytes` output, likewise
    # 
    # _@return_ — `nil` if the image is in no storage pool
    def volume: (
                  String path,
                  ?String? vol_pool,
                  ?String? vol_info,
                  ?String? pool_info
                ) -> Volume?

    # Grows a stopped VM's disk image to a new capacity, via `virsh vol-resize`.
    # 
    # Grows only: libvirt refuses a capacity below the current one unless given `--shrink`,
    # which this never passes. A running VM's image is refused too — QEMU holds its write
    # lock, so `qemu-img` cannot open it — and that covers a VM started after the caller
    # checked its state.
    # 
    # _@param_ `path` — the image (see {#volume})
    # 
    # _@param_ `capacity` — the new size the guest will see, in bytes
    def resize_volume: (String path, Integer capacity) -> void

    # How a running guest's root filesystem would grow into the free space after it, checked
    # against the guest's layout and its agent (see {GuestRootGrow}).
    # 
    #   plan = virsh.root_grow_plan('vt-ubuntu')
    #   plan.growth   # => 1073741824, after a 1 GiB image resize
    # 
    # _@param_ `domain_name` — VM name; must be running, with an agent
    def root_grow_plan: (String domain_name) -> GuestRootGrow::Plan

    # Grows the guest's root partition and filesystem as the plan says, through `guest-exec`.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@param_ `plan` — from {#root_grow_plan}
    def grow_root: (String domain_name, GuestRootGrow::Plan plan) -> void

    # Drops what the guest sampler remembers about a VM's failed samples.
    # 
    # _@param_ `domain_name` — VM name, typically one that has just stopped running (see {GuestSampler#forget})
    def forget_guest: (String domain_name) -> void

    # Lifts a running VM's written-off guest reads if its agent has just connected.
    # 
    # _@param_ `domain_name` — VM name (see {GuestSampler#revive})
    def revive_guest: (String domain_name) -> void

    # Reads runtime stats for every VM via `virsh domstats`.
    # 
    # _@param_ `domstats_file` — canned `virsh domstats` output for testing; runs the real command when `nil`
    # 
    # _@param_ `sampled_at` — millis since epoch to stamp the snapshots with; defaults to now. For testing
    # 
    # _@return_ — maps VM name to its {DomainData}
    def domain_data: (?String? domstats_file, ?Integer? sampled_at) -> ::Hash[String, DomainData]

    # Extracts per-disk stats from the flattened `block.N.*` keys of one VM's domstats.
    # Disks missing any of name/allocation/capacity/physical are skipped.
    # 
    # The image's `du` is `allocation` on a shut-off domain but `physical` on a running one:
    # libvirt fills both fields from a different source per state, and a running domain's
    # `allocation` is QEMU's highest written offset — 0 right after a start
    # (design/research.md R_virsh_domstats_block).
    # 
    # _@param_ `data` — one VM's domstats, e.g. `block.0.capacity=1231`
    # 
    # _@param_ `state` — the domain's state, as {#domain_data} maps it
    # 
    # _@return_ — parsed stats, one per fully-described disk
    def parse_disk_data: (::Hash[String, String] data, Symbol state) -> ::Array[DiskStat]

    # _@param_ `path` — a disk image
    # 
    # _@return_ — `virsh vol-pool`'s answer, or `nil` if the image is in no pool
    def pool_of: (String path) -> String?

    # _@param_ `text` — `Key: value` lines, as `vol-info` and `pool-info` print them
    def fields: (String text) -> ::Hash[String, String]

    # _@param_ `fields` — from {#fields}
    # 
    # _@param_ `key` — e.g. `Capacity`
    # 
    # _@return_ — the field's bytes, from `--bytes` output (`15032385536 bytes`, or bare)
    def bytes: (::Hash[String, String] fields, String key) -> Integer

    # The Address column of a `virsh -q domifaddr` table's first row, without its `/prefix`.
    # 
    # `-q` drops the header and the `---` rule, so every non-blank line is a row, and a header
    # that does reach here raises rather than hiding the address behind it.
    # 
    # _@param_ `domifaddr` — the table; empty means no rows
    # 
    # _@return_ — the address, or `nil` if the table has no rows
    def first_address: (String domifaddr) -> String?

    # _@return_ — whether `virsh` is installed and on the `PATH`
    def self.available?: () -> bool

    # Reads the host CPU topology via `virsh nodeinfo`.
    # 
    # _@param_ `virsh_nodeinfo` — canned `virsh nodeinfo` output for testing; runs the real command when `nil`
    # 
    # _@return_ — the host CPU topology
    def hostinfo: (?String? virsh_nodeinfo) -> CpuInfo

    # Sets the current (`actual`) memory size of a running VM via `virsh setmem`.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@param_ `new_actual` — new memory size, in bytes
    def set_actual: (String domain_name, Integer new_actual) -> void

    # Enables periodic guest memory-stat collection on a running VM, so the guest-reported
    # balloon fields (`balloon.usable`/`available`/`unused`/`last-update`) stay fresh.
    # 
    # libvirt's collection period defaults to 0 (disabled): until something sets it, those
    # fields freeze at boot-time values while host-sourced fields (`cpu.time`,
    # `balloon.rss`) keep updating — making RAM look stuck even as CPU moves. The period is
    # a live property of the running QEMU process, so it must be re-armed after every full
    # power-off; {Cache#update} does that. Why virtui arms it at all instead of asking the
    # user to configure the domain XML: design/decisions.md D_mem_stats_self_armed.
    # 
    # Runs asynchronously (failures logged, not raised): a VM without a
    # balloon device rejects this command, and that must not abort the refresh loop.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@param_ `period_seconds` — how often the guest refreshes its stats, in seconds
    # 
    # _@return_ — the thread running the command
    def set_mem_stats_period: (String domain_name, Integer period_seconds) -> Thread

    # Starts a stopped VM. Behaviour is undefined for an already-started or paused VM.
    # 
    # Asynchronous: `virsh start` takes ~800ms, and the UI thread must not wait on it.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@return_ — the thread running the command
    def start: (String domain_name) -> Thread

    # Asks a VM to shut down gracefully.
    # 
    # Asynchronous: `virsh shutdown` takes 0.5–5s, and the UI thread must not wait on it.
    # 
    # _@param_ `domain_name` — VM name
    # 
    # _@return_ — the thread running the command
    def shutdown: (String domain_name) -> Thread

    # Asks the VM to reboot itself gracefully.
    # 
    # _@param_ `domain_name` — VM name
    def reboot: (String domain_name) -> void

    # Resets the VM forcefully (a hard power-cycle).
    # 
    # _@param_ `domain_name` — VM name
    def reset: (String domain_name) -> void

    # Forces the VM off (a hard power-off, via `virsh destroy`).
    # 
    # _@param_ `domain_name` — VM name
    def force_off: (String domain_name) -> void

    # Powers the VM off through magic SysRq S, U, O: softer than {#force_off}, and it works
    # where {#shutdown} hangs (see {MagicSysRq}). Blocks for ~6–16 s.
    # 
    # _@param_ `domain_name` — a running Linux VM whose SysRq mask allows it
    def sysrq_power_off: (String domain_name) -> void

    # Reboots the VM through magic SysRq S, U, B: the soft counterpart of {#reset}. Blocks ~6 s.
    # 
    # _@param_ `domain_name` — a running Linux VM whose SysRq mask allows it
    def sysrq_reboot: (String domain_name) -> void

    # _@return_ — the transport in use
    attr_reader runner: (VirshSpawn | VirshSession)
  end

  # Whether a VM is set up the way virtui and the host's disk need it — the judgement behind
  # `M` → Health check:
  # 
  #   health = virsh.health('vt-bios')
  #   health.findings.map { [_1.severity, _1.subject] }
  #   # => [[:note, "balloon"], [:warning, "agent"], [:warning, "sda"], [:skipped, "guest"]]
  #   health.findings[2].text   # => "the host drops this disk's discards: space the guest frees stays taken"
  #   health.findings[2].fix    # => "virt-xml vt-bios --edit target=sda --disk discard=unmap, then power it off and on"
  # 
  # The discard checks are the point: every bus tells the guest it may discard, and the
  # guest's `fstrim` reports the same either way, so only the host's `<driver discard=>` says
  # whether freed space ever leaves the image (design/research.md R_discard_reclaim). Those
  # and the balloon and agent checks need only the definition; the guest checks — the
  # device-mapper layers, periodic trim, unused disk space — need it running, with an agent.
  # 
  # Each finding is words for the user, and a fix to type; a fix virtui can run itself also
  # names it as a {Finding#remedy}, which the window offers as a button. Nothing here changes
  # the VM.
  # 
  # @!attribute [r] findings
  #   @return [Array<Finding>] in the order the window lists them
  class Health
    TRIM_TIMER: String

    # Judges a VM from its definitions and, when running, its guest.
    # 
    # _@param_ `live` — `dumpxml`; on a stopped VM, the persistent definition
    # 
    # _@param_ `inactive` — `dumpxml --inactive`: what the next power-on brings
    # 
    # _@param_ `guest` — the guest's disks; a String says why the guest could not tell; `nil` when it was not asked — the VM is stopped, or has no connected agent, which `live` says
    # 
    # _@param_ `read_file` — guest path → its contents, `String`; may raise {GuestAgent::Unavailable}
    # 
    # _@param_ `file_exist` — guest path → `Boolean`
    def self.assess: (
                       DomainConfig live,
                       DomainConfig inactive,
                       (GuestStorage | String)? guest,
                       read_file: untyped,
                       file_exist: untyped
                     ) -> Health

    # Whether {.assess} wants the guest's disks: the VM runs, and its agent is connected.
    # 
    # _@param_ `live`
    def self.ask_guest?: (DomainConfig live) -> bool

    # _@param_ `live`
    # 
    # _@param_ `reason` — why the guest could not tell, when it was asked
    # 
    # _@return_ — the one finding standing in for the guest checks
    def self.unasked: (DomainConfig live, String? reason) -> Finding

    # A disk the guest can write a filesystem to: no CD-ROM, no read-only image, no SCSI
    # passthrough (`lun`), whose discards are the device's own business.
    # 
    # _@param_ `disk`
    def self.checked_disk?: (DomainConfig::Disk disk) -> bool

    # _@param_ `config`
    # 
    # _@param_ `next_boot` — the inactive definition
    def self.balloon: (DomainConfig config, DomainConfig next_boot) -> Finding

    # _@param_ `config`
    def self.agent: (DomainConfig config) -> Finding

    # _@param_ `vm`
    # 
    # _@param_ `disk` — from the live definition
    # 
    # _@param_ `next_boot` — the same target in the inactive one
    def self.discard: (String vm, DomainConfig::Disk disk, DomainConfig::Disk? next_boot) -> Finding

    # _@return_ — in the order the window lists them
    attr_reader findings: ::Array[Finding]

    # One judgement on one thing.
    # @!attribute [r] severity
    #   @return [Symbol] `:ok`, `:note` (worth knowing, nothing broken), `:warning` (costs
    #     disk or memory until fixed), or `:skipped` (could not be checked)
    # @!attribute [r] subject
    #   @return [String] what it is about: `balloon`, `agent`, a disk's target, a mountpoint,
    #     `trim`, `guest`
    # @!attribute [r] text
    #   @return [String] the finding, e.g. `the host drops this disk's discards`
    # @!attribute [r] fix
    #   @return [String, nil] what to do about it: a command, or a Maintenance item
    # @!attribute [r] remedy
    #   @return [Symbol, nil] the fix as one virtui can run, for {UI::HealthDialog}'s button:
    #     `:grow_root` (Maintenance → Grow root filesystem), `:free_page_reporting`
    #     ({Virsh#enable_free_page_reporting}) or `:discard` ({Virsh#enable_discard} on the
    #     disk {#subject} names); `nil` when the fix is the user's to make.
    #     A Symbol, not a block: see design/decisions.md D_health_check
    class Finding < Data
      # _@param_ `severity` — see {#severity}
      # 
      # _@param_ `subject` — see {#subject}
      # 
      # _@param_ `text` — see {#text}
      # 
      # _@param_ `fix` — see {#fix}
      # 
      # _@param_ `remedy` — see {#remedy}
      def initialize: (
                        severity: Symbol,
                        subject: String,
                        text: String,
                        fix: String?,
                        ?remedy: Symbol?
                      ) -> void

      # _@return_ — `:ok`, `:note` (worth knowing, nothing broken), `:warning` (costs
      # disk or memory until fixed), or `:skipped` (could not be checked)
      attr_reader severity: Symbol

      # _@return_ — what it is about: `balloon`, `agent`, a disk's target, a mountpoint,
      # `trim`, `guest`
      attr_reader subject: String

      # _@return_ — the finding, e.g. `the host drops this disk's discards`
      attr_reader text: String

      # _@return_ — what to do about it: a command, or a Maintenance item
      attr_reader fix: String?

      # _@return_ — the fix as one virtui can run, for {UI::HealthDialog}'s button:
      # `:grow_root` (Maintenance → Grow root filesystem), `:free_page_reporting`
      # ({Virsh#enable_free_page_reporting}) or `:discard` ({Virsh#enable_discard} on the
      # disk {#subject} names); `nil` when the fix is the user's to make.
      # A Symbol, not a block: see design/decisions.md D_health_check
      attr_reader remedy: Symbol?
    end

    # The checks that read the guest, for one {.assess}.
    class GuestChecks
      # _@param_ `live`
      # 
      # _@param_ `guest`
      # 
      # _@param_ `read_file` — see {Health.assess}
      # 
      # _@param_ `file_exist` — see {Health.assess}
      def initialize: (
                        DomainConfig live,
                        GuestStorage guest,
                        untyped read_file,
                        untyped file_exist
                      ) -> void

      # _@return_ — the mapper, trim and free-space findings; one `:skipped`
      # finding instead if the guest stops answering midway
      def findings: () -> ::Array[Finding]

      # One finding per filesystem on device-mapper. A layer whose `discard_max_bytes` is 0
      # stops every discard from above; the lowest such layer is the one to fix, since an
      # LVM volume merely inherits the 0 from the LUKS mapping beneath it.
      def mappers: () -> ::Array[Finding]

      # Whether freed space is ever trimmed, judged only when some disk passes discards. Not
      # for Windows, which has neither file to read.
      def trim: () -> ::Array[Finding]

      def free_tails: () -> ::Array[Finding]

      # _@param_ `disks`
      # 
      # _@return_ — every filesystem mounted from them, once
      def filesystems: (?::Array[GuestStorage::Disk] disks) -> ::Array[GuestStorage::Filesystem]

      # `/proc/self/mounts` names a filesystem by `/dev/mapper/…` where guestinfo says `dm-1`,
      # so the mountpoint is the key; `\040` and friends are its octal escapes.
      # 
      # _@return_ — mountpoint → its options
      def mount_options: () -> ::Hash[String, ::Array[String]]
    end
  end

  # A disk image libvirt manages as a storage-pool volume — which is what lets virtui resize
  # it: libvirtd runs `qemu-img` as root on an image the user cannot even read.
  # 
  #   vol = virsh.volume('/var/lib/libvirt/images/vt-ubuntu.qcow2')
  #   vol.pool             # => "default"
  #   vol.capacity         # => 15032385536, what the guest sees
  #   virsh.resize_volume(vol.path, vol.capacity + 10.GiB)
  # 
  # @!attribute [r] path
  #   @return [String] the image file
  # @!attribute [r] pool
  #   @return [String] the storage pool it belongs to
  # @!attribute [r] capacity
  #   @return [Integer] bytes, the size the guest sees
  # @!attribute [r] allocation
  #   @return [Integer] bytes the image takes on the host; a sparse qcow2 takes far less
  # @!attribute [r] pool_available
  #   @return [Integer] bytes still free in the pool
  class Volume
    # _@return_ — the image file
    attr_reader path: String

    # _@return_ — the storage pool it belongs to
    attr_reader pool: String

    # _@return_ — bytes, the size the guest sees
    attr_reader capacity: Integer

    # _@return_ — bytes the image takes on the host; a sparse qcow2 takes far less
    attr_reader allocation: Integer

    # _@return_ — bytes still free in the pool
    attr_reader pool_available: Integer
  end

  # Static topology of the host CPU, as reported by libvirt.
  # 
  # @!attribute [r] model
  #   @return [String] CPU model/architecture, e.g. `"x86_64"`
  # @!attribute [r] sockets
  #   @return [Integer] number of physical CPU sockets
  # @!attribute [r] cores_per_socket
  #   @return [Integer] physical cores per socket
  # @!attribute [r] threads_per_core
  #   @return [Integer] hardware threads (e.g. hyperthreads) per core
  class CpuInfo
    # _@return_ — total logical CPUs (`sockets * cores_per_socket * threads_per_core`)
    def cpus: () -> Integer

    # _@return_ — `model: sockets/cores_per_socket/threads_per_core`, e.g. `"x86_64: 1/4/2"`
    def to_s: () -> String

    # _@return_ — CPU model/architecture, e.g. `"x86_64"`
    attr_reader model: String

    # _@return_ — number of physical CPU sockets
    attr_reader sockets: Integer

    # _@return_ — physical cores per socket
    attr_reader cores_per_socket: Integer

    # _@return_ — hardware threads (e.g. hyperthreads) per core
    attr_reader threads_per_core: Integer
  end

  # Which OS family a VM's libvirt definition *declares*, classified from its libosinfo id:
  # 
  #   os = GuestOS.from_osinfo_id('http://microsoft.com/win/11')
  #   os.family                                  # => :windows
  #   os.no_proc_meminfo?                        # => true — don't ask this guest for a swap level
  #   GuestOS.from_osinfo_id(nil)                # => UNKNOWN
  # 
  # A declaration, not an observation: available with the VM shut off and needing nothing
  # installed in the guest, but it says what the *creator* told libvirt. So it can be stale
  # (a definition made `--os-variant win10`, then used to install Linux) and it is absent
  # from a hand-written definition. Why this rather than asking `qemu-guest-agent` what is
  # actually booted: design/decisions.md D_guest_os_from_xml.
  # 
  # @!attribute [r] family
  #   @return [Symbol] one of {FAMILIES}' keys, or `:unknown` for both an id no vendor in
  #     {VENDORS} matches and a definition that declared nothing
  # @!attribute [r] osinfo_id
  #   @return [String, nil] what was declared, e.g. `http://microsoft.com/win/11`; `nil` if
  #     nothing was. Kept even when unrecognised, so a log line can name it
  class GuestOS
    FAMILIES: ::Hash[Symbol, ::Array[String]]
    VENDORS: ::Hash[String, Symbol]
    OSINFO_KEY: Regexp
    UNKNOWN: GuestOS

    # Classifies a declared osinfo id.
    # 
    #   GuestOS.from_osinfo_id('http://ubuntu.com/ubuntu/25.10')   # => linux
    #   GuestOS.from_osinfo_id('http://haiku-os.org/haiku/r1')     # => haiku
    #   GuestOS.from_osinfo_id('http://example.com/os/1')          # => unknown, id kept
    # 
    # _@param_ `osinfo_id` — the id from the domain's libosinfo metadata
    # 
    # _@return_ — `family` is `:unknown` for an id outside {VENDORS}, with `osinfo_id`
    # preserved so the caller can log what it saw
    def self.from_osinfo_id: (String? osinfo_id) -> GuestOS

    # _@return_ — whether this guest is declared Windows
    def windows?: () -> bool

    # _@return_ — whether this guest is declared Linux
    def linux?: () -> bool

    # _@return_ — whether this guest is declared FreeBSD
    def freebsd?: () -> bool

    # Whether asking this guest for `/proc/meminfo` is pointless — the gate on the
    # guest-agent swap read in {Cache#update}.
    # 
    # `!linux?`, so **`:unknown` skips the read** along with every other family: a domain
    # declaring no OS reports no swap level, where before this class existed it would have
    # been asked and answered. Deliberate, and the reason a `windows? || freebsd?` gate —
    # which lets `:unknown` fall through, and which every family added to {FAMILIES} would
    # have to be threaded into — was not taken; the trade is invisible on a fleet built by
    # virt-manager, where nothing is `:unknown`. See design/decisions.md D_guest_os_from_xml.
    # 
    # _@return_ — `true` for every family except `:linux`
    def no_proc_meminfo?: () -> bool

    # _@return_ — e.g. `"windows (http://microsoft.com/win/11)"`, or just the family
    # when nothing was declared
    def to_s: () -> String

    # _@return_ — one of {FAMILIES}' keys, or `:unknown` for both an id no vendor in
    # {VENDORS} matches and a definition that declared nothing
    attr_reader family: Symbol

    # _@return_ — what was declared, e.g. `http://microsoft.com/win/11`; `nil` if
    # nothing was. Kept even when unrecognised, so a log line can name it
    attr_reader osinfo_id: String?
  end

  # Statistics for a single VM disk device, as libvirt sees it from the host: the disk's
  # nominal size and what its image costs the host. How full the guest has filled it is the
  # guest's business, read separately ({Cache::VMCache#guest_fs_usage}).
  # 
  # @!attribute [r] name
  #   @return [String] the device name, e.g. `"vda"` or `"sda"`
  # @!attribute [r] capacity
  #   @return [Integer] nominal (maximum) size of the guest disk, in bytes
  # @!attribute [r] allocated
  #   @return [Integer] bytes the image's blocks occupy on the host, as `du` counts them —
  #     not the file's length, which a trimmed qcow2 overstates by its holes
  # @!attribute [r] path
  #   @return [String, nil] path to the image on the host
  class DiskStat
    # _@return_ — human-readable summary
    def to_s: () -> String

    # _@return_ — the device name, e.g. `"vda"` or `"sda"`
    attr_reader name: String

    # _@return_ — nominal (maximum) size of the guest disk, in bytes
    attr_reader capacity: Integer

    # _@return_ — bytes the image's blocks occupy on the host, as `du` counts them —
    # not the file's length, which a trimmed qcow2 overstates by its holes
    attr_reader allocated: Integer

    # _@return_ — path to the image on the host
    attr_reader path: String?
  end

  # Auto-scales the memory of every VM via libvirt ballooning, delegating per-VM decisions
  # to one {BallooningVM} each. Each VM must have ballooning support installed and enabled
  # (see README).
  # 
  # Reads from {Cache} and issues memory changes through it. UI-thread-confined.
  class Ballooning
    # _@param_ `virt_cache` — the runtime cache to read VM data from and act through
    # 
    # _@param_ `config` — handed to every {BallooningVM}
    def initialize: (Cache virt_cache, ?config: Config::Ballooning) -> void

    # Refreshes the per-VM ballooners from {Cache} (adding any new VMs), runs one control
    # step on each, then debug-logs the outcome. Call every ~2 seconds.
    def update: () -> void

    # Debug-logs the status of every running VM's ballooner.
    def log_statuses: () -> void

    # _@param_ `vm_name` — VM name
    # 
    # _@return_ — the VM's {BallooningVM#standing} decision, or `nil`
    # if the VM is unknown
    def standing: (String vm_name) -> BallooningVM::Status?

    # _@param_ `vm_name` — VM name
    # 
    # _@return_ — whether automatic ballooning is currently enabled for the VM
    # (`false` if the VM is unknown)
    def enabled?: (String vm_name) -> bool

    # Manually enables or disables automatic ballooning for one VM.
    # 
    # _@param_ `vm_name` — VM name
    # 
    # _@param_ `enabled` — `true` to enable, `false` to disable
    def enabled: (String vm_name, bool enabled) -> void

    # Flips the enabled state of one VM's ballooning.
    # 
    # _@param_ `vm_name` — VM name
    def toggle_enable: (String vm_name) -> void
  end

  # A point-in-time snapshot of one VM: its static {DomainInfo} plus the runtime state and
  # metrics sampled at {#sampled_at}.
  # 
  # Two snapshots are diffed to derive CPU usage (see {#cpu_usage}).
  # 
  # @!attribute [r] info
  #   @return [DomainInfo] static VM configuration
  # @!attribute [r] state
  #   @return [Symbol] one of `:running`, `:shut_off`, `:paused`, `:other`
  # @!attribute [r] sampled_at
  #   @return [Integer] milliseconds since the epoch when this snapshot was taken (see {.millis_now})
  # @!attribute [r] cpu_time
  #   @return [Integer] cumulative used CPU time (user + system) in milliseconds; diffed
  #     between snapshots to compute usage
  # @!attribute [r] mem_stat
  #   @return [MemoryStat, nil] memory stats; `nil` if the VM is not running
  # @!attribute [r] disk_stat
  #   @return [Array<DiskStat>] disk stats, one per connected disk
  class DomainData
    # _@return_ — true if the VM is running
    def running?: () -> bool

    # _@return_ — true if VM has proper ballooning support.
    def balloon?: () -> bool

    # _@return_ — now, represented as milliseconds since the epoch.
    def self.millis_now: () -> Integer

    # Average CPU usage over the interval between `older_data` and this snapshot, from the
    # delta of {#cpu_time} over the delta of {#sampled_at}.
    # 
    # Unlike {System::CpuUsage}, this is *per-core*: 100% means one virtual CPU core was
    # fully utilized over the interval, so a busy multi-core VM can exceed 100%.
    # 
    # _@param_ `older_data` — the earlier snapshot; returns `0.0` when `nil`
    # 
    # _@return_ — CPU usage in percent; `0.0` or greater, may exceed 100
    def cpu_usage: (DomainData? older_data) -> Float

    # _@return_ — human-readable summary; appends memory stats only when running
    def to_s: () -> String

    # _@return_ — static VM configuration
    attr_reader info: DomainInfo

    # _@return_ — one of `:running`, `:shut_off`, `:paused`, `:other`
    attr_reader state: Symbol

    # _@return_ — milliseconds since the epoch when this snapshot was taken (see {.millis_now})
    attr_reader sampled_at: Integer

    # _@return_ — cumulative used CPU time (user + system) in milliseconds; diffed
    # between snapshots to compute usage
    attr_reader cpu_time: Integer

    # _@return_ — memory stats; `nil` if the VM is not running
    attr_reader mem_stat: MemoryStat?

    # _@return_ — disk stats, one per connected disk
    attr_reader disk_stat: ::Array[DiskStat]
  end

  # Static VM configuration that doesn't change while the VM is running.
  # 
  # @!attribute [r] name
  #   @return [String] the VM name — used both for display and as the VM identifier
  # @!attribute [r] cpus
  #   @return [Integer] number of virtual CPUs allocated
  # @!attribute [r] max_memory
  #   @return [Integer] maximum memory allocated to the VM, in bytes; {MemoryStat}'s `actual`
  #     can never exceed this
  class DomainInfo
    # _@return_ — human-readable summary, e.g. `"web: CPUs: 4, RAM: 8G"`
    def to_s: () -> String

    # _@return_ — the VM name — used both for display and as the VM identifier
    attr_reader name: String

    # _@return_ — number of virtual CPUs allocated
    attr_reader cpus: Integer

    # _@return_ — maximum memory allocated to the VM, in bytes; {MemoryStat}'s `actual`
    # can never exceed this
    attr_reader max_memory: Integer
  end

  # Reads what only a guest itself knows — its swap *level* and how full its disks are — by
  # calling the QEMU guest agent (`qemu-guest-agent`) inside the VM via `virsh`:
  # 
  #   agent = GuestAgent.new(runner: VirshSession.new)
  #   agent.swap('Ubuntu')       # => #<ResourceUsage total=4GiB available=2.8GiB>
  #   agent.fs_usage('Ubuntu')   # => {"vda" => #<ResourceUsage 3.4G/15G (23%)>}
  #   agent.read_file('Ubuntu', '/proc/pressure/memory')   # the raw channel
  # 
  # `domstats` cannot answer this. Its `pswpin`/`pswpout` are counters that only ever climb,
  # so they give a rate and never a level (see {MemoryStat#swap_out}); the level lives in the
  # guest's own `/proc/meminfo`, and the agent is the only channel to it needing nothing
  # installed in the guest that `virt-manager` doesn't already put there.
  # 
  # Pair it with a {VirshSession}. One sample is three agent calls (open/read/close), each
  # ~13 ms of libvirtd+QMP+virtio-serial round-trip *plus* ~18 ms of process spawn on
  # {VirshSpawn} — that spawn, three times per VM per tick, is what makes the swap level a
  # session-only feature. See design/decisions.md D_guest_swap_level.
  # 
  # Stateless, and loud: every failure raises, sorted into {Unavailable} (a guest that was
  # never going to answer — the normal state of a host with agent-less guests) and everything
  # else (an agent that replied with something it does not document). Polling a fleet through
  # this wants {GuestSampler}, which turns the first kind into a blank gauge and stops
  # asking a guest that keeps failing.
  # 
  # Never on the UI thread: three RPCs against a sick guest is exactly the stall that must
  # never reach it. The tick polls through the session; a one-off read behind a progress
  # dialog goes through a {VirshSpawn} of its own ({Virsh#guest_storage}).
  class GuestAgent
    MEMINFO_PATH: String
    SYSRQ_PATH: String
    READ_BYTES: Integer
    TIMEOUT_SECONDS: Integer
    CHANNEL_STATE_XPATH: String
    MISSING_FILE: String
    EXPECTED_FAILURES: ::Array[String]

    # _@param_ `runner` — transport for the `qemu-agent-command` calls
    # 
    # _@param_ `timeout_seconds` — per-call agent timeout (see {TIMEOUT_SECONDS})
    def initialize: (runner: (VirshSession | VirshSpawn), ?timeout_seconds: Integer) -> void

    # The guest's swap occupancy, from its own `/proc/meminfo`.
    # 
    # A level, unlike {MemoryStat#swap_out}: it falls when the guest faults pages back in or
    # frees the slots, which is what makes it the figure saying what a ballooned guest is
    # paying *now*.
    # 
    # A guest with no swap device reports a `total` of 0 rather than nothing, since that is
    # what its `/proc/meminfo` says; only a failure to *read* is absent data, and that
    # raises.
    # 
    # _@param_ `domain` — VM name; must be running, or the agent call fails
    # 
    # _@return_ — `SwapTotal` with `SwapFree` available
    def swap: (String domain) -> ResourceUsage

    # The guest's `kernel.sysrq`: which magic SysRq functions a key press may trigger.
    # 
    #   agent.sysrq_mask('vt-ubuntu')   # => 176, Ubuntu's sync + remount + power-off
    # 
    # _@param_ `domain` — VM name; must be running, or the agent call fails
    # 
    # _@return_ — `0` none, `1` all, otherwise a bitmask (see {MagicSysRq.refusal})
    def sysrq_mask: (String domain) -> Integer

    # How full the guest has filled each of its disks, from its mounted filesystems.
    # 
    #   agent.fs_usage('vt-ubuntu')   # => {"vda" => #<ResourceUsage 3.4G/15G (23%)>}
    # 
    # `virsh guestinfo --filesystem`, libvirt's wrapper over `guest-get-fsinfo`, rather than
    # the raw agent command: only libvirt can say which host target (`vda`) a guest disk is.
    # It takes no `--timeout` and waits on a hung agent for as long as it hangs, so a
    # `guest-ping` that does goes first (design/research.md R_guestinfo).
    # 
    # _@param_ `domain` — VM name; must be running, or the call fails
    # 
    # _@return_ — see {GuestStorage.fs_usage}
    def fs_usage: (String domain) -> ::Hash[String, ResourceUsage]

    # Whether `qemu-ga` has the guest's end of the agent channel open, as libvirtd last saw it.
    # 
    #   agent.connected?('vt-ubuntu')   # => false while booting, true from the second qemu-ga is up
    # 
    # Answered by libvirtd from the live XML, never by the guest, so unlike every other read
    # here a wedged agent cannot stall it. See design/research.md R_domain_xml.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@return_ — `false` also for a domain that is not running or has no agent channel
    def connected?: (String domain) -> bool

    # Reads one file from inside the guest, in three agent calls: open, read, close.
    # 
    # Deliberately not `guest-exec`: reading a world-readable file needs neither remote root
    # exec nor a process spawned in the guest, and `guest-exec` is asynchronous — its reply
    # carries only a PID, so the output takes a second `guest-exec-status` round-trip that
    # cannot be issued until the guest process has exited. See design/decisions.md
    # D_guest_swap_level.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@param_ `path` — absolute path of the file, as the *guest* sees it
    # 
    # _@param_ `max_bytes` — how much to read in the single `guest-file-read`
    # 
    # _@return_ — the file's contents
    def read_file: (String domain, String path, ?max_bytes: Integer) -> String

    # Whether a file exists in the guest; a symlink counts when its target does.
    # 
    #   agent.exist?('vt-ubuntu', '/etc/systemd/system/timers.target.wants/fstrim.timer')   # => true
    # 
    # Where {#read_file} folds a missing file into {Unavailable}, this tells it apart from a
    # guest that cannot answer, which still raises.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@param_ `path` — absolute path, as the *guest* sees it
    # 
    # _@return_ — `false` only when the guest says the file is not there
    def exist?: (String domain, String path) -> bool

    # Closes a guest file handle, logging rather than raising if that fails.
    # 
    # `qemu-ga` holds an open handle until the guest reboots and caps how many it hands out,
    # so leaking one per poll eventually stops the reads altogether — hence the `ensure`.
    # Never raises: a failed close must not mask the read error already on its way out.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@param_ `handle` — the handle from `guest-file-open`
    def close_quietly: (String domain, Integer handle) -> void

    # Runs one guest-agent command and returns its `return` member.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@param_ `execute` — the agent command, e.g. `guest-file-open`
    # 
    # _@param_ `arguments` — its arguments, or `nil` for a command taking none
    # 
    # _@return_ — the reply's `return` member — an Integer handle, or a Hash
    def agent_command: (String domain, String execute, ?::Hash[untyped, untyped]? arguments) -> Object

    # _@param_ `domain` — VM name, for the error message
    # 
    # _@param_ `execute` — the agent command, for the error message
    # 
    # _@param_ `raw` — the reply as `virsh` printed it
    # 
    # _@return_ — the parsed reply
    def parse_reply: (String domain, String execute, String raw) -> ::Hash[String, Object]

    # Also classifies `virsh guestinfo`, which fails through the same agent ({Virsh#guest_storage}).
    # 
    # _@param_ `error` — the failure to classify
    # 
    # _@return_ — whether this is a failure a healthy host produces on its own (see
    # {EXPECTED_FAILURES}), and so belongs in an {Unavailable}
    def self.expected_failure?: (StandardError error) -> bool

    # Raised when this guest was never going to answer: no agent connected, the RPC blocked,
    # the domain gone, the file absent ({EXPECTED_FAILURES}). A normal state of a healthy
    # host, so a caller may treat it as "no data" — unlike every other error out of this
    # class, each of which means the agent replied with something it does not document.
    class Unavailable < StandardError
    end
  end

  # Memory statistics for a single VM, spanning both the host's view (`actual`, `rss`) and
  # the guest's own view (`available`, `usable`, `unused`, `disk_caches`, `swap_in`,
  # `swap_out`).
  # 
  # The guest-reported fields require a working balloon device plus guest tools; they are
  # `nil` when that data isn't available (see {#guest_data_available?}). More info:
  # https://pmhahn.github.io/virtio-balloon
  # 
  # Every field is a level except `swap_in`/`swap_out`, which are since-boot counters: diff
  # two samples to get anything usable out of them ({Cache::VMCache} does it).
  # 
  # @!attribute [r] actual
  #   @return [Integer] currently configured memory size given to the VM by the host, in bytes
  # @!attribute [r] unused
  #   @return [Integer, nil] truly unused memory (kernel `MemFree`): neither used by
  #     processes nor held as cache, in bytes. `nil` if ballooning is unavailable
  # @!attribute [r] available
  #   @return [Integer, nil] memory the guest OS sees as total (kernel `MemTotal`), in
  #     bytes — slightly less than `actual` since kernel/BIOS reserve some. `nil` if
  #     ballooning is unavailable
  # @!attribute [r] usable
  #   @return [Integer, nil] memory the guest can readily use (kernel `MemAvailable`):
  #     free space plus easily reclaimable caches, in bytes. `nil` if ballooning is unavailable
  # @!attribute [r] disk_caches
  #   @return [Integer, nil] guest disk cache size, in bytes. `nil` if ballooning is unavailable
  # @!attribute [r] swap_in
  #   @return [Integer, nil] bytes the guest has read *back* from swap since boot (its
  #     `pswpin` counter); `nil` if not reported. Rising means the guest is healing, so
  #     this is not a harm signal — see {Cache::VMCache#swap_out_rate}
  # @!attribute [r] swap_out
  #   @return [Integer, nil] bytes the guest has written *to* swap since boot (its
  #     `pswpout` counter); `nil` if not reported. I/O counted, not memory occupied — it
  #     never falls when swap slots are freed, so the swap *level* can't be derived from
  #     it; only its rate is meaningful (see {Cache::VMCache#swap_out_rate})
  # @!attribute [r] rss
  #   @return [Integer] resident set size of the QEMU process on the host, in bytes — pages
  #     actually touched so far (QEMU allocates on demand, so this grows over the VM's life)
  # @!attribute [r] last_updated
  #   @return [Integer] epoch seconds when these values were fetched from the VM; stops
  #     advancing unless collection is armed (see {Virsh#set_mem_stats_period})
  class MemoryStat
    # _@return_ — the guest memory stats or nil if unavailable.
    def guest_mem: () -> ResourceUsage?

    # _@return_ — the host memory stat: `rss` of `actual`
    def host_mem: () -> ResourceUsage

    # Returns true if the guest memory data is available. false if the VM doesn't report guest data,
    # probably because ballooning service isn't running, or virt guest tools aren't installed,
    # or the VM lacks the ballooning device.
    # 
    # _@return_ — true if the guest data is available
    def guest_data_available?: () -> bool

    # Deliberately separate from {#guest_data_available?}: the balloon driver reports these
    # two only if the guest kernel has `CONFIG_VM_EVENT_COUNTERS`, so folding them in there
    # would stop ballooning entirely on a guest that reports everything else.
    # 
    # _@return_ — true if {#swap_in} and {#swap_out} are present
    def swap_data_available?: () -> bool

    # _@return_ — human-readable summary; includes guest detail only when available
    def to_s: () -> String

    # _@return_ — currently configured memory size given to the VM by the host, in bytes
    attr_reader actual: Integer

    # _@return_ — truly unused memory (kernel `MemFree`): neither used by
    # processes nor held as cache, in bytes. `nil` if ballooning is unavailable
    attr_reader unused: Integer?

    # _@return_ — memory the guest OS sees as total (kernel `MemTotal`), in
    # bytes — slightly less than `actual` since kernel/BIOS reserve some. `nil` if
    # ballooning is unavailable
    attr_reader available: Integer?

    # _@return_ — memory the guest can readily use (kernel `MemAvailable`):
    # free space plus easily reclaimable caches, in bytes. `nil` if ballooning is unavailable
    attr_reader usable: Integer?

    # _@return_ — guest disk cache size, in bytes. `nil` if ballooning is unavailable
    attr_reader disk_caches: Integer?

    # _@return_ — bytes the guest has read *back* from swap since boot (its
    # `pswpin` counter); `nil` if not reported. Rising means the guest is healing, so
    # this is not a harm signal — see {Cache::VMCache#swap_out_rate}
    attr_reader swap_in: Integer?

    # _@return_ — bytes the guest has written *to* swap since boot (its
    # `pswpout` counter); `nil` if not reported. I/O counted, not memory occupied — it
    # never falls when swap slots are freed, so the swap *level* can't be derived from
    # it; only its rate is meaningful (see {Cache::VMCache#swap_out_rate})
    attr_reader swap_out: Integer?

    # _@return_ — resident set size of the QEMU process on the host, in bytes — pages
    # actually touched so far (QEMU allocates on demand, so this grows over the VM's life)
    attr_reader rss: Integer

    # _@return_ — epoch seconds when these values were fetched from the VM; stops
    # advancing unless collection is armed (see {Virsh#set_mem_stats_period})
    attr_reader last_updated: Integer
  end

  # The plain `virsh` transport: one process per command. Every mutating command goes
  # through it whatever the app's read transport is, and reads fall back to it when a
  # {VirshSession} has degraded — or when `bin/virtui` is edited to run one of these
  # instead of a session.
  # 
  #   runner = VirshSpawn.new
  #   runner.query('domstats')                  # => "Domain: 'vm1'\n  state.state=1\n…"
  #   runner.sync('setmem', vm_name, '262144')  # => "" — raises if virsh fails
  #   runner.async('start', vm_name)            # => Thread; failures logged, not raised
  # 
  # One argument per word, never a pre-joined string: that is what keeps a VM named
  # `it's` from needing an escaping layer (see {Run}). The word `virsh` is never among
  # them. {VirshSession} serves the same three methods from a persistent REPL, which is
  # why {#query} is spelled separately from {#sync} even though they are identical here:
  # it marks the calls a session is allowed to serve, so switching transport moves the
  # read path and nothing else.
  # 
  # Every command runs under `-q`, which is what makes the two transports return the same
  # bytes: without it `virsh` appends a blank line that an interactive session does not.
  class VirshSpawn
    # A read whose stdout the caller parses. Identical to {#sync} in this transport; see
    # {VirshSession#query} for the one where it differs.
    # 
    # _@param_ `args` — a `virsh` subcommand and its arguments, one per element
    # 
    # _@return_ — the command's stdout
    def query: (*::Array[String] args) -> String

    # _@param_ `args` — a `virsh` subcommand and its arguments, one per element
    # 
    # _@return_ — the command's stdout
    def sync: (*::Array[String] args) -> String

    # Runs a command without waiting for it, for the ones too slow to block on
    # (`virsh start` takes ~800ms).
    # 
    # _@param_ `args` — a `virsh` subcommand and its arguments, one per element
    # 
    # _@return_ — the thread running the command (see {Run.async})
    def async: (*::Array[String] args) -> Thread

    # Releases nothing — this transport holds no state. Present so a caller can close
    # whichever runner it holds without testing its type.
    def close: () -> void
  end

  # An in-memory fleet of simulated VMs, API-compatible with {Virsh}, for demo/test mode
  # without libvirt. Each VM is a {VMEmulator::VM}; see {.demo} for a ready-made fleet.
  class VMEmulator
    LINUX: GuestOS
    WINDOWS: GuestOS
    DISK_CAPACITY: Integer
    EFI_START: Integer
    EFI_SIZE: Integer
    POOL_AVAILABLE: Integer

    # _@param_ `hostinfo` — the host CPU topology to report
    def initialize: (?hostinfo: CpuInfo) -> void

    # Adds a VM to the fleet.
    # 
    # _@param_ `vm` — the VM to add
    # 
    # _@return_ — the same VM
    def add: (VMEmulator::VM vm) -> VMEmulator::VM

    # _@param_ `name` — VM name
    # 
    # _@return_ — the VM, or `nil` if no such VM exists
    def vm: (String name) -> VMEmulator::VM?

    # Deletes the VM with the given name.
    # 
    # _@param_ `name` — VM name
    # 
    # _@return_ — the deleted VM, or `nil` if none existed
    def delete: (String name) -> VMEmulator::VM?

    # _@return_ — a snapshot of every VM, keyed by name
    def domain_data: () -> ::Hash[String, DomainData]

    # _@param_ `name` — VM name
    # 
    # _@return_ — the simulated guest's swap level (see {VMEmulator::VM#swap}),
    # or `nil` for an unknown, stopped, or agent-less VM
    def guest_swap: (String name) -> ResourceUsage?

    # _@param_ `name` — VM name
    # 
    # _@return_ — the simulated VM's address (see {VMEmulator::VM#ip_address}), or
    # `nil` for an unknown or stopped VM
    def ip_address: (String name) -> String?

    # _@param_ `name` — VM name
    # 
    # _@return_ — the simulated guest's {VMEmulator::VM#sysrq_mask}, or `nil` for an
    # unknown or stopped VM
    def guest_sysrq_mask: (String name) -> Integer?

    # What the VM declares — {LINUX} unless its {VMEmulator::VM#guest_os} was set. Mirrors
    # {Virsh#guest_os} so {Cache} can call it backend-agnostically, including the part where
    # a domain that declares nothing answers {GuestOS::UNKNOWN} rather than `nil`.
    # 
    # _@param_ `name` — VM name
    # 
    # _@return_ — the declaration; {GuestOS::UNKNOWN} for an unknown VM
    def guest_os: (String name) -> GuestOS

    # A small definition built from the simulated VM and run through the same
    # {DomainConfig.from_xml} as {Virsh#domain_config}, so demo mode exercises the parser.
    # 
    # Its declared OS chooses the rest: Windows gets UEFI, Secure Boot and a TPM, Linux gets
    # UEFI, and an undeclared OS gets BIOS and no agent channel.
    # 
    # _@param_ `name` — VM name
    def domain_config: (String name) -> DomainConfig

    # Mirrors {Virsh#autostart?}.
    # 
    # _@param_ `name` — VM name
    # 
    # _@return_ — the VM's {VMEmulator::VM#autostart}
    def autostart?: (String name) -> bool

    # The guest's disk layout, run through the same {GuestStorage.parse} as
    # {Virsh#guest_storage}. A Linux guest is the easy case: an EFI partition, then `/` as the
    # last partition, 100 GiB until {#grow_root} grows it, with the rest of the disk after it —
    # 28 GiB until {#resize_volume} grows the disk. A Windows guest reports one
    # `C:\` volume and no partitions, as its agent does.
    # 
    # _@param_ `name` — VM name
    def guest_storage: (String name) -> GuestStorage

    # Mirrors {Virsh#guest_fs_usage}, through the same {GuestStorage.fs_usage}.
    # 
    # _@param_ `name` — VM name
    # 
    # _@return_ — `nil` for an unknown, stopped, or
    # agent-less VM (see {#guest_storage})
    def guest_fs_usage: (String name) -> ::Hash[String, ResourceUsage]?

    # Mirrors {Virsh#volume}: every simulated VM's image is in the `default` pool.
    # 
    # _@param_ `path` — the image, as {VMEmulator::VM#disk_path} names it
    # 
    # _@return_ — `nil` for a path no simulated VM has
    def volume: (String path) -> Volume?

    # Mirrors {Virsh#resize_volume}, refusing what libvirt refuses.
    # 
    # _@param_ `path` — the image (see {#volume})
    # 
    # _@param_ `capacity` — the new size, in bytes
    def resize_volume: (String path, Integer capacity) -> void

    # Mirrors {Virsh#root_grow_plan}, through the same {GuestRootGrow.plan}; a simulated guest's
    # agent always runs commands, and its disk is GPT.
    # 
    # _@param_ `name` — VM name
    def root_grow_plan: (String name) -> GuestRootGrow::Plan

    # Mirrors {Virsh#health}, through the same {Health.assess}. A simulated guest has
    # `fstrim.timer` enabled and no device-mapper layers, so no other guest file is read.
    # 
    # _@param_ `name` — VM name
    def health: (String name) -> Health

    # Mirrors {Virsh#enable_free_page_reporting}, which a simulated VM takes at once: it has
    # no inactive definition to wait in.
    # 
    # _@param_ `name` — VM name
    def enable_free_page_reporting: (String name) -> void

    # Mirrors {Virsh#enable_discard}, which a simulated VM takes at once, as
    # {#enable_free_page_reporting} does.
    # 
    # _@param_ `name` — VM name
    # 
    # _@param_ `target` — the disk's target; a simulated VM has only `vda`
    def enable_discard: (String name, String target) -> void

    # Mirrors {Virsh#virt_xml_available?}: the demo needs no `virt-xml`.
    # 
    # _@return_ — `true`
    def virt_xml_available?: () -> bool

    # Mirrors {Virsh#grow_root}: the root partition takes the rest of the disk.
    # 
    # _@param_ `name` — VM name
    # 
    # _@param_ `plan` — from {#root_grow_plan}
    def grow_root: (String name, GuestRootGrow::Plan plan) -> void

    # Sets a VM's current memory, unless {#allow_set_actual} is `false`.
    # 
    # _@param_ `vmid` — VM name
    # 
    # _@param_ `actual` — new memory size, in bytes
    def set_actual: (String vmid, Integer actual) -> void

    # No-op: the emulator always reports fresh stats, so there's no collection period to
    # arm. Mirrors {Virsh#set_mem_stats_period} so {Cache} can call it backend-agnostically.
    # 
    # _@param_ `vmid` — VM name
    # 
    # _@param_ `period_seconds` — ignored
    def set_mem_stats_period: (String vmid, Integer period_seconds) -> void

    # No-op: the emulator's guests always answer, so there is no failure state to forget.
    # Mirrors {Virsh#forget_guest} so {Cache} can call it backend-agnostically.
    # 
    # _@param_ `name` — VM name
    def forget_guest: (String name) -> void

    # No-op, for the reason {#forget_guest} gives. Mirrors {Virsh#revive_guest}.
    # 
    # _@param_ `name` — VM name
    def revive_guest: (String name) -> void

    # Builds a ready-made demo fleet: BASE (shut off), Ubuntu (running), win11 (running),
    # Fedora (shut off). Three OS declarations between them, so the guest-OS marker has a
    # penguin, a window and an undeclared `?` to draw.
    # 
    # _@return_ — a {Virsh}-compatible emulator pre-populated with four VMs
    def self.demo: () -> VMEmulator

    # Starts a stopped VM.
    # 
    # _@param_ `vm` — VM name
    def start: (String vm) -> void

    # Shuts down a VM gracefully - basically asks the VM to shut off.
    # 
    # _@param_ `vm` — VM name
    def shutdown: (String vm) -> void

    # Asks the VM to reboot itself gracefully.
    # 
    # _@param_ `domain_name` — VM name
    def reboot: (String domain_name) -> void

    # Resets the VM forcefully.
    # 
    # _@param_ `domain_name` — VM name
    def reset: (String domain_name) -> void

    # Forces the VM off.
    # 
    # _@param_ `domain_name` — VM name
    def force_off: (String domain_name) -> void

    # Mirrors {Virsh#sysrq_power_off}, at once: a simulated guest has no dirty pages to sync.
    # 
    # _@param_ `domain_name` — VM name
    def sysrq_power_off: (String domain_name) -> void

    # Mirrors {Virsh#sysrq_reboot}, at once.
    # 
    # _@param_ `domain_name` — VM name
    def sysrq_reboot: (String domain_name) -> void

    # _@param_ `vm` — a running VM that declares an OS
    # 
    # _@return_ — what `virsh -q guestinfo --filesystem --disk` would print for it
    def guestinfo: (VMEmulator::VM vm) -> String

    # _@return_ — the simulated host CPU topology
    attr_reader hostinfo: CpuInfo

    # _@return_ — whether {#set_actual} is honored; set `false` to simulate a host
    # that rejects memory changes (for debugging)
    attr_accessor allow_set_actual: bool

    # A single simulated VM. When started, its guest-app memory usage slowly ramps up to
    # `started_initial_apps` (via an {Interpolator}), and `disk_caches` sits around 1 GiB.
    # Memory figures are recomputed on demand by {#to_mem_stat}.
    class VM
      MIN_APP_MEMORY: Integer
      BIOS_KERNEL: Integer
      MIN_ACTUAL: Integer

      # Creates a VM (initially shut off).
      # 
      # _@param_ `info` — static VM configuration
      # 
      # _@param_ `initial_actual` — {MemoryStat}'s `actual` when the VM is started, in bytes
      # 
      # _@param_ `started_initial_apps` — guest-app memory the VM ramps to after start, in bytes; change it later via {#memory_app=}
      def initialize: (DomainInfo info, Integer initial_actual, Integer started_initial_apps) -> void

      # Convenience constructor: a 1-CPU VM whose initial app usage is half of `actual`.
      # 
      # _@param_ `name` — VM name
      # 
      # _@param_ `actual` — initial {MemoryStat} `actual`, in bytes
      # 
      # _@param_ `max_actual` — the VM's maximum memory, in bytes (defaults to a large multiple of `actual`)
      # 
      # _@return_ — the new VM
      def self.simple: (String name, ?actual: Integer, ?max_actual: Integer) -> VM

      # _@return_ — the VM name
      def name: () -> String

      # _@return_ — where its disk image would live, in libvirt's `default` pool
      def disk_path: () -> String

      # _@return_ — {#address} while running, as {Virsh#ip_address} would report it;
      # `nil` when stopped
      def ip_address: () -> String?

      # The guest's cumulative swap-out counter: {#swap_out_rate} integrated over the time
      # it has been set, restarting from 0 on every {#start} — which is what a real guest's
      # per-boot `pswpout` does.
      # 
      # _@return_ — bytes written to swap since {#start}, or 0 when not running
      def swap_out_total: () -> Integer

      # The simulated guest's swap occupancy, as {Virt::GuestSampler#swap} would report it.
      # 
      #   vm.swap.to_s   # => "1.2G/4G (30%)"
      # 
      # Everything written out, capped by the device: the emulator never faults pages back in
      # (its `swap_in` stays 0), so written-out is parked.
      # 
      # _@return_ — swap used out of {#swap_total}; `nil` when not running,
      # or when {#swap_total} is `nil`
      def swap: () -> ResourceUsage?

      # _@return_ — whether the VM is currently running (or still within its
      # shutdown grace period)
      def running?: () -> bool

      # "Starts" this VM: app memory begins ramping up to {#started_initial_apps}.
      def start: () -> void

      # _@return_ — uptime in seconds, or `nil` if shut down
      def uptime: () -> Float?

      # Initiates a graceful shutdown: app memory ramps down to zero over the grace period.
      def shut_down: () -> void

      # Forces the VM off immediately, with no shutdown grace period.
      def force_off: () -> void

      # Hard power-cycle: {#force_off} then {#start}.
      def force_reboot: () -> void

      # Sets the guest-app memory usage to a fixed value (overriding the ramp).
      # 
      # _@param_ `apps` — app memory usage, in bytes
      def memory_app=: (Integer apps) -> void

      def check_running: () -> void

      # Sets the configured (`actual`) memory; increases apply instantly, decreases ramp
      # down over a few seconds to mimic a real guest.
      # 
      # _@param_ `actual` — new `actual` memory, in bytes; clamped between {MIN_ACTUAL} and the VM's {DomainInfo}'s `max_memory`
      def memory_actual=: (Integer actual) -> void

      # The `virsh dumpxml` this VM would print; see {VMEmulator#domain_config} for what it
      # declares. Read from a {UI::BackgroundTask}'s worker while the tick may be changing
      # the VM; a torn read costs one stale detail in a snapshot, so nothing locks.
      # 
      # _@return_ — a `<domain>` definition
      def to_domain_xml: () -> String

      # Computes the VM's current {MemoryStat} from its simulated state.
      # 
      # _@return_ — the current memory stats, or `nil` if the VM is not running
      def to_mem_stat: () -> MemoryStat?

      # _@return_ — bytes per second the simulated guest writes to swap; 0 (the
      # default) is a guest with a swap device it isn't touching
      attr_accessor swap_out_rate: Integer

      # _@return_ — what this simulated VM's definition declares ({VMEmulator::LINUX} by
      # default, matching the guest that answers `/proc/meminfo` in {#swap}); set it to
      # {VMEmulator::WINDOWS} or {GuestOS::UNKNOWN} to simulate a guest {Cache} won't ask
      attr_accessor guest_os: GuestOS

      # _@return_ — bytes, the capacity of its one disk `vda`; {VMEmulator#resize_volume}
      # grows it
      attr_accessor disk_capacity: Integer

      # _@return_ — bytes, the guest's root partition, the last on {#disk_capacity};
      # {VMEmulator#grow_root} grows it
      attr_accessor root_size: Integer

      # _@return_ — its disk's `<driver discard=>`: `unmap` by default, `nil` for a
      # VM whose health check warns that the host drops its discards
      attr_accessor discard: String?

      # _@return_ — whether its balloon reports free pages: `true` by default, `false`
      # for a VM whose health check offers to turn it on
      attr_accessor free_page_reporting: bool

      # _@return_ — its guest's `kernel.sysrq`: Ubuntu's 176 by default, `nil` for a
      # guest whose agent cannot be asked
      attr_accessor sysrq_mask: Integer?

      # _@return_ — whether libvirt would start it with the host; `false` by default
      attr_accessor autostart: bool

      # _@return_ — the address this simulated VM holds while running; `nil` (the
      # default) simulates a guest the host has no address for
      attr_accessor address: String?

      # _@return_ — size of the simulated guest's swap device (4 GiB by default);
      # `nil` simulates a guest whose level cannot be read at all — no guest agent, or no
      # swap configured — which is the other half {Virt::GuestSampler#swap} can return
      attr_accessor swap_total: Integer?

      # _@return_ — static VM configuration
      attr_reader info: DomainInfo

      # _@return_ — guest-app memory the VM ramps to after start, in bytes; change it
      # via {#memory_app=}
      attr_reader started_initial_apps: Integer
    end
  end

  # Ends a running Linux guest the way a stuck console would: Alt+SysRq S, U, then O or B,
  # typed into its emulated keyboard through `virsh send-key`. Softer than `virsh destroy` —
  # the guest's dirty pages reach the disk and its filesystems are left clean — and still
  # works when the guest's own shutdown hangs, where an ACPI shutdown waits forever:
  # 
  #   MagicSysRq.refusal(cache.guest_os, cache.sysrq_mask)   # => nil when the guest allows it
  #   MagicSysRq.new(runner: VirshSpawn.new).power_off('vt-ubuntu')
  # 
  # Nothing in the guest answers a key, so each step is given {STEP_SECONDS} and the result is
  # judged by the domain's state alone. See design/decisions.md D_sysrq_power_off.
  # 
  # Never on the UI thread: a power-off takes {STEP_SECONDS} twice, then up to {OFF_SECONDS}.
  class MagicSysRq
    NEEDED_BITS: Integer
    STEP_SECONDS: Integer
    OFF_SECONDS: Integer

    # Why the sequence would do nothing to this guest.
    # 
    #   MagicSysRq.refusal(GuestOS::UNKNOWN, nil)   # => "not a Linux guest"
    #   MagicSysRq.refusal(linux, 16)                # => "the guest's kernel.sysrq = 16 allows no remount or power-off"
    # 
    # _@param_ `guest_os` — what the domain declares
    # 
    # _@param_ `mask` — the guest's `kernel.sysrq`, or `nil` if it was never read
    # 
    # _@return_ — the reason, or `nil` if S, U and O/B all reach the guest's kernel
    def self.refusal: (GuestOS guest_os, Integer? mask) -> String?

    # _@param_ `runner` — transport; every call here spawns ({VirshSession#sync})
    # 
    # _@param_ `step_seconds` — see {STEP_SECONDS}; lowered by the specs
    # 
    # _@param_ `off_seconds` — see {OFF_SECONDS}; lowered by the specs
    def initialize: (runner: (VirshSpawn | VirshSession), ?step_seconds: (Integer | Float), ?off_seconds: (Integer | Float)) -> void

    # Syncs, remounts read-only and powers the guest off, then waits for the domain to stop.
    # 
    # _@param_ `domain` — a running Linux VM whose mask allows it (see {.refusal})
    def power_off: (String domain) -> void

    # Syncs, remounts read-only and reboots the guest. Unchecked: a rebooted domain stays
    # `running`, so its state cannot tell whether B arrived.
    # 
    # _@param_ `domain` — a running Linux VM whose mask allows it (see {.refusal})
    def reboot: (String domain) -> void

    # _@param_ `domain`
    def sync_and_remount: (String domain) -> void

    # _@param_ `domain`
    # 
    # _@param_ `key` — the Linux keycode name after Alt+SysRq, e.g. `KEY_S`
    def send_key: (String domain, String key) -> void
  end

  # Auto-scales the memory of a single VM by polling a set of *inputs* and acting on what
  # they say. Call {#update} every ~2s.
  # 
  # == The inputs
  # 
  # Each input is a small object under `lib/virt/ballooning_vm/`, fed this tick's
  # {Cache::VMCache} via `observe` and asked one question, which it answers with a `String`
  # reason or `nil` for "no opinion". There are two kinds:
  # 
  # - a **voter** (`vote_reason`) asks for a change — {MemLevelRaiseVoter},
  #   {SwapOutRaiseVoter} on the raise side, {MemLevelShrinkVoter} on the lower side;
  # - a **vetoer** (`veto_reason`) blocks one — {SwapOutShrinkVetoer},
  #   {BackOffShrinkVetoer}, both against lowering.
  # 
  # The division of labour: **an input decides *whether* and says *why*; this class decides
  # *how much*.** So every threshold lives on the input that reads it and every rate lives
  # here, and a new consideration arrives as another class in one of the lists rather than
  # as another branch in {#update}.
  # 
  # == The rules
  # 
  # 1. Any raise vote wins outright — a VM that needs RAM needs it now, and nothing vetoes
  #    a raise.
  # 2. Otherwise a lower needs a voter for it *and* no vetoer against it.
  # 3. Otherwise nothing happens.
  # 
  # Asymmetric on purpose, and rule 1 is where the asymmetry lives: raises are immediate and
  # unopposed, lowering is voted, vetoable and rate-limited.
  # 
  # Does nothing at all if the VM lacks ballooning support, is shut off, reports stale data,
  # or the user has disabled it. Memory never drops below {#floor} nor rises above the
  # VM's configured maximum. `README.md` states the resulting behaviour for users.
  # 
  # UI-thread-confined.
  class BallooningVM
    # _@param_ `virt_cache` — the runtime cache to read VM data from and act through
    # 
    # _@param_ `vmid` — the VM name
    # 
    # _@param_ `config` — the triggers and the floor
    def initialize: (Cache virt_cache, String vmid, ?config: Config::Ballooning) -> void

    # The lowest `actual` this VM is ever shrunk to: {#min_actual}, or half the VM's configured
    # maximum if that is less. Not {#min_actual} alone: a VM configured with less than it would
    # never be ballooned at all. QEMU's own overhead means the guest OS sees somewhat less.
    # 
    # _@param_ `max_memory` — the VM's configured maximum, in bytes
    # 
    # _@return_ — the floor, in bytes
    def floor: (Integer max_memory) -> Integer

    # The decision that stands for this VM, which is what the VM pane shows: the latest one
    # on fresh guest data, except that a raise or a lower stays up for 10s.
    # 
    # A change outranks `:fine` and `:backing_off` but nothing else. The back-off is the
    # change's own aftermath: let it in and "lowered to 1.8G" gives way to "holding 9s"
    # on the very next sample. A guest veto, a cap or the VM stopping is news, and wins.
    def standing: () -> Status

    # _@return_ — true if automatic ballooning is enabled.
    def enabled?: () -> bool

    # _@return_ — if the VM was running during the last ballooning update
    def was_running?: () -> bool

    # Enables or disables automatic ballooning for this VM. Clears the back-off so the
    # user's manual change takes effect on the next {#update}.
    # 
    # _@param_ `enabled` — `true` to enable, `false` to disable
    def enabled=: (bool enabled) -> void

    # Runs one control step: feeds every input this tick's data, applies the rules above,
    # and records what happened in {#status} and {#standing}. Info-logs every raise and
    # lower, and every turn into `:holding`, `:at_floor` or `:at_max`, with the full
    # {Status#text}; the rest of the ticks only reach the debug log, through {Ballooning}.
    def update: () -> void

    # {#update} short of the bookkeeping {#standing} reads.
    def step: () -> void

    # Polls the inputs, applies the three rules and carries out whatever they call for.
    # 
    # _@param_ `mem_stat` — this tick's guest memory stats
    def decide: (MemoryStat mem_stat) -> void

    # Applies one change of `memory_delta` percent, or explains why it can't be applied.
    # 
    # _@param_ `mem_stat` — this tick's guest memory stats
    # 
    # _@param_ `memory_delta` — percentage change: positive raises, negative lowers
    # 
    # _@param_ `report` — what the guest reported, for the status line
    # 
    # _@param_ `voters` — the voters asking for the change
    def resize: (
                  MemoryStat mem_stat,
                  Integer memory_delta,
                  String report,
                  ::Array[untyped] voters
                ) -> void

    # Forgets everything observed about a VM we are no longer steering — it is stopped, or
    # the user switched ballooning off. Its guest's counters reset with it, so nothing seen
    # before applies to the next boot.
    def reset: () -> void

    # _@return_ — floor for the `actual` memory of a VM configured with at least twice
    # this, in bytes; a smaller VM floors at half its maximum instead ({#floor})
    attr_accessor min_actual: Integer

    # _@return_ — this tick's decision, as it happened
    attr_reader status: Status

    # The outcome of one ballooning {#update} for a VM, in three lengths:
    # 
    #   status.kind    # => :raised
    #   status.brief   # => "raised to 2.6G: 65% used"
    #   status.text    # => "VM reports 1.2G (65%), raising memory by 30% to 2.6G: usage is at or over the 65% trigger"
    # 
    # @!attribute [r] kind
    #   @return [Symbol] one of {KINDS}
    # @!attribute [r] text
    #   @return [String] the full decision and every reason behind it, for the log
    # @!attribute [r] brief
    #   @return [String] the VM pane header's words; `''` for a kind the pane already shows
    #     another way, or that needs no words
    # @!attribute [r] memory_delta
    #   @return [Integer] percentage change applied: `0` for no change, positive for an
    #     increase, negative for a decrease
    class Status
      KINDS: ::Array[Symbol]

      # _@param_ `kind` — one of {KINDS}
      # 
      # _@param_ `text` — see {#text}
      # 
      # _@param_ `brief` — see {#brief}
      # 
      # _@param_ `memory_delta` — see {#memory_delta}
      def initialize: (
                        kind: Symbol,
                        text: String,
                        ?brief: String,
                        ?memory_delta: Integer
                      ) -> void

      # _@return_ — `text; d=memory_delta`
      def to_s: () -> String

      # _@return_ — one of {KINDS}
      attr_reader kind: Symbol

      # _@return_ — the full decision and every reason behind it, for the log
      attr_reader text: String

      # _@return_ — the VM pane header's words; `''` for a kind the pane already shows
      # another way, or that needs no words
      attr_reader brief: String

      # _@return_ — percentage change applied: `0` for no change, positive for an
      # increase, negative for a decrease
      attr_reader memory_delta: Integer
    end

    # Votes to raise a VM's memory while its guest is writing pages to swap — memory it
    # wanted and did not have. One of {BallooningVM}'s inputs, not a decision-maker: it
    # answers {#vote_reason}, and {BallooningVM#update} decides how much memory that is
    # worth.
    # 
    # Exists because a swapping guest cannot ask for memory through the figure
    # {BallooningVM} steers by: evicting anon pages *raises* `MemAvailable`, so the usage
    # figure falls exactly when the guest is suffering, and a guest can swap gigabytes
    # without it ever reaching the trigger. See design/decisions.md D_swap_raise_vote.
    # 
    # Independent of {SwapOutShrinkVetoer}, though both read the same counter, because they
    # ask different questions of it. The veto asks *has this guest swapped recently* and so
    # outlives the swapping by a minute; a vote to raise must ask *is it swapping now*,
    # since a hop per sample for a minute after the burst would multiply a VM several times
    # over in answer to something already finished. Each owns its own noise floor for the
    # same reason — a floor high enough to ignore a guest that trickles to swap benignly is
    # high enough to blind this vote to a real burst.
    # 
    # UI-thread-confined, like its owner.
    class SwapOutRaiseVoter
      def initialize: () -> void

      # Records one tick's rate. Unlike {SwapOutShrinkVetoer#observe} this needs no
      # once-per-guest-sample guard: it holds no timer to re-arm, and the rate a repeated
      # sample carries forward is the right answer to "is it swapping now" until a fresher
      # one lands. One hop per guest sample is {BallooningVM#update}'s own guard.
      # 
      # _@param_ `vm_cache` — this tick's cache entry for the VM, or `nil` if the VM is unknown
      def observe: (Cache::VMCache? vm_cache) -> void

      # _@return_ — why this VM's memory should be raised right now, phrased to
      # follow a comma: `"the guest is swapping out 20M/s"`. `nil` when the guest is not
      # swapping — the common case
      def vote_reason: () -> String?

      # _@return_ — {#vote_reason} short enough for the VM pane's header:
      # `"swapping out 20M/s"`
      def brief: () -> String?

      # Drops what was observed, for a VM we are no longer watching (stopped, or ballooning
      # switched off). The guest's counters reset with it.
      def forget: () -> void
    end

    # Votes to raise a VM's memory once the guest's own usage figure reaches a trigger. The
    # oldest of {BallooningVM}'s inputs and the only one that reads the guest's memory
    # *level* rather than a derived rate.
    # 
    # Its blind spot is why the others exist: `percent_used` is
    # `(MemTotal - MemAvailable) / MemTotal`, and evicting anon pages to swap *raises*
    # `MemAvailable`, so a guest under real pressure can hold this figure still — or push it
    # down — while it pays disk I/O for the memory it lacks. See {SwapOutRaiseVoter}.
    # 
    # UI-thread-confined, like its owner.
    class MemLevelRaiseVoter
      # _@param_ `trigger_at` — guest memory use, omitting cache, in percent, at or above which this votes to raise: {Config::Ballooning#raise_at_percent}, whose `validate` keeps it above {MemLevelShrinkVoter}'s
      def initialize: (trigger_at: Integer) -> void

      # _@param_ `vm_cache` — this tick's cache entry for the VM, or `nil` if the VM is unknown
      def observe: (Cache::VMCache? vm_cache) -> void

      # _@return_ — why this VM's memory should be raised, phrased to follow a
      # colon; `nil` when the guest is comfortable
      def vote_reason: () -> String?

      # _@return_ — {#vote_reason} short enough for the VM pane's header:
      # `"70% used"`
      def brief: () -> String?

      def forget: () -> void
    end

    # Vetoes lowering a VM's memory for a while after {BallooningVM} last touched it, or
    # after it started. The one input that observes nothing about the guest: it is
    # {BallooningVM}'s memory of *its own* actions, which is why it is the only one with a
    # method the framework calls to arm it.
    # 
    # Asymmetric on purpose, and the asymmetry is the whole point of the class: raises
    # ignore it entirely, because a VM that needs RAM needs it whatever we did a second ago,
    # while a VM with RAM to spare can give it back at leisure.
    # 
    # UI-thread-confined, like its owner.
    class BackOffShrinkVetoer
      def initialize: () -> void

      # Vetoes lowering for `seconds` from now — extending an active veto, never cutting one
      # short ({Cooldown#extended_by}).
      # 
      # _@param_ `seconds` — how long to stay off this VM
      def arm: (Numeric seconds) -> void

      # Nothing about the guest bears on this one; it is here so the framework can feed
      # every input the same way.
      # 
      # _@param_ `_vm_cache` — ignored
      def observe: (Cache::VMCache? _vm_cache) -> void

      # _@return_ — why this VM's memory must not be lowered right now, phrased to
      # follow a colon; `nil` once the back-off lapses
      def veto_reason: () -> String?

      # _@return_ — {#veto_reason} short enough for the VM pane's header:
      # `"holding 9s: settling"`
      def brief: () -> String?

      # Drops the veto, so the next tick may lower memory at once. Called when the user
      # changes the ballooning setting by hand — they want to see the effect now.
      def forget: () -> void
    end

    # Votes to lower a VM's memory once the guest's own usage figure drops to a trigger —
    # the counterpart to {MemLevelRaiseVoter}, and the only voter that ever gives memory
    # back to the host.
    # 
    # A vote is not a decision: this one is routinely overruled, because a comfortable
    # *reading* and a comfortable guest are not the same thing. {SwapOutShrinkVetoer} exists
    # for the case where the comfort is an artefact of the guest having just swapped.
    # 
    # UI-thread-confined, like its owner.
    class MemLevelShrinkVoter
      # _@param_ `trigger_at` — guest memory use, omitting cache, in percent, at or below which this votes to lower: {Config::Ballooning#shrink_at_percent}
      def initialize: (trigger_at: Integer) -> void

      # _@param_ `vm_cache` — this tick's cache entry for the VM, or `nil` if the VM is unknown
      def observe: (Cache::VMCache? vm_cache) -> void

      # _@return_ — why this VM's memory should be lowered, phrased to follow a
      # colon; `nil` while the guest is using enough of it
      def vote_reason: () -> String?

      # _@return_ — {#vote_reason} short enough for the VM pane's header:
      # `"41% used"`
      def brief: () -> String?

      def forget: () -> void
    end

    # Vetoes memory *decreases* for a VM whose guest was recently seen writing to swap.
    # One of {BallooningVM}'s inputs, not a decision-maker: it answers {#veto_reason} and
    # {BallooningVM#update} decides what to do with the answer.
    # 
    # Exists because swapping is invisible to the figure {BallooningVM} steers by. Evicting
    # anon pages *raises* `MemAvailable`, so a guest paying disk I/O for the memory it lacks
    # reads as one with memory to spare — and gets shrunk. See design/decisions.md
    # D_swap_shrink_veto for why the veto keys on the swap-out *rate* rather than on how
    # full the guest's swap device is, and why it outlives the swapping by a minute.
    # 
    # Stateful across calls: feed it every guest sample via {#observe}, in order.
    # UI-thread-confined, like its owner.
    class SwapOutShrinkVetoer
      def initialize: () -> void

      # Records one tick's evidence, re-arming the veto if this sample caught the guest
      # writing to swap. A no-op for a sample already seen — libvirt refreshes balloon data
      # every ~5s while we poll every ~2s, so most polls re-see the previous sample and must
      # not extend the veto — and for a guest whose balloon reports no swap counters
      # (see {MemoryStat#swap_data_available?}), which therefore balloons unaffected.
      # 
      # Call on every tick, before any decision is taken: the veto's clock has to advance on
      # each sample, not only on the ticks whose decision reaches the shrink branch.
      # 
      # _@param_ `vm_cache` — this tick's cache entry for the VM, or `nil` if the VM is unknown
      def observe: (Cache::VMCache? vm_cache) -> void

      # _@return_ — why this VM's memory must not be decreased right now, phrased
      # to follow a "but": `"the guest swapped recently; holding its memory for 58.3s"`.
      # `nil` when there is no objection — the common case
      def veto_reason: () -> String?

      # _@return_ — {#veto_reason} short enough for the VM pane's header:
      # `"holding 59s: the guest swapped"`
      def brief: () -> String?

      # Drops the veto and the sample it was armed from, for a VM we are no longer watching
      # (stopped, or ballooning switched off). The guest's counters reset with it, so
      # nothing observed before applies to the next boot.
      def forget: () -> void
    end
  end

  # What a domain is *defined* as: the static facts of its `virsh dumpxml`, parsed.
  # 
  #   config = DomainConfig.from_xml(File.read('spec/virt/dumpxml_vt-ubuntu.xml'))
  #   config.firmware                 # => :uefi
  #   config.disks.first.source       # => "/var/lib/libvirt/images/vt-ubuntu.qcow2"
  #   config.balloon.free_page_reporting   # => true
  # 
  # Values (bytes, symbols, paths, libvirt's own model names), never display strings; how
  # they look is {UI::VMInfoDialog}'s business.
  # 
  # A running domain's XML is the *live* one, with assigned ports and the agent channel's
  # state; a shut-off domain's is the persistent one, with neither. What libvirt prints in
  # each: design/research.md R_domain_xml.
  # 
  # @!attribute [r] name
  #   @return [String]
  # @!attribute [r] running
  #   @return [Boolean] whether this is a running domain's live XML: only that carries
  #     `<domain id=>`
  # @!attribute [r] uuid
  #   @return [String]
  # @!attribute [r] hypervisor
  #   @return [String] `<domain type=>`: `kvm`, or `qemu` for pure emulation
  # @!attribute [r] arch
  #   @return [String] e.g. `x86_64`
  # @!attribute [r] machine
  #   @return [String] the QEMU machine type, e.g. `pc-q35-10.2`
  # @!attribute [r] guest_os
  #   @return [GuestOS] the libosinfo declaration in `<metadata>`, read fresh, where
  #     {Cache::VMCache#guest_os} was read once at startup
  # @!attribute [r] vcpus
  #   @return [Integer] the maximum vCPU count
  # @!attribute [r] vcpus_online
  #   @return [Integer] the vCPUs present at boot (`<vcpu current=>`); equals {#vcpus} unless
  #     the domain is set up for vCPU hotplug
  # @!attribute [r] cpu_mode
  #   @return [String, nil] `host-passthrough`, `host-model` or `custom`; `nil` with no `<cpu>`
  # @!attribute [r] cpu_model
  #   @return [String, nil] the named CPU model of a `custom` mode, e.g. `Skylake-Client`
  # @!attribute [r] topology
  #   @return [Topology, nil] `nil` when the definition leaves it to libvirt
  # @!attribute [r] max_memory
  #   @return [Integer] `<memory>`, in bytes: the balloon's ceiling, the same figure as
  #     {DomainInfo#max_memory}
  # @!attribute [r] memory_backing
  #   @return [Array<String>] what `<memoryBacking>` asks for: `hugepages`, the source type
  #     (`memfd`, `file`), the access mode (`shared`), `locked`; empty when absent
  # @!attribute [r] balloon
  #   @return [Balloon, nil] `nil` with no balloon device, which virtui cannot resize
  # @!attribute [r] agent
  #   @return [Symbol, nil] the `qemu-guest-agent` channel: `:connected` or `:disconnected` in
  #     a running domain's live XML, `:unknown` in a shut-off one's; `nil` with no channel
  # @!attribute [r] firmware
  #   @return [Symbol] `:uefi` or `:bios`
  # @!attribute [r] secure_boot
  #   @return [Boolean]
  # @!attribute [r] loader
  #   @return [String, nil] the firmware image, as an explicit `<loader>` names it
  # @!attribute [r] nvram
  #   @return [String, nil] the UEFI variable store
  # @!attribute [r] boot
  #   @return [Array<String>] the boot order: `<os><boot dev=>` (`hd`, `cdrom`, `network`)
  #     or, failing that, the devices that carry a `<boot order=>` (a disk's target, else the
  #     element name such as `interface`); empty when neither is there
  # @!attribute [r] tpm
  #   @return [Tpm, nil]
  # @!attribute [r] disks
  #   @return [Array<Disk>] in document order
  # @!attribute [r] filesystems
  #   @return [Array<Filesystem>] host directories shared into the guest
  # @!attribute [r] interfaces
  #   @return [Array<Interface>]
  # @!attribute [r] graphics
  #   @return [Array<Graphics>]
  # @!attribute [r] video
  #   @return [Array<String>] each video adapter's model, e.g. `virtio`, `qxl`, `vga`
  # @!attribute [r] hostdevs
  #   @return [Array<Hostdev>] host devices passed through
  # @!attribute [r] other_devices
  #   @return [Array<String>] the remaining devices worth naming, as element and model, e.g.
  #     `rng virtio`, `watchdog itco`, `sound ich9`, `redirdev spicevmc`; one entry per device
  class DomainConfig
    AGENT_CHANNEL: String
    OTHER_DEVICES: ::Array[String]

    # Parses a domain definition.
    # 
    # _@param_ `xml` — what `virsh dumpxml` printed
    def self.from_xml: (String xml) -> DomainConfig

    # _@param_ `domain`
    def self.guest_os: (REXML::Element domain) -> GuestOS

    # _@param_ `element` — a size element, such as `<memory unit='KiB'>`
    # 
    # _@return_ — bytes
    def self.kib: (REXML::Element element) -> Integer

    # _@param_ `element`
    def self.topology: (REXML::Element? element) -> Topology?

    # _@param_ `element` — `<memoryBacking>`
    def self.memory_backing: (REXML::Element? element) -> ::Array[String]

    # _@param_ `element` — `<memballoon>`
    def self.balloon: (REXML::Element? element) -> Balloon?

    # _@param_ `devices`
    def self.agent: (REXML::Element devices) -> Symbol?

    # Both spellings count: `<os firmware='efi'>` auto-selects, `<loader type='pflash'>`
    # names the image; libvirt expands the first into the second, but only once it has
    # picked one.
    # 
    # _@param_ `os`
    def self.uefi?: (REXML::Element os) -> bool

    # _@param_ `os`
    def self.secure_boot?: (REXML::Element os) -> bool

    # _@param_ `os`
    # 
    # _@param_ `devices`
    def self.boot: (REXML::Element os, REXML::Element devices) -> ::Array[String]

    # _@param_ `element` — `<tpm>`
    def self.tpm: (REXML::Element? element) -> Tpm?

    # _@param_ `element` — `<disk>`
    def self.disk: (REXML::Element element) -> Disk

    # _@param_ `disk_type` — `<disk type=>`
    # 
    # _@param_ `source` — `<disk><source>`
    def self.disk_source: (String disk_type, REXML::Element? source) -> String?

    # _@param_ `element` — `<filesystem>`
    def self.filesystem: (REXML::Element element) -> Filesystem

    # _@param_ `element` — `<interface>`
    def self.interface: (REXML::Element element) -> Interface

    # _@param_ `element` — `<graphics>`
    def self.graphics: (REXML::Element element) -> Graphics

    # _@param_ `element` — `<hostdev>`
    def self.hostdev: (REXML::Element element) -> Hostdev

    # _@param_ `devices`
    def self.other_devices: (REXML::Element devices) -> ::Array[String]

    attr_reader name: String

    # _@return_ — whether this is a running domain's live XML: only that carries
    # `<domain id=>`
    attr_reader running: bool

    attr_reader uuid: String

    # _@return_ — `<domain type=>`: `kvm`, or `qemu` for pure emulation
    attr_reader hypervisor: String

    # _@return_ — e.g. `x86_64`
    attr_reader arch: String

    # _@return_ — the QEMU machine type, e.g. `pc-q35-10.2`
    attr_reader machine: String

    # _@return_ — the libosinfo declaration in `<metadata>`, read fresh, where
    # {Cache::VMCache#guest_os} was read once at startup
    attr_reader guest_os: GuestOS

    # _@return_ — the maximum vCPU count
    attr_reader vcpus: Integer

    # _@return_ — the vCPUs present at boot (`<vcpu current=>`); equals {#vcpus} unless
    # the domain is set up for vCPU hotplug
    attr_reader vcpus_online: Integer

    # _@return_ — `host-passthrough`, `host-model` or `custom`; `nil` with no `<cpu>`
    attr_reader cpu_mode: String?

    # _@return_ — the named CPU model of a `custom` mode, e.g. `Skylake-Client`
    attr_reader cpu_model: String?

    # _@return_ — `nil` when the definition leaves it to libvirt
    attr_reader topology: Topology?

    # _@return_ — `<memory>`, in bytes: the balloon's ceiling, the same figure as
    # {DomainInfo#max_memory}
    attr_reader max_memory: Integer

    # _@return_ — what `<memoryBacking>` asks for: `hugepages`, the source type
    # (`memfd`, `file`), the access mode (`shared`), `locked`; empty when absent
    attr_reader memory_backing: ::Array[String]

    # _@return_ — `nil` with no balloon device, which virtui cannot resize
    attr_reader balloon: Balloon?

    # _@return_ — the `qemu-guest-agent` channel: `:connected` or `:disconnected` in
    # a running domain's live XML, `:unknown` in a shut-off one's; `nil` with no channel
    attr_reader agent: Symbol?

    # _@return_ — `:uefi` or `:bios`
    attr_reader firmware: Symbol

    attr_reader secure_boot: bool

    # _@return_ — the firmware image, as an explicit `<loader>` names it
    attr_reader loader: String?

    # _@return_ — the UEFI variable store
    attr_reader nvram: String?

    # _@return_ — the boot order: `<os><boot dev=>` (`hd`, `cdrom`, `network`)
    # or, failing that, the devices that carry a `<boot order=>` (a disk's target, else the
    # element name such as `interface`); empty when neither is there
    attr_reader boot: ::Array[String]

    attr_reader tpm: Tpm?

    # _@return_ — in document order
    attr_reader disks: ::Array[Disk]

    # _@return_ — host directories shared into the guest
    attr_reader filesystems: ::Array[Filesystem]

    attr_reader interfaces: ::Array[Interface]

    attr_reader graphics: ::Array[Graphics]

    # _@return_ — each video adapter's model, e.g. `virtio`, `qxl`, `vga`
    attr_reader video: ::Array[String]

    # _@return_ — host devices passed through
    attr_reader hostdevs: ::Array[Hostdev]

    # _@return_ — the remaining devices worth naming, as element and model, e.g.
    # `rng virtio`, `watchdog itco`, `sound ich9`, `redirdev spicevmc`; one entry per device
    attr_reader other_devices: ::Array[String]

    # `<cpu><topology>`.
    class Topology < Data
      # Returns the value of attribute sockets
      attr_reader sockets: Object

      # Returns the value of attribute cores
      attr_reader cores: Object

      # Returns the value of attribute threads
      attr_reader threads: Object
    end

    # `<memballoon>`.
    # @!attribute [r] model
    #   @return [String] e.g. `virtio`
    # @!attribute [r] autodeflate
    #   @return [Boolean] whether the guest may deflate the balloon itself when it runs out of memory
    # @!attribute [r] free_page_reporting
    #   @return [Boolean] whether the guest hands its free pages back to the host
    class Balloon < Data
      # _@return_ — e.g. `virtio`
      attr_reader model: String

      # _@return_ — whether the guest may deflate the balloon itself when it runs out of memory
      attr_reader autodeflate: bool

      # _@return_ — whether the guest hands its free pages back to the host
      attr_reader free_page_reporting: bool
    end

    # `<tpm>`.
    # @!attribute [r] model
    #   @return [String] e.g. `tpm-crb`, `tpm-tis`
    # @!attribute [r] backend
    #   @return [String] `emulator` or `passthrough`
    # @!attribute [r] version
    #   @return [String, nil] e.g. `2.0`
    class Tpm < Data
      # _@return_ — e.g. `tpm-crb`, `tpm-tis`
      attr_reader model: String

      # _@return_ — `emulator` or `passthrough`
      attr_reader backend: String

      # _@return_ — e.g. `2.0`
      attr_reader version: String?
    end

    # One `<disk>`.
    # @!attribute [r] target
    #   @return [String] the guest device name, e.g. `vda`; joins {DiskStat#name}
    # @!attribute [r] bus
    #   @return [String] e.g. `virtio`, `sata`, `scsi`
    # @!attribute [r] device
    #   @return [String] `disk`, `cdrom`, `floppy` or `lun`
    # @!attribute [r] type
    #   @return [String] where the data lives: `file`, `block`, `volume`, `network` or `dir`
    # @!attribute [r] format
    #   @return [String, nil] the image format, e.g. `qcow2`, `raw`
    # @!attribute [r] source
    #   @return [String, nil] a path for `file`, `block` and `dir`, `pool/volume` for `volume`,
    #     `protocol://host:port/name` for `network`; `nil` for an empty CD-ROM drive
    # @!attribute [r] shareable
    #   @return [Boolean] whether other domains may attach the same image
    # @!attribute [r] readonly
    #   @return [Boolean]
    # @!attribute [r] discard
    #   @return [String, nil] `<driver discard=>`: `unmap` passes the guest's trims to the image,
    #     `ignore` or `nil` drops them, though the guest is told it may discard either way
    #     (design/research.md R_discard_reclaim)
    class Disk < Data
      # _@return_ — the guest device name, e.g. `vda`; joins {DiskStat#name}
      attr_reader target: String

      # _@return_ — e.g. `virtio`, `sata`, `scsi`
      attr_reader bus: String

      # _@return_ — `disk`, `cdrom`, `floppy` or `lun`
      attr_reader device: String

      # _@return_ — where the data lives: `file`, `block`, `volume`, `network` or `dir`
      attr_reader type: String

      # _@return_ — the image format, e.g. `qcow2`, `raw`
      attr_reader format: String?

      # _@return_ — a path for `file`, `block` and `dir`, `pool/volume` for `volume`,
      # `protocol://host:port/name` for `network`; `nil` for an empty CD-ROM drive
      attr_reader source: String?

      # _@return_ — whether other domains may attach the same image
      attr_reader shareable: bool

      attr_reader readonly: bool

      # _@return_ — `<driver discard=>`: `unmap` passes the guest's trims to the image,
      # `ignore` or `nil` drops them, though the guest is told it may discard either way
      # (design/research.md R_discard_reclaim)
      attr_reader discard: String?
    end

    # One `<filesystem>`: a host directory shared into the guest.
    # @!attribute [r] driver
    #   @return [String] `virtiofs` or `9p`
    # @!attribute [r] source
    #   @return [String] the host directory
    # @!attribute [r] tag
    #   @return [String] the mount tag the guest mounts it by
    class Filesystem < Data
      # _@return_ — `virtiofs` or `9p`
      attr_reader driver: String

      # _@return_ — the host directory
      attr_reader source: String

      # _@return_ — the mount tag the guest mounts it by
      attr_reader tag: String
    end

    # One `<interface>`.
    # @!attribute [r] type
    #   @return [String] e.g. `network`, `bridge`, `direct`, `user`
    # @!attribute [r] source
    #   @return [String, nil] the libvirt network, the bridge, or `dev (mode)` for `direct`
    # @!attribute [r] model
    #   @return [String, nil] e.g. `virtio`, `e1000e`
    # @!attribute [r] mac
    #   @return [String, nil]
    class Interface < Data
      # _@return_ — e.g. `network`, `bridge`, `direct`, `user`
      attr_reader type: String

      # _@return_ — the libvirt network, the bridge, or `dev (mode)` for `direct`
      attr_reader source: String?

      # _@return_ — e.g. `virtio`, `e1000e`
      attr_reader model: String?

      attr_reader mac: String?
    end

    # One `<graphics>`.
    # @!attribute [r] type
    #   @return [String] e.g. `spice`, `vnc`
    # @!attribute [r] listen
    #   @return [String, nil] the address it listens on
    # @!attribute [r] port
    #   @return [Integer, nil] `nil` until libvirt assigns an autoport, so for a shut-off domain
    class Graphics < Data
      # _@return_ — e.g. `spice`, `vnc`
      attr_reader type: String

      # _@return_ — the address it listens on
      attr_reader listen: String?

      # _@return_ — `nil` until libvirt assigns an autoport, so for a shut-off domain
      attr_reader port: Integer?
    end

    # One `<hostdev>`.
    # @!attribute [r] type
    #   @return [String] `pci`, `usb`, `scsi` or `mdev`
    # @!attribute [r] id
    #   @return [String, nil] `0000:01:00.0` for PCI, `vendor:product` (or `bus N device M`)
    #     for USB; `nil` for the other types
    class Hostdev < Data
      # _@return_ — `pci`, `usb`, `scsi` or `mdev`
      attr_reader type: String

      # _@return_ — `0000:01:00.0` for PCI, `vendor:product` (or `bus N device M`)
      # for USB; `nil` for the other types
      attr_reader id: String?
    end
  end

  # Samples what a guest reports through its agent — its swap level, how full its disks are,
  # its SysRq mask — and stops asking a guest that cannot answer:
  # 
  #   sampler = GuestSampler.new(agent: GuestAgent.new(runner: session))
  #   sampler.swap('Ubuntu')       # => #<ResourceUsage total=4GiB available=2.8GiB>, or nil
  #   sampler.fs_usage('Ubuntu')   # => {"vda" => #<ResourceUsage 3.4G/15G (23%)>}, or nil
  #   sampler.sysrq_mask('Ubuntu') # => 176, or nil
  #   sampler.revive('Ubuntu')     # every tick: its agent just connected, so ask again now
  #   sampler.forget('Ubuntu')     # it stopped running; its strikes must not greet the next boot
  # 
  # An enhancement, never a dependency: every failure answers `nil`, because a guest with no
  # agent — or with `guest-file-*` among the agent's `BLOCK_RPCS`, as RHEL/Fedora ship it —
  # is a normal state, not an internal error. This is the one read path in the project that
  # swallows; the {GuestAgent} underneath raises loudly, and a caller wanting the failure
  # rather than a blank gauge asks it directly — deliberately not a decorator over it, see
  # design/decisions.md D_swap_sampler_split.
  # 
  # == Implementation details
  # 
  # Each read keeps its own strikes, since one can be blocked while the other answers (the
  # RHEL agent refuses the swap level's `guest-file-*`, not `guest-get-fsinfo`). A read that
  # keeps failing is written off and then probed once a minute (see
  # {FAILURES_BEFORE_BACKOFF}); a failed poll costs up to {GuestAgent::TIMEOUT_SECONDS} of
  # the timer thread, so a guest that cannot answer has to stop being asked. A write-off
  # made while the agent was down ends early, when {#revive} sees it connect.
  # 
  # A {GuestAgent::Unavailable} — the failure a healthy host produces on its own — stays at
  # `debug`, since every VM start passes through one while `qemu-ga` comes up; anything else
  # says so once, at `warn`, so a misconfigured agent is not swallowed with the rest. See
  # design/decisions.md D_guest_agent_backoff.
  # 
  # Timer-thread-confined: the strike counts are unguarded, and the sample under them is
  # RPCs against a guest that may be sick — exactly the stall that must never reach the UI
  # thread.
  class GuestSampler
    FAILURES_BEFORE_BACKOFF: Integer
    BACKOFF_SECONDS: Integer

    # _@param_ `agent` — the channel each sample is read through
    # 
    # _@param_ `backoff_seconds` — how long a written-off read is skipped for (see {BACKOFF_SECONDS}); lowered by the specs, which would otherwise have to wait a minute to watch a write-off lapse
    def initialize: (agent: GuestAgent, ?backoff_seconds: (Integer | Float)) -> void

    # _@param_ `domain` — VM name; must be running, or the agent call fails
    # 
    # _@return_ — the guest's swap level (see {GuestAgent#swap}), or `nil`
    # if it cannot answer — no agent, a blocked RPC, an undocumented reply, or the read is
    # currently written off (see {FAILURES_BEFORE_BACKOFF})
    def swap: (String domain) -> ResourceUsage?

    # _@param_ `domain` — VM name; must be running, or the agent call fails
    # 
    # _@return_ — how full each disk is (see
    # {GuestAgent#fs_usage}), or `nil` for the reasons {#swap} gives
    def fs_usage: (String domain) -> ::Hash[String, ResourceUsage]?

    # _@param_ `domain` — VM name; must be running, or the agent call fails
    # 
    # _@return_ — the guest's `kernel.sysrq` (see {GuestAgent#sysrq_mask}), or `nil`
    # for the reasons {#swap} gives
    def sysrq_mask: (String domain) -> Integer?

    # Forgets a guest's strike counts and any write-off, so its next samples start clean.
    # 
    # Call it when a VM leaves the running state: the agent goes down before libvirt calls
    # the domain stopped, so a shutdown otherwise burns strikes that greet the next boot. A
    # guest-induced *reboot* never leaves the running state; {#revive} covers that one.
    # 
    # _@param_ `domain` — VM name
    def forget: (String domain) -> void

    # Lifts a guest's write-offs the moment its agent connects, so a booting or rebooting
    # guest is read on the next tick instead of after {BACKOFF_SECONDS}.
    # 
    # Call it every tick for every running VM, after its samples. Only a disconnected →
    # connected edge lifts: an agent connected at the write-off is wedged or refusing the
    # RPC, and waits out its time. Costs one libvirtd read per tick while a written-off
    # guest's agent stays down, and none otherwise. See design/decisions.md D_guest_agent_backoff.
    # 
    # _@param_ `domain` — VM name
    def revive: (String domain) -> void

    # One sample of one read, or `nil` if it could not be had.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@param_ `read` — what is sampled, for the strike key and the log, e.g. `swap level`
    # 
    # _@return_ — the block's answer, or `nil` if it raised or is written off
    def sample: (String domain, String read) ?{ () -> Object } -> Object?

    # A lapsed write-off simply answers `false` and the next call goes through. Note what is
    # *not* touched: the strike count, which is what makes a still-mute guest re-arm on that
    # single probe instead of spending three (see {FAILURES_BEFORE_BACKOFF}).
    # 
    # _@param_ `key` — the domain and the read
    # 
    # _@return_ — whether this read is currently written off
    def backing_off?: ([String, String] key) -> bool

    # Records one failed sample, writing the read off on the {FAILURES_BEFORE_BACKOFF}th.
    # 
    # _@param_ `key` — the domain and the read
    # 
    # _@param_ `error` — why the sample failed
    def note_failure: ([String, String] key, StandardError error) -> void
  end

  # How a running guest has laid out its disks — the partitions on each and what is mounted
  # where — as the guest itself reports it through `qemu-guest-agent`:
  # 
  #   vda = virsh.guest_storage('vt-ubuntu').disk('vda')
  #   vda.partitions.map(&:name)                         # => ["vda13", "vda14", "vda15", "vda1"]
  #   vda.partitions.last.filesystems.first.mountpoint   # => "/"
  #   vda.free_tail                                      # => 2147500032 after a 2 GiB image grow
  # 
  # Two sources. `virsh guestinfo --filesystem --disk` names every guest block device, which
  # are partitions of which, and every mounted filesystem with its usage — and, crucially,
  # maps each guest disk to its host target (`vda`), which equal names do not promise: the
  # guest kernel names disks by probe order. What it lacks is geometry, read from guest
  # files: one `/proc/partitions` for every size, one `/sys/class/block/<part>/start` per
  # partition (design/research.md R_guestinfo, design/decisions.md D_guest_storage). Those
  # reads happen only for `/dev/…` partitions, so a guest without Linux device names is asked
  # for no Linux file.
  # 
  # Values in bytes, never display strings; how they look is {UI::VMInfoDialog}'s business.
  # 
  # @!attribute [r] disks
  #   @return [Array<Disk>] the guest's whole disks that map to a host target, in guestinfo's order
  class GuestStorage
    SECTOR: Integer
    MIN_FREE_TAIL: Integer

    # _@param_ `target` — a host target, e.g. `vda`
    # 
    # _@return_ — the guest disk behind it, or `nil` if the guest reported none
    def disk: (String target) -> Disk?

    # Parses `virsh guestinfo --filesystem --disk`, reading the partition geometry it lacks
    # through the block.
    # 
    # _@param_ `guestinfo` — `virsh -q guestinfo <vm> --filesystem --disk` output
    def self.parse: (String guestinfo) ?{ (String path) -> String } -> GuestStorage

    # How full the guest has filled each host disk: its mounted filesystems summed per target.
    # 
    #   GuestStorage.fs_usage(`virsh -q guestinfo vt-ubuntu --filesystem`)
    #   # => {"vda" => #<ResourceUsage 3.4G/15G (23%)>}   /, /boot and /boot/efi together
    # 
    # A target with nothing mounted (swap, a seed ISO, an unformatted disk) is absent, and so
    # is a filesystem the agent could not stat. One spanning two disks (LVM, btrfs) counts
    # whole on each.
    # 
    # _@param_ `guestinfo` — `virsh -q guestinfo <vm> --filesystem` output; `--disk` may be there too
    # 
    # _@return_ — keyed by host target, e.g. `vda`
    def self.fs_usage: (String guestinfo) -> ::Hash[String, ResourceUsage]

    # _@param_ `guestinfo` — `virsh guestinfo` output
    # 
    # _@return_ — its `key : value` lines
    def self.values: (String guestinfo) -> ::Hash[String, String]

    # _@param_ `values` — from {.values}
    # 
    # _@return_ — every `disk.N`, see {.device}
    def self.devices: (::Hash[String, String] values) -> ::Array[::Hash[Symbol, Object]]

    # _@param_ `values`
    # 
    # _@param_ `key` — e.g. `disk.4`
    # 
    # _@return_ — `:name`, `:partition`, `:dependencies`, `:alias`, and
    # `:guest_alias`, a device-mapper device's own name
    def self.device: (::Hash[String, String] values, String key) -> ::Hash[Symbol, Object]

    # One triple per (filesystem, disk it lives on): a btrfs spanning two disks appears twice.
    # 
    # _@param_ `values`
    # 
    # _@param_ `devices` — from {.device}
    # 
    # _@return_ — the guest device, the host target, the filesystem
    def self.filesystems: (::Hash[String, String] values, ::Array[::Hash[Symbol, Object]] devices) -> ::Array[[String, String, Filesystem]]

    # Follows each `dm-*` down its one dependency until the chain leaves device-mapper
    # (design/research.md R_guestinfo).
    # 
    # _@param_ `name` — the filesystem's `fs.N.name`, e.g. `dm-1`
    # 
    # _@param_ `devices` — from {.device}
    def self.mappers: (String? name, ::Array[::Hash[Symbol, Object]] devices) -> ::Array[Mapper]

    # _@param_ `partitions` — guest partition devices, e.g. `/dev/vda1`
    # 
    # _@return_ — `:size` per `/dev/…` device in
    # `/proc/partitions`, whole disks included, and `:start` per partition
    def self.geometry: (::Array[String] partitions) -> ::Hash[String, ::Hash[Symbol, Integer]]

    # _@return_ — the guest's whole disks that map to a host target, in guestinfo's order
    attr_reader disks: ::Array[Disk]

    # One whole disk of the guest.
    # @!attribute [r] target
    #   @return [String] the host's name for it, e.g. `vda`; joins {DomainConfig::Disk#target}
    # @!attribute [r] device
    #   @return [String] the guest's name for it, e.g. `/dev/vda`
    # @!attribute [r] size
    #   @return [Integer, nil] bytes, as the guest sees it; `nil` when its geometry was not read
    # @!attribute [r] partitions
    #   @return [Array<Partition>] in disk order (by start), not by number
    # @!attribute [r] filesystems
    #   @return [Array<Filesystem>] mounted on the disk but on none of {#partitions}: a
    #     filesystem on the whole disk, or a Windows volume
    class Disk
      # _@return_ — bytes between the end of the last partition and the end of
      # the disk — what growing the last partition would add; `nil` with no partitions or
      # no geometry
      def free_tail: () -> Integer?

      # _@return_ — the host's name for it, e.g. `vda`; joins {DomainConfig::Disk#target}
      attr_reader target: String

      # _@return_ — the guest's name for it, e.g. `/dev/vda`
      attr_reader device: String

      # _@return_ — bytes, as the guest sees it; `nil` when its geometry was not read
      attr_reader size: Integer?

      # _@return_ — in disk order (by start), not by number
      attr_reader partitions: ::Array[Partition]

      # _@return_ — mounted on the disk but on none of {#partitions}: a
      # filesystem on the whole disk, or a Windows volume
      attr_reader filesystems: ::Array[Filesystem]
    end

    # One partition of a {Disk}.
    # @!attribute [r] device
    #   @return [String] e.g. `/dev/vda1`
    # @!attribute [r] start
    #   @return [Integer, nil] its offset from the start of the disk, in bytes
    # @!attribute [r] size
    #   @return [Integer, nil] bytes; rounded down to a KiB, as `/proc/partitions` counts
    # @!attribute [r] filesystems
    #   @return [Array<Filesystem>] mounted from it: one, or several on an LVM physical volume
    class Partition
      # _@return_ — e.g. `vda1`
      def name: () -> String

      # _@return_ — e.g. `/dev/vda1`
      attr_reader device: String

      # _@return_ — its offset from the start of the disk, in bytes
      attr_reader start: Integer?

      # _@return_ — bytes; rounded down to a KiB, as `/proc/partitions` counts
      attr_reader size: Integer?

      # _@return_ — mounted from it: one, or several on an LVM physical volume
      attr_reader filesystems: ::Array[Filesystem]
    end

    # One mounted filesystem.
    # @!attribute [r] name
    #   @return [String] the guest device it is mounted from, e.g. `vda1`, or `dm-0` through LVM
    # @!attribute [r] mountpoint
    #   @return [String] e.g. `/boot/efi`, `C:\`
    # @!attribute [r] fstype
    #   @return [String] e.g. `ext4`, `btrfs`, `NTFS`
    # @!attribute [r] total
    #   @return [Integer, nil] bytes available to an unprivileged user plus {#used}, as `df`
    #     counts its Use%; `nil` when the agent could not stat it
    # @!attribute [r] used
    #   @return [Integer, nil] bytes
    # @!attribute [r] mappers
    #   @return [Array<Mapper>] the device-mapper devices between it and its partition or disk,
    #     top first: the LV, then the LUKS mapping under it; empty on a plain partition
    class Filesystem < Data
      # _@return_ — the guest device it is mounted from, e.g. `vda1`, or `dm-0` through LVM
      attr_reader name: String

      # _@return_ — e.g. `/boot/efi`, `C:\`
      attr_reader mountpoint: String

      # _@return_ — e.g. `ext4`, `btrfs`, `NTFS`
      attr_reader fstype: String

      # _@return_ — bytes available to an unprivileged user plus {#used}, as `df`
      # counts its Use%; `nil` when the agent could not stat it
      attr_reader total: Integer?

      # _@return_ — bytes
      attr_reader used: Integer?

      # _@return_ — the device-mapper devices between it and its partition or disk,
      # top first: the LV, then the LUKS mapping under it; empty on a plain partition
      attr_reader mappers: ::Array[Mapper]
    end

    # One device-mapper device, an LVM volume or a dm-crypt mapping.
    # @!attribute [r] device
    #   @return [String] the kernel's name, e.g. `dm-0`
    # @!attribute [r] name
    #   @return [String, nil] the name its user knows it by, e.g. `hccrypt`, `ubuntu--vg-root`
    class Mapper < Data
      # _@return_ — e.g. `hccrypt (dm-0)`
      def to_s: () -> String

      # _@return_ — the kernel's name, e.g. `dm-0`
      attr_reader device: String

      # _@return_ — the name its user knows it by, e.g. `hccrypt`, `ubuntu--vg-root`
      attr_reader name: String?
    end
  end

  # A `virsh` transport that keeps one long-lived interactive `virsh` child and talks to
  # it over pipes, instead of spawning a process per command. Drop-in for {VirshSpawn}:
  # 
  #   runner = VirshSession.new
  #   Virsh.new(runner: runner)      # reads now cost ~0.1ms instead of ~8ms
  #   runner.query('domstats')       # one argument per word; {.quote} handles the rest
  #   runner.close                   # always; otherwise the child outlives the process
  # 
  # Only {#query} uses the session. {#sync} and {#async} delegate to a {VirshSpawn},
  # because one `virsh` child runs commands strictly one at a time: a `virsh start` would
  # block every read behind it for ~800ms, and mutating commands additionally want the
  # exit status that only a dedicated process has.
  # 
  # The default transport in `bin/virtui`; {VirshSpawn} is the fallback you get by editing
  # that file. Why a session at all, and why the obvious framings do not work:
  # design/decisions.md D_virsh_session.
  # 
  # == Implementation details
  # 
  # `virsh` drives GNU readline even when stdin is a pipe, so the reply stream carries a
  # prompt and an echo of the line just sent. Both {CHILD_ENV} entries are load-bearing
  # (see the constant), and the echo is not noise — {#query} asserts on it, which is what
  # turns a stale reply into an exception instead of one VM's numbers silently reported
  # as another's.
  # 
  # Command completeness is decided by *ordering*, never by a timeout: `virsh` runs one
  # command at a time, so a sentinel `echo` sent after the real command cannot produce
  # output until the real command's output is finished. Seeing the sentinel proves the
  # reply is whole. The read deadline only detects a wedged child.
  # 
  # Failures split in two, and conflating them would break a host with no libvirtd —
  # there `virsh` sits happily in its REPL and fails every command, so respawning would
  # churn forever:
  # 
  # - a *command* failure (`error:` on stderr) raises and leaves the session alone;
  # - a *transport* failure ({Desync}, {Timeout}, EOF) kills and respawns the child once,
  #   then gives up and degrades permanently to {VirshSpawn}. The saving is an
  #   optimisation, so losing it must never be worse than not having tried.
  # 
  # == Thread-safety
  # 
  # Thread-safe: one mutex serialises every call, which is required rather than defensive
  # — two callers interleaved on one pipe would read each other's replies. Reads normally
  # come from the timer thread, but {Cache#initialize} calls {Virsh#hostinfo} on the main
  # thread.
  class VirshSession
    CHILD_ENV: ::Hash[String, String]
    CONTROL_BYTES: Regexp
    READ_TIMEOUT_SECONDS: Float
    STARTUP_TIMEOUT_SECONDS: Float
    MAX_PROMPT_BYTES: Integer

    # _@param_ `uri` — a libvirt connection URI for `virsh -c`, or `nil` for the default. `test:///default` is libvirt's in-process driver and needs no daemon, which is how the specs exercise a real `virsh`
    # 
    # _@param_ `spawn` — transport for the calls a session must not serve, and the fallback once the session is written off
    # 
    # _@param_ `read_timeout` — seconds to wait for one reply; lowered by the specs, which deliberately wedge a session and would otherwise wait {READ_TIMEOUT_SECONDS} to find out
    def initialize: (?uri: String?, ?spawn: VirshSpawn, ?read_timeout: Float) -> void

    # _@return_ — whether the session was written off and reads now spawn a process
    # each, exactly as {VirshSpawn} would
    def degraded?: () -> bool

    # A read served from the persistent child, byte-identical to what {VirshSpawn#query}
    # would have returned.
    # 
    # Recovers from a broken child by respawning and retrying once, then by degrading for
    # good. A failure *reported by* `virsh` is not a broken child and propagates
    # untouched.
    # 
    # _@param_ `args` — a `virsh` subcommand and its arguments, one per element
    # 
    # _@return_ — the command's stdout, with stderr excluded
    def query: (*::Array[String] args) -> String

    # Quotes one argument for `virsh`'s own tokenizer, which is not the shell's.
    # 
    # Single quotes, never double: inside `'…'` `virsh` takes every byte literally, while
    # inside `"…"` it treats backslash as an escape and would eat the ones JSON puts
    # there. An embedded quote closes, escapes and reopens, exactly as POSIX sh needs —
    # `virsh echo --shell` emits this same form, which is a handy oracle.
    # 
    #   quote("it's")   # => "'it'\\''s'"
    # 
    # Quoting cannot rescue a *control* byte, so one raises here instead of being wrapped:
    # readline reads the child's stdin (see {CHILD_ENV}) and acts on C0 and DEL as editing
    # keys — TAB completes, `\x15` kills the line — before the tokenizer ever sees them,
    # which corrupts the command and hands every later reply to the wrong call. Nothing
    # feeds one in today (`JSON.generate` escapes every C0 byte, though notably *not* DEL,
    # and the guest paths are literals), so this guards the next payload, not a live bug.
    # 
    # _@param_ `str` — one argument, as the caller means it to arrive
    # 
    # _@return_ — the argument wrapped so the tokenizer reproduces it byte for byte
    def self.quote: (String str) -> String

    # A process of its own: for a mutating command, and for a read that must not queue
    # behind the session ({Virsh#domain_config}).
    # 
    # _@param_ `args` — a `virsh` subcommand and its arguments, one per element
    # 
    # _@return_ — the command's stdout
    def sync: (*::Array[String] args) -> String

    # _@param_ `args` — a `virsh` subcommand and its arguments, one per element
    # 
    # _@return_ — the thread running the command (see {Run.async})
    def async: (*::Array[String] args) -> Thread

    # Shuts the child down, killing it if it will not leave politely. Safe to call twice;
    # after it, {#query} degrades to spawning.
    def close: () -> void

    # Starts the child and learns its prompt.
    # 
    # The child gets its own process group, so a terminal signal aimed at virtui cannot
    # reach it (see the call below).
    # 
    # The prompt is whatever the child prints first, rather than a hardcoded `virsh # `:
    # it is cosmetic, unversioned string, and reading it costs nothing. Waiting for
    # quiescence is safe *here only* — at startup there is no earlier reply that a
    # premature read could steal.
    def start: () -> void

    def stop: () -> void

    def kill_child: () -> void

    def restart: () -> void

    # _@param_ `error` — why the session was written off
    def degrade: (TransportError error) -> void

    # Sends one command plus a sentinel and returns the command's stdout.
    # 
    # _@param_ `line` — the command line to send, arguments already quoted by {.quote}
    # 
    # _@return_ — the command's stdout
    def call: (String line) -> String

    # _@param_ `text` — bytes to send, newline included
    def write_line: (String text) -> void

    # Raises if `virsh` reported an error for the command just read.
    # 
    # Sound without any waiting: `virsh` wrote stderr before the sentinel's stdout, and
    # the sentinel has already been read, so anything stderr holds is already there.
    # 
    # Stderr is the only failure signal there is: empty *stdout* is not one, because a host
    # with no VMs returns an empty `domstats` legitimately.
    # 
    # Only `error:` lines fail the call. libvirt's own log output also lands on stderr and
    # a warning must not turn a good read into an exception, so the remainder is logged —
    # at `warn` rather than `debug`, because classifying stderr without an exit status is
    # this design's weakest joint and misreading it must not be quiet.
    # 
    # _@param_ `line` — the command just run, for the message
    def check_stderr: (String line) -> void

    # _@param_ `io` — stream to read
    # 
    # _@param_ `pattern` — bytes that end the reply
    # 
    # _@return_ — everything read, including `pattern`
    def read_until: (IO io, String pattern) -> String

    # _@param_ `io` — stream to read
    # 
    # _@param_ `timeout` — seconds to wait for the first byte
    # 
    # _@return_ — everything readable once the stream falls quiet
    def read_quiescent: (IO io, Float timeout) -> String

    # _@param_ `io` — stream to read
    # 
    # _@return_ — whatever is buffered right now, without waiting
    def read_available: (IO io) -> String

    # Raised when the child is unusable: the reply stream no longer lines up, or it went
    # away, or it stopped answering. Always recovered from by respawning, never by
    # retrying on the same child.
    class TransportError < StandardError
    end

    # Raised when the reply stream no longer corresponds to the commands sent — a stale
    # reply from an abandoned call, most likely. Never swallowed: the whole point is that
    # a desynchronised session must not report VM A's data as VM B's.
    class Desync < Virt::VirshSession::TransportError
    end

    # Raised when a reply does not arrive within the configured read timeout.
    class Timeout < Virt::VirshSession::TransportError
    end
  end

  # Grows a running guest's root partition, and the filesystem on it, into the free space at
  # the end of its disk — what a disk image resize leaves behind:
  # 
  #   plan = GuestRootGrow.plan(virsh.guest_storage('vt-ubuntu'))   # raises Refused if it can't
  #   grower = GuestRootGrow.new
  #   grower.check('vt-ubuntu', plan)                              # the guest-side checks
  #   grower.grow('vt-ubuntu', plan)                               # sfdisk, partx, resize2fs
  # 
  # The simplest layout only: `/` is ext4 or btrfs directly on a partition — no LVM, no
  # encryption — and that partition is physically the last on its disk. Everything else is
  # refused with the reason, for the user to grow by hand.
  # 
  # The one sanctioned use of `guest-exec`: three fixed commands, run as root in the guest,
  # only from an operator-confirmed `M` item (design/decisions.md D_guest_root_grow). Every
  # call spawns its own `virsh`, the mutating ones and the polls alike.
  # 
  # Never on the UI thread: a grow runs for as long as the guest's `resize2fs` does.
  class GuestRootGrow
    FSTYPES: ::Array[String]
    TIMEOUT_SECONDS: Integer
    POLL_SECONDS: Float
    DEADLINE_SECONDS: Integer

    # The plan for the guest's layout, or why there is none.
    # 
    # _@param_ `storage` — the guest's disks, fresh
    def self.plan: (GuestStorage storage) -> Plan

    # _@param_ `plan`
    # 
    # _@return_ — the same plan
    def self.checked: (Plan plan) -> Plan

    # _@param_ `runner` — transport for the agent calls; a process each
    # 
    # _@param_ `agent` — reads the guest files {#check} needs
    def initialize: (?runner: VirshSpawn, ?agent: GuestAgent) -> void

    # The checks only the guest can answer: that its agent runs commands, and that the
    # partition table can grow the partition in place.
    # 
    # _@param_ `domain` — VM name; must be running
    # 
    # _@param_ `plan` — from {.plan}
    def check: (String domain, Plan plan) -> void

    # Runs the plan's commands in the guest, one after the other.
    # 
    # _@param_ `domain` — VM name
    # 
    # _@param_ `plan` — from {.plan}, {#check}ed
    def grow: (String domain, Plan plan) -> void

    # _@param_ `domain`
    # 
    # _@param_ `disk`
    # 
    # _@return_ — udev's `ID_PART_TABLE_TYPE` for the disk: `gpt` or `dos`
    def partition_table: (String domain, GuestStorage::Disk disk) -> String

    # Starts one command in the guest and waits for it to exit.
    # 
    # _@param_ `domain`
    # 
    # _@param_ `argv` — the command; the agent finds it on the guest's `PATH`
    # 
    # _@param_ `stdin`
    # 
    # _@return_ — the final `guest-exec-status`: `exitcode`, base64 `out-data`/`err-data`
    def exec: (String domain, ::Array[String] argv, String? stdin) -> ::Hash[String, Object]

    # _@param_ `domain`
    # 
    # _@param_ `execute` — the agent command
    # 
    # _@param_ `arguments`
    # 
    # _@return_ — the reply's `return` member
    def command: (String domain, String execute, ?::Hash[untyped, untyped]? arguments) -> Object

    # Why a grow cannot happen, in words for the user: the guest's layout is not the simple
    # one, there is no room, or its agent will not run commands.
    class Refused < StandardError
    end

    # What one grow does to which partition.
    # @!attribute [r] disk
    #   @return [GuestStorage::Disk] the disk the root partition is on
    # @!attribute [r] partition
    #   @return [GuestStorage::Partition] the root partition, last on {#disk}
    # @!attribute [r] filesystem
    #   @return [GuestStorage::Filesystem] `/`
    class Plan
      # _@return_ — the partition's number, from its kernel name (`vda1`, `nvme0n1p2`)
      def number: () -> Integer

      # _@return_ — bytes the partition grows by: all of the disk after it
      def growth: () -> Integer

      # _@return_ — each command's argv, with what it reads
      # on stdin (`nil` for nothing)
      def commands: () -> ::Array[[::Array[String], String]]

      # _@return_ — the disk the root partition is on
      attr_reader disk: GuestStorage::Disk

      # _@return_ — the root partition, last on {#disk}
      attr_reader partition: GuestStorage::Partition

      # _@return_ — `/`
      attr_reader filesystem: GuestStorage::Filesystem
    end
  end
end

# What virtui remembers between runs — which of the System and log panes are shown — as JSON
# in {.path}. Load once, then change a field and save:
# 
#     state = State.load
#     state.log_pane_visible = false
#     state.save
#     # ~/.local/state/virtui/state.json:
#     #   { "system_pane_visible": true, "log_pane_visible": false }
# 
# A new field is an `attr_accessor` with a YARD `@return` type and a default in {#initialize},
# then `rake sig:generate`: Typemap maps every public accessor pair, typed from
# `sig/virtui.rbs`. A missing file or key reads as its default; an unknown key is ignored.
class State
  MAPPER: Typemap::Mapper

  # Every pane shown, as on a first run; nothing is read.
  def initialize: () -> void

  # The state file under `$XDG_STATE_HOME`, falling back to `~/.local/state` when the variable
  # is unset, empty or relative — the XDG Base Directory spec calls a relative one invalid.
  # 
  # _@param_ `env` — the environment to read
  # 
  # _@return_ — the state file's absolute path
  def self.path: (?::Hash[String, String] env) -> String

  # _@return_ — the state from {.path}, the defaults where the file or a key is missing
  def self.load: () -> State

  # Writes the state to {.path}, creating its directory. Renamed into place, so a crash
  # mid-write cannot leave a truncated file for the next {.load} to raise on.
  def save: () -> void

  # _@return_ — whether the System pane is shown
  attr_accessor system_pane_visible: bool

  # _@return_ — whether the log pane is shown
  attr_accessor log_pane_visible: bool
end

# The user's settings, read once at startup from the first `virtui/config.toml` on the XDG
# config path ({.path}). Every key is optional; a missing file is the defaults:
# 
#     # ~/.config/virtui/config.toml
#     [ballooning]
#     raise_at_percent = 70
# 
#     config = Config.load
#     config.ballooning.raise_at_percent   # => 70
#     config.ballooning.shrink_at_percent  # => 55, the default
# 
# A key is a member of {Config} or of a nested data class, typed by its YARD `@return` through
# `sig/virtui.rbs`, its default in `initialize`; Typemap maps the file onto them. A wrong type,
# a value out of its limits or an unknown key raises {Config::Error} naming the file and the key.
# 
# @!attribute [r] ballooning
#   @return [Config::Ballooning] the `[ballooning]` table
class Config
  MAPPER: Typemap::Mapper

  # _@param_ `ballooning`
  def initialize: (?ballooning: Config::Ballooning) -> void

  # The first `virtui/config.toml` that exists under `$XDG_CONFIG_HOME` (default `~/.config`),
  # then under each `$XDG_CONFIG_DIRS` entry (default `/etc/xdg`). Only the first is read, never
  # merged. A relative entry is skipped: the XDG Base Directory spec calls it invalid.
  # 
  # _@param_ `env` — the environment to read
  # 
  # _@return_ — the file's absolute path; `nil` when there is none
  def self.path: (?::Hash[String, String] env) -> String?

  # Logs which file it read, at info.
  # 
  # _@param_ `env` — the environment {.path} reads
  # 
  # _@return_ — the settings from {.path}; the defaults where it or a key is missing
  def self.load: (?::Hash[String, String] env) -> Config

  # _@return_ — the `[ballooning]` table
  attr_reader ballooning: Config::Ballooning

  # A config file that cannot be used, its message prefixed with the file's path:
  # 
  #     ~/.config/virtui/config.toml: ballooning.raise_at_percent: expected Integer, got "70"
  class Error < StandardError
  end

  # The `[ballooning]` table: when a guest grows and shrinks, and how far it may shrink.
  # 
  # @!attribute [r] raise_at_percent
  #   @return [Integer] guest memory use, omitting cache, in percent, at or above which the guest
  #     is grown ({Virt::BallooningVM::MemLevelRaiseVoter}). 65 leaves a 35% reserve, where MoM,
  #     Hyper-V and K8s VPA all use 15-20%. Not `100 - vm.swappiness`: swappiness weights the
  #     anon LRU against the file LRU once reclaim has *already* started and says nothing about
  #     when it starts. A guest at 61% was measured holding 2 GiB of swap
  #     (`design/ideas/swap-despite-ballooning.md`).
  # @!attribute [r] shrink_at_percent
  #   @return [Integer] guest memory use, in percent, at or below which the guest is shrunk
  #     ({Virt::BallooningVM::MemLevelShrinkVoter}). The 10-point gap to 65 is a deadband, and
  #     narrower than it looks: a 30% raise takes a guest reading 65% straight down to 50%, five
  #     points under 55, so a raise is followed by a shrink once the back-off lapses
  #     (`design/ideas/swap-despite-ballooning.md` has the arithmetic).
  # @!attribute [r] min_actual_gib
  #   @return [Integer] the floor no guest is shrunk below, in GiB: 8 is a healthy desktop
  #     guest. A VM configured with less than twice this floors at half its maximum instead
  #     ({Virt::BallooningVM#floor}).
  class Ballooning
    extend Typemap::Constrain

    # _@param_ `raise_at_percent`
    # 
    # _@param_ `shrink_at_percent`
    # 
    # _@param_ `min_actual_gib`
    def initialize: (?raise_at_percent: Integer, ?shrink_at_percent: Integer, ?min_actual_gib: Integer) -> void

    # Typemap calls this on every load.
    def validate: () -> void

    # _@return_ — guest memory use, omitting cache, in percent, at or above which the guest
    # is grown ({Virt::BallooningVM::MemLevelRaiseVoter}). 65 leaves a 35% reserve, where MoM,
    # Hyper-V and K8s VPA all use 15-20%. Not `100 - vm.swappiness`: swappiness weights the
    # anon LRU against the file LRU once reclaim has *already* started and says nothing about
    # when it starts. A guest at 61% was measured holding 2 GiB of swap
    # (`design/ideas/swap-despite-ballooning.md`).
    attr_reader raise_at_percent: Integer

    # _@return_ — guest memory use, in percent, at or below which the guest is shrunk
    # ({Virt::BallooningVM::MemLevelShrinkVoter}). The 10-point gap to 65 is a deadband, and
    # narrower than it looks: a 30% raise takes a guest reading 65% straight down to 50%, five
    # points under 55, so a raise is followed by a shrink once the back-off lapses
    # (`design/ideas/swap-despite-ballooning.md` has the arithmetic).
    attr_reader shrink_at_percent: Integer

    # _@return_ — the floor no guest is shrunk below, in GiB: 8 is a healthy desktop
    # guest. A VM configured with less than twice this floors at half its maximum instead
    # ({Virt::BallooningVM#floor}).
    attr_reader min_actual_gib: Integer
  end
end

# Host operating-system metrics: {System::Info} reads the host's CPU, memory and
# disk usage (via `/proc` and `df`), producing the {System::CpuStat},
# {System::CpuUsage}, {System::MemoryStat} and {System::DiskUsage} value objects.
# {System::Emulator} is an {System::Info}-compatible test double.
module System
  # Reads host metrics from a Linux system: memory from `/proc/meminfo`, CPU from
  # `/proc/stat` and `/proc/cpuinfo`, disk from `df`.
  # 
  # Each reader takes an optional fixture-content parameter used only by specs; in
  # production they read the real files/commands.
  # 
  # Holds no state of its own — a CPU sample is derived by threading the previous one back
  # in (see {#cpu_usage}). Thread-safe.
  class Info
    # Reads physical RAM and swap usage from `/proc/meminfo`.
    # 
    # _@param_ `meminfo_file` — contents of `/proc/meminfo`; reads the real file when `nil`. Pass a fixture string for testing
    # 
    # _@return_ — memory statistics
    def memory_stats: (?String? meminfo_file) -> MemoryStat

    # Computes whole-CPU usage over the interval since `prev_cpu_usage` was sampled, by
    # diffing `/proc/stat` clock counters.
    # 
    # The result is normalized across all cores (`0.0..100.0`; 8 saturated cores read
    # `100.0`, not `800.0`) — see {System::CpuUsage}. The first call has no previous
    # sample to diff against and returns `0.0`.
    # 
    # _@param_ `prev_cpu_usage` — the previous sample, or `nil` on the first call
    # 
    # _@param_ `proc_stat_file` — contents of `/proc/stat`; reads the real file when `nil`. Pass a fixture string for testing
    # 
    # _@return_ — the new sample, carrying the raw {System::CpuStat} for
    # the next diff
    def cpu_usage: (System::CpuUsage? prev_cpu_usage, ?String? proc_stat_file) -> System::CpuUsage

    # Calculates per-disk usage, but only for the filesystems that hold VM qcow2 files.
    # 
    # Runs `df` on the given files and groups the results by physical disk, folding each
    # file's size into that disk's {DiskUsage}. Returns an empty hash when `qcow2_files`
    # is empty.
    # 
    # _@param_ `qcow2_files` — `[path, size_in_bytes]` pairs for the qcow2 files used by VMs
    # 
    # _@param_ `test_df` — canned `df -P` output for testing; runs the real `df` when `nil`
    # 
    # _@return_ — physical disk name => its usage
    def disk_usage: (::Array[[String, Integer]] qcow2_files, ?String? test_df) -> ::Hash[String, DiskUsage]

    # Reads the host CPU feature flags from `/proc/cpuinfo` (e.g. `svm`/`vmx` for
    # virtualization support).
    # 
    # Folds three of the kernel's lines into one set: the general `flags:` line, plus
    # the `vmx flags:` / `svm flags:` lines it prints for the virtualization
    # sub-features. The VT-x sub-features (`ept`, `vpid`) live *only* on `vmx flags:`,
    # so reading `flags:` alone reported every Intel host as lacking EPT. The three
    # namespaces don't collide, so one flat set is enough.
    # 
    # _@return_ — the CPU flags
    def cpu_flags: () -> ::Set[String]
  end

  # The aggregate `cpu` line from `/proc/stat`, broken into its clock-tick counters.
  # 
  # Each counter is a cumulative count, since boot, of *USER_HZ ticks* the CPU spent in
  # that state (summed across all cores). A "tick" here is the kernel's scheduler-clock
  # tick, not a hardware CPU cycle: it is `1 / USER_HZ` of a second, where `USER_HZ` is
  # almost always 100 on Linux — so one tick is ~10 ms of CPU time. The fields therefore
  # measure *time*, not instructions: e.g. `user` is the total core-time spent in user
  # mode, `idle` the time spent idle.
  # 
  # Because the counters only ever grow, an instantaneous reading is meaningless on its
  # own; CPU usage is the *delta* between two snapshots — `busy_delta / total_delta` over
  # the interval (see {System::CpuUsage}). `name` is the literal `"cpu"` label; every
  # other field is an {Integer} tick count.
  class CpuStat
    # _@return_ — ticks spent idle (`idle + iowait`)
    def clocks_idle: () -> Integer

    # _@return_ — ticks spent doing work (everything except idle/iowait)
    def clocks_non_idle: () -> Integer

    # _@return_ — total ticks (`clocks_idle + clocks_non_idle`)
    def clocks_total: () -> Integer

    # Parses the aggregate `cpu` line out of `/proc/stat`.
    # 
    # _@param_ `proc_stat_file` — contents of `/proc/stat`; reads the real file when `nil`. Pass a fixture string for testing.
    # 
    # _@return_ — the parsed counters
    def self.parse: (?String? proc_stat_file) -> System::CpuStat

    # _@return_ — all counters on one line, e.g. `"cpu: user=1000 nice=50 …"`
    def to_s: () -> String
  end

  # A {System::Info}-compatible test double that returns fixed, predictable host metrics
  # without touching `/proc` or `df`.
  # 
  # Mirrors {System::Info}'s public interface (minus the fixture parameters) so the app
  # can run in demo mode. Stateless and thread-safe.
  class Emulator
    # _@return_ — fixed memory statistics (32 GiB RAM half-used, 4 GiB swap free)
    def memory_stats: () -> MemoryStat

    # _@param_ `_prev_cpu_usage` — ignored; present for interface parity with {System::Info#cpu_usage}
    # 
    # _@return_ — always `0.0%` usage with no backing {System::CpuStat}
    def cpu_usage: (System::CpuUsage? _prev_cpu_usage) -> System::CpuUsage

    # Puts every file on one simulated 1 TiB disk, `nvme0n1`, 400 GiB of it free.
    # 
    # _@param_ `qcow2_files` — `[path, size_in_bytes]` pairs, as {System::Info#disk_usage} takes them
    # 
    # _@return_ — `nvme0n1`'s usage; empty when `qcow2_files` is
    def disk_usage: (::Array[[String, Integer]] qcow2_files) -> ::Hash[String, DiskUsage]

    # _@return_ — fixed virtualization-capable CPU flags (`svm`, `npt`, `pdpe1gb`)
    def cpu_flags: () -> ::Set[String]
  end

  # A CPU usage sample: the busy percentage over the last interval, plus the raw
  # {System::CpuStat} it was derived from.
  # 
  # `last_cpu_stat` is retained so the next sample can diff against it (CPU usage is the
  # delta of busy clocks between two `/proc/stat` readings).
  # 
  # @!attribute [r] usage_percent
  #   @return [Float] busy percentage of the *whole* CPU over the last sampling interval,
  #     `0.0..100.0`. This is normalized across all cores, not per-core: an 8-core host
  #     with every core saturated reads `100.0`, not `800.0` (it is derived from the
  #     aggregate `cpu` line of `/proc/stat`, which already sums all cores).
  # @!attribute [r] last_cpu_stat
  #   @return [System::CpuStat] the most recent raw clock counters this sample used
  class CpuUsage
    # _@return_ — busy percentage of the *whole* CPU over the last sampling interval,
    # `0.0..100.0`. This is normalized across all cores, not per-core: an 8-core host
    # with every core saturated reads `100.0`, not `800.0` (it is derived from the
    # aggregate `cpu` line of `/proc/stat`, which already sums all cores).
    attr_reader usage_percent: Float

    # _@return_ — the most recent raw clock counters this sample used
    attr_reader last_cpu_stat: System::CpuStat
  end

  # Disk usage for one filesystem, tracking how much of it VM disk images account for.
  # 
  # {#add} returns a new instance rather than mutating, so per-VM contributions can be
  # accumulated.
  # 
  # @!attribute [r] usage
  #   @return [ResourceUsage] overall used/total bytes of the filesystem
  # @!attribute [r] vm_usage
  #   @return [Integer] bytes consumed by VM qcow2 files on this disk
  # @!attribute [r] qcow2_files
  #   @return [Array<String>] paths of the qcow2 files counted in `vm_usage`
  class DiskUsage
    # _@return_ — human-readable summary, e.g. `"40G/100G (40%) (12G VMs)"`
    def to_s: () -> String

    # Returns a copy with one more qcow2 file folded into `vm_usage`/`qcow2_files`.
    # 
    # _@param_ `physical` — the qcow2 file's on-disk size, in bytes
    # 
    # _@param_ `qcow2_file` — path to the qcow2 file
    # 
    # _@return_ — a new instance with the file accounted for
    def add: (Integer physical, String qcow2_file) -> DiskUsage

    # _@return_ — overall used/total bytes of the filesystem
    attr_reader usage: ResourceUsage

    # _@return_ — bytes consumed by VM qcow2 files on this disk
    attr_reader vm_usage: Integer

    # _@return_ — paths of the qcow2 files counted in `vm_usage`
    attr_reader qcow2_files: ::Array[String]
  end

  # Host memory statistics: physical `ram` and `swap` usage.
  # 
  # @!attribute [r] ram
  #   @return [ResourceUsage] physical RAM usage
  # @!attribute [r] swap
  #   @return [ResourceUsage] swap usage
  class MemoryStat
    REQUIRED_KEYS: ::Array[String]

    # Parses the contents of a Linux `/proc/meminfo`.
    # 
    # On the value object rather than in {Info} because the file is not only the host's: a
    # *guest*'s copy, read through the QEMU guest agent, is the same format and the only
    # place a VM's swap level exists (see {Virt::MemoryStat#swap_out}).
    # 
    # _@param_ `meminfo_file` — the contents of `/proc/meminfo`
    # 
    # _@return_ — RAM (`MemTotal`/`MemAvailable`) and swap (`SwapTotal`/`SwapFree`)
    def self.parse: (String meminfo_file) -> MemoryStat

    # _@return_ — human-readable summary, e.g. `"RAM: 4G/8G (50%), SWAP: 0/2G (0%)"`
    def to_s: () -> String

    # _@return_ — physical RAM usage
    attr_reader ram: ResourceUsage

    # _@return_ — swap usage
    attr_reader swap: ResourceUsage
  end
end

# A stretch of time after some event during which a decision stays suppressed: {#active?}
# is `true` until the deadline passes and `false` for ever after. The one thing it adds
# over a bare deadline is {#extended_by}'s never-shorten rule — the reason it gets passed
# around as a value object rather than recomputed at each call site.
# 
# There is no "no cooldown" state to nil-check: {ELAPSED} is one that is already over, so
# a caller can start from it and treat every instance the same.
# 
#     back_off = Cooldown::ELAPSED
#     back_off = back_off.extended_by(10)   # armed for 10s, extending whatever was left
#     back_off.active?                      # => true
#     back_off.remaining.round(1)           # => 10.0
# 
# Measured on {.now} — **uptime, not wall time**. Ten seconds means ten elapsed seconds
# whatever the wall clock does in between: an NTP correction, a timezone change and a
# manual `date` all leave a running cooldown exactly where it was. That is the contract,
# and it is why Timecop cannot move one — see design/decisions.md D_cooldown_monotonic, and
# `Uptime.travel` in `spec/spec_helper.rb` for the counterpart specs use instead.
# 
# Immutable, and reads the clock on every call — two calls a second apart disagree.
# 
# Not an {Interpolator}: that module ramps numeric quantities for the emulator, and a latch
# needs {#remaining} and the never-shorten rule, neither of which is an interpolation.
# 
# @!attribute [r] deadline
#   @return [Float] when the cooldown ends, in {.now} seconds; `-Float::INFINITY` for one
#     that was over before it began
class Cooldown
  ELAPSED: Cooldown

  # Validates the value object on construction.
  # 
  # _@param_ `hash` — the members, by name: `deadline:`
  def initialize: (::Hash[Symbol, Float] hash) -> void

  # _@return_ — the current reading of {.clock}, in seconds of uptime
  def self.now: () -> Float

  # _@param_ `seconds` — how long from now the cooldown runs
  # 
  # _@return_ — a cooldown ending `seconds` from now
  def self.of: (Numeric seconds) -> Cooldown

  # _@return_ — `true` while the deadline is still ahead
  def active?: () -> bool

  # _@return_ — seconds left, `0.0` once elapsed — never negative, so it is safe to
  # print without checking {#active?} first
  def remaining: () -> Float

  # Pushes the deadline out to `seconds` from now, *unless* that would bring it closer:
  # a caller arming a short cooldown must never cut short a longer one already running.
  # 
  # _@param_ `seconds` — how long from now the extended cooldown should run
  # 
  # _@return_ — this one, or a longer one — never a shorter one
  def extended_by: (Numeric seconds) -> Cooldown

  # The clock every cooldown is measured on, as a callable returning seconds of uptime.
  # Writable for one reason: Timecop moves the wall clock and cannot move this one, so a
  # spec needing a cooldown to lapse has nowhere else to reach. Production never assigns
  # it, and `Uptime.travel` (`spec/spec_helper.rb`) is the only thing that should — it
  # restores the default in an `ensure`.
  # 
  # _@return_ — returns {Float} seconds
  def self.clock: () -> untyped

  # The clock every cooldown is measured on, as a callable returning seconds of uptime.
  # Writable for one reason: Timecop moves the wall clock and cannot move this one, so a
  # spec needing a cooldown to lapse has nowhere else to reach. Production never assigns
  # it, and `Uptime.travel` (`spec/spec_helper.rb`) is the only thing that should — it
  # restores the default in an `ensure`.
  # 
  # _@return_ — returns {Float} seconds
  def self.clock=: (untyped value) -> untyped

  # _@return_ — when the cooldown ends, in {.now} seconds; `-Float::INFINITY` for one
  # that was over before it began
  attr_reader deadline: Float
end

# A cancel flag shared by the thread that cancels some work and the thread doing it. Work
# that takes a while checks it between its steps:
# 
#   UI::BackgroundTask.new('Reading the VMs') do |cancel|
#     vms.map { |vm| cancel.check_canceled; virt.guest_os(vm) }
#   end.run { |oses| ... }
# 
# A wait the work blocks in has a cancelable twin here, raising the moment the work is
# canceled; the next one the work needs belongs here too:
# 
#   cancel.sleep(2)            # Kernel#sleep
#   cancel.join(wait_thr)      # Thread#join
# 
# Cooperative: work that neither checks nor waits here runs to its end. Code handed one only
# calls its methods, never naming this class, so a backend call can take one without
# depending on where it lives.
# 
# Thread-safe.
class Cancellation
  POLL_INTERVAL: Float

  def initialize: () -> void

  # Marks the work canceled, for good. Idempotent.
  def cancel: () -> void

  # _@return_ — whether {#cancel} has been called
  def canceled?: () -> bool

  # Raises once the work has been canceled; a no-op until then.
  def check_canceled: () -> void

  # `Kernel#sleep` that wakes and raises the moment the work is canceled.
  # 
  #   cancel.sleep(2)   # pause before a retry, unless the user gives up meanwhile
  # 
  # _@param_ `seconds` — how long to sleep
  def sleep: (Numeric seconds) -> void

  # `Thread#join` that raises once the work is canceled.
  # 
  #   status = cancel.join(wait_thr).value
  # 
  # **It stops the waiting, not the thread**: after a cancel, `thread` runs on, and whoever
  # started it stops it. A cancel shows within {POLL_INTERVAL}, since nothing reports the end
  # of an arbitrary thread.
  # 
  # _@param_ `thread` — the thread to wait for
  # 
  # _@return_ — `thread`, ended
  def join: (Thread thread) -> Thread

  # Raised by {Cancellation#check_canceled}: the user canceled the work, and nothing failed.
  # 
  # An `Exception`, not a `StandardError`, so a `rescue => e` between the check and whatever
  # runs the work cannot swallow the cancel; `ensure` blocks still run.
  class CanceledError < Exception
  end
end

# Time-varying value providers used to animate UI quantities smoothly between updates.
# 
# Every class in this module exposes a `value` method returning the current value for
# "now"; the result may change from call to call as wall-clock time advances.
# {Interpolator::Const} holds a fixed value, {Interpolator::Linear} ramps linearly
# between two values over a time window.
module Interpolator
  # An {Interpolator} whose `value` never changes — the degenerate case, for when there is
  # nothing to animate.
  # 
  # @!attribute [r] value
  #   @return [Numeric] the constant value returned for any "now"
  class Const
    # _@return_ — the constant value returned for any "now"
    attr_reader value: Numeric
  end

  # An {Interpolator} that ramps linearly from `value_from` to `value_to` over the time
  # window `time_from..time_to`.
  # 
  # {#value} returns `value_from` before the window, `value_to` after it, and a linear
  # blend in between.
  # 
  # @!attribute [r] value_from
  #   @return [Numeric] value returned at or before `time_from`
  # @!attribute [r] value_to
  #   @return [Numeric] value returned at or after `time_to`
  # @!attribute [r] time_from
  #   @return [Time] start of the interpolation window
  # @!attribute [r] time_to
  #   @return [Time] end of the interpolation window; must not precede `time_from`
  class Linear
    # Validates the value object on construction.
    # 
    # _@param_ `hash` — the members, by name
    def initialize: (::Hash[Symbol, Object] hash) -> void

    # Interpolates value from now for the duration of `duration_seconds`.
    # 
    # _@param_ `value_from` — start value
    # 
    # _@param_ `value_to` — end value
    # 
    # _@param_ `duration_seconds` — how long does it take to go from `value_from` to `value_to`
    # 
    # _@return_ — interpolation
    def self.from_now: (Numeric value_from, Numeric value_to, Numeric duration_seconds) -> (Linear | Const)

    # Returns the current value
    # 
    # _@return_ — current value
    def value: () -> Numeric

    # _@return_ — value returned at or before `time_from`
    attr_reader value_from: Numeric

    # _@return_ — value returned at or after `time_to`
    attr_reader value_to: Numeric

    # _@return_ — start of the interpolation window
    attr_reader time_from: Time

    # _@return_ — end of the interpolation window; must not precede `time_from`
    attr_reader time_to: Time
  end
end

# Adds binary (power-of-1024) byte-size unit helpers to every number, so large byte
# counts read as `4.GiB` instead of `4 * 1024 * 1024 * 1024`.
class Numeric
  # _@return_ — this number of kibibytes, in bytes (`self * 1024`)
  def KiB: () -> Numeric

  # _@return_ — this number of mebibytes, in bytes (`self * 1024**2`)
  def MiB: () -> Numeric

  # _@return_ — this number of gibibytes, in bytes (`self * 1024**3`)
  def GiB: () -> Numeric
end

# A byte-usage value object pairing `total` capacity with currently `available` bytes —
# host RAM, a filesystem, a VM's memory:
# 
#   ResourceUsage.of(8.GiB, 4.GiB).to_s   # => "4G/8G (50%)"
# 
# @!attribute [r] total
#   @return [Integer] total capacity, in bytes
# @!attribute [r] available
#   @return [Integer] currently unused capacity, in bytes
class ResourceUsage
  ZERO: ResourceUsage

  # Builds a usage from `total` capacity and bytes already `used`.
  # 
  # _@param_ `total` — total capacity, in bytes
  # 
  # _@param_ `used` — bytes already consumed
  # 
  # _@return_ — usage whose `available` is `total - used`
  def self.of: (Integer total, Integer used) -> ResourceUsage

  # _@return_ — bytes of resource used (`total - available`)
  def used: () -> Integer

  # _@return_ — percentage used, clamped to `0..100` (0 when `total` is zero)
  def percent_used: () -> Integer

  # Adds two usages component-wise, e.g. to sum per-disk usage into a host total.
  # 
  # _@param_ `other` — the usage to add
  # 
  # _@return_ — sum of the two `total`s and the two `available`s
  def +: (ResourceUsage other) -> ResourceUsage

  # _@return_ — human-readable `used/total (percent%)`, e.g. `"4G/8G (50%)"`
  def to_s: () -> String

  # _@return_ — total capacity, in bytes
  attr_reader total: Integer

  # _@return_ — currently unused capacity, in bytes
  attr_reader available: Integer
end