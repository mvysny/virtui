#!/usr/bin/env ruby
# frozen_string_literal: true

# Bundler finds the Gemfile by walking up from the *current* directory, and its setup is a
# silent no-op when it finds none — so launched from anywhere outside the checkout (the XDG
# desktop entry starts us in the session's cwd) the gems would be left to plain RubyGems and
# the require below would fail. Pin the Gemfile to ours, and set up only the :default group:
# `require 'bundler/setup'` insists on every gem in the lock, so a dev gem the developer
# never installed (rubocop, yard) would stop the app from starting.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler'
Bundler.setup(:default)

require 'tty-logger'
require_relative '../lib/virtui'

# https://github.com/piotrmurach/tty-logger
$log = TTY::Logger.new do |config|
  config.level = :info
end
Tuile.logger = $log

# Update terminal title to show "VirTUI"
print "\e]0;VirTUI\a"

# The virsh CLI is the only real backend — see DECISIONS.md D-virsh-cli. With no virsh
# installed there is nothing to manage, so fall back to the demo fleet.
#
# Reads come from one long-lived virsh child instead of a process per command: ~78x less
# CPU per read (DECISIONS.md D-virsh-session), and it degrades to spawning by itself if
# the child misbehaves, logging why. To go back to a process per command, put
# Virt::VirshSpawn.new here and drop the guest agent with it — the guest swap level is
# three qemu-agent-command calls per running VM per tick, and it is the process spawn, not
# the libvirt round-trip, that makes those unaffordable (DECISIONS.md D-guest-swap-level).
runner = Virt::VirshSession.new if Virt::Virsh.available?
virt = runner ? Virt::Virsh.new(runner: runner, guest_agent: Virt::GuestAgent.new(runner: runner)) : Virt::VMEmulator.demo

virt_cache = Virt::Cache.new(virt, System::Info.new)

ballooning = Virt::Ballooning.new(virt_cache)
screen = Tuile::Screen.new
screen.theme_def = UI::Theme::THEME_DEF
screen.on_error = ->(e) { $log.fatal('Uncaught event loop exception', e) }
layout = UI::AppLayout.new(virt_cache, ballooning)
screen.content = layout
# Tuile owns no status bar; the layout draws its own bottom row and this is what
# keeps it current (tuile DECISIONS.md `D-status-bar`).
screen.on_focus_changed = -> { layout.refresh_status }
screen.focused = layout.vms

# 2s: fast enough that ballooning can ramp a VM up before it starts swapping. Polling
# harder buys nothing — libvirt refreshes guest balloon data only every ~5s anyway
# (see Virt::Cache::VMCache#stale?). Reads happen here, on the timer thread; everything
# that touches a component is handed to the UI thread through the event queue.
scheduler = Concurrent::TimerTask.new(execution_interval: 2, interval_type: :fixed_rate) do
  virt_cache.update
  screen.event_queue.submit do
    ballooning.update
    layout.update_data
  end
rescue StandardError => e
  $log.fatal('Failed to update VM data', e)
end
begin
  scheduler.execute
  screen.run_event_loop
ensure
  scheduler.shutdown
  screen.close
  runner&.close
end
